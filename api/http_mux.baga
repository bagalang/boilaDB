// http_mux.baga — idle HTTP keep-alive fds in poll; workers run one request.
// P32: same mux as PG wire (P31). WORKERS=0 stays go_bg per conn.

import "httpdbaga/http.baga"
import "http_route.baga"
import "serve_mt.baga"
import "serve_mux.baga"
import "../server/databases.baga"
import "../txn/mvcc.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/bytes/bytes.baga"

struct BoilaHttpLive {
    r: HttpReader,
    txn: BoilaTxn,
    db: str,
    guc: Map<str, str>,
    alive: i64,
    // P33b: persist idle txn (park ресетва txn към него — PG mux идиомата)
    itxn: BoilaTxn
}

fn boila_http_mux_new() -> i64 !Par {
    let m: Map<i64, BoilaHttpLive> = map_new()
    return cell2(mutex_new(), map_h(m))
}

fn boila_http_mux_put(mux: i64, fd: i64, live: BoilaHttpLive) -> i64 !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaHttpLive> = h_map(cell2_1(mux))
    map_set(m, fd, live)
    mutex_unlock(mu)
    return 0
}

fn boila_http_mux_take(mux: i64, fd: i64) -> BoilaHttpLive !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaHttpLive> = h_map(cell2_1(mux))
    if map_has(m, fd) == 1 {
        let live = map_get(m, fd)
        map_del(m, fd)
        mutex_unlock(mu)
        return live
    }
    mutex_unlock(mu)
    // Default само за непознат fd (първи turn за връзката).
    return BoilaHttpLive {
        r: http_reader(fd), txn: boila_txn_new(), db: "boila",
        guc: map_new(), alive: 0 - 1, itxn: boila_txn_new()
    }
}

fn boila_http_left(r: HttpReader) -> i64 {
    if bytes_len(r.buf) > r.pos {
        return 1
    }
    return 0
}

fn boila_http_mux_close(fd: i64, live: BoilaHttpLive) -> i64 !IO !Par {
    if live.txn.active == 1 {
        let _r = boila_txn_rollback(live.txn)
    }
    tcp_close(fd)?
    return 0
}

// P33b: park с persist преизграждане (PG mux идиомата) + per-turn rewind —
// без него worker arena-та расте безгранично при sustained keep-alive load.
fn boila_http_mux_park(mux: i64, fd: i64, live: BoilaHttpLive, pempty: bytes) -> i64 !Par {
    mem_persist_begin()
    let mut nb = pempty
    if live.r.pos < bytes_len(live.r.buf) {
        nb = bytes_slice(live.r.buf, live.r.pos, bytes_len(live.r.buf))
    }
    let pguc: Map<str, str> = map_new()
    let ks = map_keys(live.guc)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let k = vec_get(ks, i)
        let v = map_get(live.guc, k)
        map_set(pguc, substr(k, 0, len(k)), substr(v, 0, len(v)))
        i = i + 1
    }
    let mut txn = live.itxn
    if live.txn.active == 1 {
        txn = live.txn
    }
    let pl = BoilaHttpLive {
        r: HttpReader { fd: fd, buf: nb, pos: 0 },
        txn: txn, db: substr(live.db, 0, len(live.db)), guc: pguc,
        alive: live.alive, itxn: live.itxn
    }
    let r = boila_http_mux_put(mux, fd, pl)?
    mem_persist_end()
    return r
}

fn boila_http_mux_turn(pack: i64, mux: i64, fd: i64, pempty: bytes) -> i64 !IO !Net !Time !Par {
    let mut live = boila_http_mux_take(mux, fd)?
    if live.alive < 0 {
        mem_persist_begin()
        let g0: Map<str, str> = map_new()
        let it = boila_txn_new()
        mem_persist_end()
        live = BoilaHttpLive {
            r: http_reader(fd), txn: it, db: "boila",
            guc: g0, alive: 1, itxn: it
        }
    }
    // P33b: mark само при затворена txn; rewind — пак при затворена txn.
    let mut rmark: i64 = 0
    let mut have_mark = false
    if live.txn.active == 0 {
        rmark = mem_mark()
        have_mark = true
    }
    let mut first: i64 = 1
    let mut more: i64 = 1
    while more == 1 {
        if first == 0 && boila_http_left(live.r) == 0 {
            more = 0
        } else {
            first = 0
            let out = http_read_request_r(live.r)?
            live.r = out.reader
            if out.err != 0 {
                http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
                live.alive = 0 - 2
                more = 0
            } else {
                if http_method(out.req) == "" {
                    live.alive = 0 - 2
                    more = 0
                } else {
                    let ka = http_keepalive(out.req)
                    let rt = boila_route_mt(pack, live.txn, live.db, live.guc, out.req)?
                    live.txn = rt.txn
                    live.db = rt.db
                    live.guc = rt.guc
                    http_respond_keepalive(fd, rt.resp, ka)?
                    if ka == 0 {
                        live.alive = 0 - 2
                        more = 0
                    }
                }
            }
        }
    }
    if live.alive == 0 - 2 {
        boila_http_mux_close(fd, live)?
        if have_mark && live.txn.active == 0 {
            mem_rewind(rmark)
        }
        return 0
    }
    boila_http_mux_park(mux, fd, live, pempty)?
    if have_mark && live.txn.active == 0 {
        mem_rewind(rmark)
    }
    return 1
}

fn boila_http_mux_worker(ctx: i64) -> i64 !IO !Net !Time !Par {
    let work = cell2_0(ctx)
    let rest = cell2_1(ctx)
    let idle = cell2_0(rest)
    let rest2 = cell2_1(rest)
    let pack = cell2_0(rest2)
    let rest3 = cell2_1(rest2)
    let mux = cell2_0(rest3)
    let wfd = cell2_1(rest3)
    let mut running: i64 = 1
    mem_persist_begin()
    let pempty = bytes_new(0)
    mem_persist_end()
    while running == 1 {
        let p = chan_recv2(work)
        if cell2_0(p) == 0 {
            running = 0
        } else {
            let fd = cell2_1(p)
            if fd < 0 {
                running = 0
            } else {
                let open = boila_http_mux_turn(pack, mux, fd, pempty) catch !IO => 0 catch !Net => 0 catch !Time => 0
                if open == 1 {
                    chan_send(idle, fd)
                    boila_mux_wake(wfd)?
                } else {
                    boila_mt_end_conn(pack)?
                }
            }
        }
    }
    return 0
}

fn boila_http_mux_run(listener: i64, pack: i64, workers: i64) -> i64 !IO !Net !Time !Par {
    let mux = boila_http_mux_new()?
    let pipe = boila_mux_pipe2()?
    let rfd = cell2_0(pipe)
    let wfd = cell2_1(pipe)
    if rfd < 0 {
        return 1
    }
    let work = chan_new(64)
    let idlech = chan_new(64)
    let wctx = cell2(work, cell2(idlech, cell2(pack, cell2(mux, wfd))))
    let mut i: i64 = 0
    while i < workers {
        go_bg(boila_http_mux_worker, wctx)
        i = i + 1
    }
    let mut idle: Vec<i64> = vec_new()
    let mut going: i64 = 1
    while going == 1 {
        idle = boila_mux_idle_pull(idlech, idle)?
        let set: Vec<i64> = vec_new()
        vec_push(set, listener)
        vec_push(set, rfd)
        let mut j: i64 = 0
        while j < vec_len(idle) {
            vec_push(set, vec_get(idle, j))
            j = j + 1
        }
        let pr = poll_wait(set, 200)?
        if pr.ok < 0 {
            going = 0
        } else {
            idle = boila_mux_idle_pull(idlech, idle)?
            if poll_has(pr.ready, rfd) == 1 {
                let _b = tcp_read(rfd, 64)?
            }
            let mut k: i64 = 0
            while k < vec_len(pr.ready) {
                let fd = vec_get(pr.ready, k)
                if fd != listener && fd != rfd {
                    if boila_mux_vec_has(idle, fd) == 1 {
                        idle = boila_mux_vec_drop(idle, fd)
                        chan_send(work, fd)
                    }
                }
                k = k + 1
            }
            if poll_has(pr.ready, listener) == 1 {
                let fd = tcp_accept(listener)?
                if fd >= 0 {
                    tcp_set_nodelay(fd)?
                    if boila_mt_try_conn(pack)? == 0 {
                        http_respond_keepalive(fd, http_json_response(503, "{\"error\":\"too many connections\",\"sqlstate\":\"53300\"}"), 0)?
                        tcp_close(fd)?
                    } else {
                        if boila_mux_vec_has(idle, fd) == 0 {
                            vec_push(idle, fd)
                        }
                    }
                }
            }
        }
    }
    return 1
}
