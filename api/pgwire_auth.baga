// pgwire_auth.baga — trust / cleartext / SCRAM-SHA-256 (P15).
import "pgwire_msg.baga"
import "pgwire_enc.baga"
import "pgwire_scram.baga"
import "../server/databases.baga"
import "../catalog/acl.baga"
import "../catalog/acl_scram.baga"
import "../sql/exec_acl.baga"
import "std/net/tcp.baga"
import "std/net/tls_conn.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/crypto/ct.baga"

struct BoilaPgAuth {
    srv: BoilaServer,
    sess: BoilaPgSess,
    r: PgWReader,
    ok: i64,
    err: str
}

// Auth writes go through the session transport (TLS after SSLRequest 'S').
// Parallel to pgwire.baga's pgw_write — importing it here would cycle.
struct BoilaPgWA {
    sess: BoilaPgSess,
    ok: i64
}

fn pgw_write_a(sess: BoilaPgSess, b: bytes) -> BoilaPgWA !Net !IO !Par {
    if sess.tls == 1 {
        let c2 = tls_conn_write(sess.tconn, b)?
        let mut s2 = sess
        s2.tconn = c2
        // 0 = успех (конвенцията на tcp_write_bytes); TlsConn.ok е 1/0
        if c2.ok == 1 {
            return BoilaPgWA { sess: s2, ok: 0 }
        }
        return BoilaPgWA { sess: s2, ok: 0 - 1 }
    }
    let w = tcp_write_bytes(sess.fd, b)?
    return BoilaPgWA { sess: sess, ok: w }
}

fn pgw_auth_fail(sess: BoilaPgSess, srv: BoilaServer, rr: PgWReader, state: str, msg: str, err: str) -> BoilaPgAuth !Net !IO !Par {
    let w = pgw_write_a(sess, pgw_error(state, msg))?
    return BoilaPgAuth { srv: srv, sess: w.sess, r: rr, ok: 0, err: err }
}

fn pgw_auth_cleartext(rr: PgWReader, srv: BoilaServer, sess: BoilaPgSess, login_user: str, token: str, has_users: i64) -> BoilaPgAuth !IO !Net !Time !Par {
    let mut sp = sess
    let w0 = pgw_write_a(sp, pgw_msg(82, pgw_be32(3)))?
    sp = w0.sess
    if w0.ok != 0 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "auth write" }
    }
    let pm = pgw_read_msg(rr)?
    rr = pm.r
    if pm.ok == 0 || pm.typ != 112 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "no password" }
    }
    let pw = pgw_cstr_read(pm.body, 0)
    let mut auth_ok = 0
    if has_users == 1 && login_user != "" {
        let ar = boila_acl_auth(srv.meta, login_user, pw.s)?
        srv.meta = ar.s
        if ar.ok == 1 {
            auth_ok = 1
            sp.guc = boila_sess_set_user(sp.guc, login_user, ar.super)
        }
    }
    if auth_ok == 0 && token != "" && ct_eq(pw.s, token) {
        auth_ok = 1
        let mut un = login_user
        if un == "" { un = "boila" }
        sp.guc = boila_sess_set_user(sp.guc, un, 1)
    }
    if auth_ok == 0 {
        return pgw_auth_fail(sp, srv, rr, "28P01", "password authentication failed", "bad auth")?
    }
    return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 1, err: "" }
}

fn pgw_auth_scram(rr: PgWReader, srv: BoilaServer, sess: BoilaPgSess, login_user: str, token: str) -> BoilaPgAuth !IO !Net !Time !Par {
    let mut sp = sess
    let w0 = pgw_write_a(sp, pgw_auth_sasl())?
    sp = w0.sess
    if w0.ok != 0 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "sasl write" }
    }
    let pm = pgw_read_msg(rr)?
    rr = pm.r
    if pm.ok == 0 || pm.typ != 112 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "no sasl" }
    }
    if pgw_p_is_sasl(pm.body) == 0 {
        return pgw_auth_fail(sp, srv, rr, "28000", "SCRAM-SHA-256 required", "need scram")?
    }
    let cfirst = pgw_sasl_client_first(pm.body)
    let bare = pgw_scram_cfirst_bare(cfirst)
    let cnonce = pgw_scram_cnonce(bare)
    if cnonce == "" {
        return pgw_auth_fail(sp, srv, rr, "28000", "invalid SCRAM client-first", "bad cfirst")?
    }
    let mut ver = ""
    let mut is_super: i64 = 0
    if login_user != "" {
        let ug = boila_acl_user_get(srv.meta, login_user)?
        srv.meta = ug.s
        if ug.ok == 1 && boila_scram_is(ug.hash) == 1 {
            ver = ug.hash
            is_super = ug.super
        }
    }
    if ver == "" && token != "" {
        ver = boila_scram_hash_pw(login_user, token)?
        is_super = 1
    }
    if ver == "" {
        ver = boila_scram_hash_pw("!", "!")?
    }
    let snonce = pgw_scram_snonce(cnonce)?
    let sfirst = boila_scram_server_first(ver, cfirst, snonce)
    if sfirst == "" {
        return pgw_auth_fail(sp, srv, rr, "28000", "SCRAM setup failed", "no sfirst")?
    }
    let w1 = pgw_write_a(sp, pgw_auth_sasl_cont(sfirst))?
    sp = w1.sess
    if w1.ok != 0 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "cont write" }
    }
    let pm2 = pgw_read_msg(rr)?
    rr = pm2.r
    if pm2.ok == 0 || pm2.typ != 112 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "no final" }
    }
    let cfinal = str_of_bytes(pm2.body)
    let chk = boila_scram_verify(ver, bare, sfirst, cfinal)
    if chk.ok == 0 {
        return pgw_auth_fail(sp, srv, rr, "28P01", "password authentication failed", "bad proof")?
    }
    let w2 = pgw_write_a(sp, pgw_auth_sasl_final(concat("v=", chk.sig)))?
    sp = w2.sess
    if w2.ok != 0 {
        return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 0, err: "final write" }
    }
    let mut un = login_user
    if un == "" { un = "boila" }
    sp.guc = boila_sess_set_user(sp.guc, un, is_super)
    return BoilaPgAuth { srv: srv, sess: sp, r: rr, ok: 1, err: "" }
}

// After startup: authenticate and set sess.guc user. ok=0 → caller closes.
fn pgw_authenticate(rr: PgWReader, srv: BoilaServer, sess: BoilaPgSess, login_user: str) -> BoilaPgAuth !IO !Net !Time !Par {
    let mode = boila_auth_mode()?
    if mode == "trust" {
        return BoilaPgAuth { srv: srv, sess: sess, r: rr, ok: 1, err: "" }
    }
    let token = env("BOILA_TOKEN")
    let uc = boila_acl_user_count(srv.meta)?
    srv.meta = uc.s
    let mut need_pw = 0
    if uc.super > 0 { need_pw = 1 }
    if token != "" { need_pw = 1 }
    if need_pw == 0 {
        return BoilaPgAuth { srv: srv, sess: sess, r: rr, ok: 1, err: "" }
    }
    let mut use_scram = 0
    if mode == "scram" { use_scram = 1 }
    if mode == "auto" && login_user != "" {
        let ug = boila_acl_user_get(srv.meta, login_user)?
        srv.meta = ug.s
        if ug.ok == 1 && boila_scram_is(ug.hash) == 1 { use_scram = 1 }
    }
    if use_scram == 1 {
        return pgw_auth_scram(rr, srv, sess, login_user, token)?
    }
    return pgw_auth_cleartext(rr, srv, sess, login_user, token, uc.super)?
}
