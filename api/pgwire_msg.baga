// pgwire_msg.baga — PostgreSQL wire v3 framing (сървър страна, P6).
// Формати: https://www.postgresql.org/docs/current/protocol-message-formats.html
// Регулярни съобщения: Byte1(type) + Int32(len incl. self) + payload.
// StartupMessage/SSLRequest/CancelRequest нямат type байт.
// Транспорт: PgWReader.tls/tconn — TLS четене (писането е в BoilaPgSess).

import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/net/tcp.baga"
import "std/net/tls_conn.baga"

// --- builders (чисти) ---

fn pgw_one(v: i64) -> bytes {
    let b = bytes_new(1)
    bytes_set(b, 0, v & 255)
    return b
}

fn pgw_be16(v: i64) -> bytes {
    let b = bytes_new(2)
    bytes_set(b, 0, (v >> 8) & 255)
    bytes_set(b, 1, v & 255)
    return b
}

fn pgw_be32(v: i64) -> bytes {
    let b = bytes_new(4)
    bytes_set(b, 0, (v >> 24) & 255)
    bytes_set(b, 1, (v >> 16) & 255)
    bytes_set(b, 2, (v >> 8) & 255)
    bytes_set(b, 3, v & 255)
    return b
}

fn pgw_cstr(s: str) -> bytes {
    return bytes_concat(bytes_of_str(s), pgw_one(0))
}

fn pgw_msg(typ: i64, body: bytes) -> bytes {
    let mut out = pgw_one(typ)
    out = bytes_concat(out, pgw_be32(bytes_len(body) + 4))
    return bytes_concat(out, body)
}

// P14 COPY: 'G' CopyInResponse / 'H' CopyOutResponse / 'd' CopyData / 'c' CopyDone
fn pgw_copy_resp(typ: i64, natts: i64) -> bytes {
    let mut body = pgw_one(0)
    body = bytes_concat(body, pgw_be16(natts))
    let mut i: i64 = 0
    while i < natts {
        body = bytes_concat(body, pgw_be16(0))
        i = i + 1
    }
    return pgw_msg(typ, body)
}

fn pgw_copy_data_line(line: str) -> bytes {
    return pgw_msg(100, bytes_of_str(concat(line, "\n")))
}

fn pgw_copy_done_msg() -> bytes {
    return pgw_msg(99, bytes_new(0))
}

// --- readers ---

fn pgw_be_read(b: bytes, off: i64, n: i64) -> i64 {
    let mut v: i64 = 0
    let mut i: i64 = 0
    while i < n {
        v = v * 256 + (bytes_at(b, off + i) & 255)
        i = i + 1
    }
    return v
}

struct PgWReader {
    fd: i64,
    buf: bytes,
    pos: i64,
    // tls=1 → четене през tconn (декриптирани TLS записи), иначе суров TCP.
    // Писането е отделно: виж BoilaPgSess.tls/tconn.
    tls: i64,
    tconn: TlsConn,
    // P35b: session-lifetime scratch за tcp_read_into — без него всяко
    // четене пускаше 8 KB str + 8 KB bytes (tcp_read_bytes) дори за
    // 60-байтово съобщение. Persist-алокиран в pgw_reader* (режeem: rewind).
    scratch: str
}

fn pgw_reader(fd: i64) -> PgWReader {
    mem_persist_begin()
    let sc = str_repeat(" ", 8192)
    mem_persist_end()
    return PgWReader { fd: fd, buf: bytes_new(0), pos: 0, tls: 0, tconn: tls_conn_bad(""), scratch: sc }
}

fn pgw_reader_tls(fd: i64, conn: TlsConn) -> PgWReader {
    mem_persist_begin()
    let sc = str_repeat(" ", 8192)
    mem_persist_end()
    return PgWReader { fd: fd, buf: bytes_new(0), pos: 0, tls: 1, tconn: conn, scratch: sc }
}

struct PgWFill {
    r: PgWReader,
    ok: i64
}

// P36: евтин first-word sniff без пълен lex — copy/guc проверките на всеки
// 'Q' иначе лексваха целия SQL по веднъж всяка (още един път в exec_sql).
fn pgw_first_word(sql: str) -> str {
    let n = len(sql)
    let mut i: i64 = 0
    let mut skipping = true
    while skipping && i < n {
        let c = char_at(sql, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            skipping = false
        }
    }
    let mut w = ""
    let mut reading = true
    while reading && i < n {
        let mut c = char_at(sql, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        if c >= 97 && c <= 122 {
            w = concat(w, chr(c))
            i = i + 1
        } else {
            reading = false
        }
    }
    return w
}

// Append one chunk of inbound data, preserving the transport fields.
fn pgw_fill_append(rr: PgWReader, chunk: bytes) -> PgWReader {
    if rr.pos > 0 {
        return PgWReader { fd: rr.fd, buf: bytes_concat(bytes_slice(rr.buf, rr.pos, bytes_len(rr.buf)), chunk), pos: 0, tls: rr.tls, tconn: rr.tconn, scratch: rr.scratch }
    }
    return PgWReader { fd: rr.fd, buf: bytes_concat(rr.buf, chunk), pos: rr.pos, tls: rr.tls, tconn: rr.tconn, scratch: rr.scratch }
}

fn pgw_fill(r: PgWReader, n: i64) -> PgWFill !IO !Net !Par {
    let mut rr = r
    while bytes_len(rr.buf) - rr.pos < n {
        if rr.tls == 1 {
            // One TLS record at a time; application payloads (23) accumulate
            // into the plaintext buffer. Alerts/skip → EOF for this conn.
            let rd = tls_conn_read(rr.tconn)?
            rr.tconn = rd.conn
            if rd.conn.ok == 0 || rd.typ == 21 || rd.typ == 0 {
                return PgWFill { r: rr, ok: 0 }
            }
            if rd.typ == 23 && bytes_len(rd.data) > 0 {
                rr = pgw_fill_append(rr, rd.data)
            }
            // typ 22 (post-handshake) — skip
        } else {
            let chunk = tcp_read_into(rr.fd, rr.scratch, 8192)?
            if bytes_len(chunk) == 0 {
                return PgWFill { r: rr, ok: 0 }
            }
            rr = pgw_fill_append(rr, chunk)
        }
    }
    return PgWFill { r: rr, ok: 1 }
}

fn pgw_find_nul(b: bytes, off: i64) -> i64 {
    let n = bytes_len(b)
    let mut i = off
    while i < n {
        if bytes_at(b, i) == 0 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// cstring от body на pos; връща (стринг, нов pos след NUL).
struct PgWCstr {
    s: str,
    pos: i64
}

fn pgw_cstr_read(body: bytes, pos: i64) -> PgWCstr {
    let npos = pgw_find_nul(body, pos)
    if npos < 0 {
        return PgWCstr { s: "", pos: bytes_len(body) }
    }
    return PgWCstr { s: str_of_bytes(bytes_slice(body, pos, npos)), pos: npos + 1 }
}

// Регулярно съобщение: type + body.
struct PgWMsg {
    r: PgWReader,
    ok: i64,
    typ: i64,
    body: bytes
}

fn pgw_read_msg(r: PgWReader) -> PgWMsg !IO !Net !Par {
    let f0 = pgw_fill(r, 5)?
    if f0.ok == 0 {
        return PgWMsg { r: f0.r, ok: 0, typ: 0, body: bytes_new(0) }
    }
    let mut rr = f0.r
    let typ = bytes_at(rr.buf, rr.pos) & 255
    let ln = pgw_be_read(rr.buf, rr.pos + 1, 4) - 4
    rr.pos = rr.pos + 5
    if ln < 0 {
        return PgWMsg { r: rr, ok: 0, typ: typ, body: bytes_new(0) }
    }
    let f1 = pgw_fill(rr, ln)?
    if f1.ok == 0 {
        return PgWMsg { r: f1.r, ok: 0, typ: typ, body: bytes_new(0) }
    }
    rr = f1.r
    let body = bytes_slice(rr.buf, rr.pos, rr.pos + ln)
    rr.pos = rr.pos + ln
    return PgWMsg { r: rr, ok: 1, typ: typ, body: body }
}

// 1 = a full regular message is already in the reader buffer (no socket).
fn pgw_have_msg(r: PgWReader) -> i64 {
    let avail = bytes_len(r.buf) - r.pos
    if avail < 5 {
        return 0
    }
    let ln = pgw_be_read(r.buf, r.pos + 1, 4) - 4
    if ln < 0 {
        return 0
    }
    if avail < 5 + ln {
        return 0
    }
    return 1
}

// Startup-family съобщение (без type байт): len + code (+ params).
struct PgWStartup {
    r: PgWReader,
    ok: i64,
    code: i64,         // 196608 v3; 80877103 SSL; 80877102 cancel
    user: str,
    database: str
}

fn pgw_read_startup(r: PgWReader) -> PgWStartup !IO !Net !Par {
    let f0 = pgw_fill(r, 8)?
    if f0.ok == 0 {
        return PgWStartup { r: f0.r, ok: 0, code: 0, user: "", database: "" }
    }
    let mut rr = f0.r
    let ln = pgw_be_read(rr.buf, rr.pos, 4) - 8
    let code = pgw_be_read(rr.buf, rr.pos + 4, 4)
    rr.pos = rr.pos + 8
    if ln < 0 {
        return PgWStartup { r: rr, ok: 0, code: code, user: "", database: "" }
    }
    if ln == 0 {
        return PgWStartup { r: rr, ok: 1, code: code, user: "", database: "" }
    }
    let f1 = pgw_fill(rr, ln)?
    if f1.ok == 0 {
        return PgWStartup { r: f1.r, ok: 0, code: code, user: "", database: "" }
    }
    rr = f1.r
    let body = bytes_slice(rr.buf, rr.pos, rr.pos + ln)
    rr.pos = rr.pos + ln
    // params: key\0value\0 ... до двойно NUL
    let mut user = ""
    let mut db = ""
    let mut p: i64 = 0
    let mut more = true
    while more && p < bytes_len(body) {
        let k = pgw_cstr_read(body, p)
        if k.s == "" {
            more = false
        } else {
            let v = pgw_cstr_read(body, k.pos)
            if k.s == "user" {
                user = v.s
            }
            if k.s == "database" {
                db = v.s
            }
            p = v.pos
        }
    }
    return PgWStartup { r: rr, ok: 1, code: code, user: user, database: db }
}

// --- стандартни отговори ---

fn pgw_error(sqlstate: str, msg: str) -> bytes {
    let mut body = bytes_new(0)
    body = bytes_concat(body, pgw_one(83))          // 'S' severity
    body = bytes_concat(body, pgw_cstr("ERROR"))
    body = bytes_concat(body, pgw_one(86))          // 'V'
    body = bytes_concat(body, pgw_cstr("ERROR"))
    body = bytes_concat(body, pgw_one(67))          // 'C' sqlstate
    body = bytes_concat(body, pgw_cstr(sqlstate))
    body = bytes_concat(body, pgw_one(77))          // 'M' message
    body = bytes_concat(body, pgw_cstr(msg))
    body = bytes_concat(body, pgw_one(0))
    return pgw_msg(69, body)                        // 'E'
}

fn pgw_ready(tx: i64) -> bytes {
    return pgw_msg(90, pgw_one(tx))                 // 'Z' + 'I'/'T'/'E'
}

fn pgw_param_status(k: str, v: str) -> bytes {
    let body = bytes_concat(pgw_cstr(k), pgw_cstr(v))
    return pgw_msg(83, body)                        // 'S'
}

fn pgw_command_complete(tag: str) -> bytes {
    return pgw_msg(67, pgw_cstr(tag))               // 'C'
}

fn pgw_no_data() -> bytes {
    return pgw_msg(110, bytes_new(0))               // 'n'
}
