// pgwire_mux.baga — idle PG fds sit in poll; workers run one turn.
// P31: keep-alive no longer pins 1 connection per worker.

import "pgwire.baga"
import "pgwire_msg.baga"
import "pgwire_serve.baga"
import "pgwire_on.baga"
import "pgwire_prep.baga"
import "serve_mt.baga"
import "../server/databases.baga"
import "../txn/mvcc.baga"
import "../sql/ast.baga"
import "std/net/tcp.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct BoilaPgLive {
    rr: PgWReader,
    sess: BoilaPgSess,
    started: i64,
    in_err: i64,
    // P33b: persist idle txn за тази сесия — на park при inactive txn
    // sess.txn се ресетва към него (per-conn идиомата от pgwire_serve).
    itxn: BoilaTxn
}

fn boila_pg_mux_new() -> i64 !Par {
    let m: Map<i64, BoilaPgLive> = map_new()
    let sm: Map<i64, str> = map_new()
    return cell2(mutex_new(), cell2(map_h(m), map_h(sm)))
}

// P61: scratch се пази per fd в mux-а и се преизползва при нови връзки;
// иначе всяка връзка оставя 8KB persist (pan 16KB).
fn boila_pg_mux_scratch(mux: i64, fd: i64) -> str !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let sm: Map<i64, str> = h_map(cell2_1(cell2_1(mux)))
    if map_has(sm, fd) == 1 {
        let s = map_get(sm, fd)
        mutex_unlock(mu)
        return s
    }
    mutex_unlock(mu)
    mem_persist_begin()
    let s = str_repeat(" ", 8192)
    mem_persist_end()
    mutex_lock(mu)
    // map entry/buckets също са persist: worker arena rewind не бива да ги
    // реклеймва (иначе map_set върху sm корумпира map-а при churn).
    mem_persist_begin()
    map_set(sm, fd, s)
    mem_persist_end()
    mutex_unlock(mu)
    return s
}

fn boila_pg_mux_put(mux: i64, fd: i64, live: BoilaPgLive) -> i64 !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaPgLive> = h_map(cell2_0(cell2_1(mux)))
    map_set(m, fd, live)
    mutex_unlock(mu)
    return 0
}

fn boila_pg_mux_take(mux: i64, fd: i64) -> BoilaPgLive !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaPgLive> = h_map(cell2_0(cell2_1(mux)))
    if map_has(m, fd) == 1 {
        // MEM-8: не трий. map_del пускаше само entry-то, а box-ът на
        // BoilaPgLive оставаше. Следващият park правеше нов malloc.
        // map_set върху същия fd презаписва същия box.
        let live = map_get(m, fd)
        mutex_unlock(mu)
        return live
    }
    mutex_unlock(mu)
    // Default само за непознат fd (първи turn). НЕ алокира 8KB scratch —
    // startup-ът създава своя; иначе default scratch тече при замяна.
    return BoilaPgLive {
        rr: PgWReader { fd: fd, buf: bytes_new(0), pos: 0, tls: 0,
                        tconn: tls_conn_bad(""), scratch: "" },
        sess: boila_pg_sess_new("boila"),
        started: 0 - 1, in_err: 0, itxn: boila_txn_new()
    }
}



fn boila_pg_mux_close(fd: i64, sess: BoilaPgSess) -> i64 !IO !Par {
    if sess.txn.active == 1 {
        let _r = boila_txn_rollback(sess.txn)
    }
    tcp_close(fd)?
    return 0
}

// Маха fd от mux картата. С MEM-8 map_del пуска и box-а на live.
fn boila_pg_mux_forget(mux: i64, fd: i64) -> i64 !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaPgLive> = h_map(cell2_0(cell2_1(mux)))
    if map_has(m, fd) == 1 {
        map_del(m, fd)
    }
    mutex_unlock(mu)
    return 0
}

// Буферът и картите на сесията не са вътре в box-а като отделни malloc-и
// само ако ги drop-нем. Scratch (str) рантаймът не пуска. Под --rc del
// вече е release — тук не пипаме.
fn boila_pg_mux_release(live: BoilaPgLive) {
    if rc_on() == 1 {
        return
    }
    let b = live.rr.buf
    if bytes_len(b) > 0 {
        drop(b)
    }
    let sm = live.sess.stmts
    drop(sm)
    let pm = live.sess.portals
    drop(pm)
    let gu = live.sess.guc
    drop(gu)
    // P53: e_* empty планове са persist в psess; без това текат на връзка.
    boila_sel_free(live.sess.e_sel)
    boila_ins_free(live.sess.e_ins)
    boila_upd_free(live.sess.e_upd)
    boila_del_free(live.sess.e_del)
}

// P33b: per-turn rewind в mux (същата MEM-4 идиома като per-conn цикъла в
// pgwire_serve.baga:161-219). Без него worker arena-та расте ~60 KB/заявка
// безгранично → OOM SIGKILL при sustained load (измерено: 925 MB за 3 s
// на pgbench c=16). Правила:
//  - сесията се създава в persist региона (maps/db/e_*/itxn);
//  - на park live state-ът се преизгражда в persist (reader leftover,
//    sess обвивка, map node); съдържанието на stmts/portals/guc вече е
//    persist по MEM-4 местата си;
//  - mark-ът се взема СЛЕД startup хода (tconn ключовете са под него и
//    оцеляват rewind — за TLS също), само при затворена txn; rewind — в
//    края на хода пак при затворена txn.

// Persist сесия след startup: st.sess идва от turn arena с прясни maps —
// заменяме с persist maps + копия на guc/db (stmts/portals са празни тук).
fn boila_pg_mux_psess(s: BoilaPgSess, itxn: BoilaTxn) -> BoilaPgSess {
    mem_persist_begin()
    let pstmts: Map<str, BoilaPgStmt> = map_new()
    let pportals: Map<str, BoilaPgPortal> = map_new()
    let pguc: Map<str, str> = map_new()
    let ks = map_keys(s.guc)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let k = vec_get(ks, i)
        let v = map_get(s.guc, k)
        map_set(pguc, substr(k, 0, len(k)), substr(v, 0, len(v)))
        i = i + 1
    }
    let ps = BoilaPgSess {
        stmts: pstmts, portals: pportals, db: substr(s.db, 0, len(s.db)),
        txn: itxn, guc: pguc,
        e_sel: boila_sel_empty(), e_ins: boila_ins_empty(),
        e_upd: boila_upd_empty(), e_del: boila_del_empty(),
        fd: s.fd, tls: s.tls, tconn: s.tconn, sc: boila_mt_sc_empty()
    }
    mem_persist_end()
    return ps
}

// Паркиране: преизгражда live в persist региона и го слага в mux картата.
// Ключът вече е в картата (take не го трие) — map_set презаписва box-а.
fn boila_pg_mux_park(mux: i64, fd: i64, live: BoilaPgLive, pempty: bytes) -> i64 !Par {
    let old = live.rr.buf
    mem_persist_begin()
    let mut nb = pempty
    if live.rr.pos < bytes_len(old) {
        nb = bytes_slice(old, live.rr.pos, bytes_len(old))
    }
    let prr = PgWReader { fd: fd, buf: nb, pos: 0, tls: live.rr.tls, tconn: live.rr.tconn, scratch: live.rr.scratch }
    let s = live.sess
    let mut txn = live.itxn
    if s.txn.active == 1 {
        txn = s.txn
    }
    let ps = BoilaPgSess {
        stmts: s.stmts, portals: s.portals, db: s.db, txn: txn, guc: s.guc,
        e_sel: s.e_sel, e_ins: s.e_ins, e_upd: s.e_upd, e_del: s.e_del,
        fd: s.fd, tls: s.tls, tconn: s.tconn, sc: s.sc
    }
    let pl = BoilaPgLive { rr: prr, sess: ps, started: live.started, in_err: live.in_err, itxn: live.itxn }
    let r = boila_pg_mux_put(mux, fd, pl)?
    mem_persist_end()
    // Споделеният празен pempty е len 0 и не се пипа. Пълен буфер
    // (arena от хода или persist leftover) се пуска след копието.
    // Под --rc map_set release-ва старото поле — втори drop е двоен.
    if rc_on() == 0 {
        if bytes_len(old) > 0 {
            drop(old)
        }
    }
    return r
}

fn boila_pg_mux_drain(pack: i64, live0: BoilaPgLive, block: i64) -> BoilaPgLive !IO !Net !Time !Par !Random {
    let mut live = live0
    let seed = boila_mt_seed_srv()
    let mut first: i64 = 1
    let mut more: i64 = 1
    while more == 1 {
        let have = pgw_have_msg(live.rr)
        if have == 0 {
            if first == 1 && block == 1 {
                let m = pgw_read_msg(live.rr)?
                first = 0
                if m.ok == 0 {
                    live.started = 0 - 2
                    more = 0
                } else {
                    let t = pgw_on_msg(pack, seed, live.sess, m, live.in_err)?
                    live.rr = t.rr
                    live.sess = t.sess
                    live.in_err = t.in_err
                    if t.running == 0 {
                        live.started = 0 - 2
                        more = 0
                    }
                }
            } else {
                more = 0
            }
        } else {
            let m = pgw_read_msg(live.rr)?
            first = 0
            if m.ok == 0 {
                live.started = 0 - 2
                more = 0
            } else {
                let t = pgw_on_msg(pack, seed, live.sess, m, live.in_err)?
                live.rr = t.rr
                live.sess = t.sess
                live.in_err = t.in_err
                if t.running == 0 {
                    live.started = 0 - 2
                    more = 0
                }
            }
        }
    }
    return live
}

fn boila_pg_mux_turn(pack: i64, mux: i64, fd: i64, pempty: bytes) -> i64 !IO !Net !Time !Par !Random {
    // P54: mark ПРЕДИ take — default сесията/плановете от take са arena
    // и иначе остават под startup mark-а. За съществуваща връзка веднага
    // връщаме mark-а (take само чете persist box).
    let pre = mem_mark()
    let mut live = boila_pg_mux_take(mux, fd)?
    if live.started >= 0 {
        mem_rewind(pre)
    }
    if live.started < 0 {
        mem_persist_begin()
        let sp = boila_pg_sess_new("boila")
        let it = boila_txn_new()
        mem_persist_end()
        // live.rr идва от take (с persist scratch) — не се пресъздава.
        // Junk-ът на default-а от take (buf/stmts/portals/guc) се пуска тук —
        // иначе по няколко malloc кутии на връзка (MEM-8/P33b остатъка).
        boila_pg_mux_release(live)
        live = BoilaPgLive { rr: live.rr, sess: sp, started: 0, in_err: 0, itxn: it }
        live.sess.fd = fd
        live.sess.txn = live.itxn
    }
    if live.started == 0 {
        // P52: startup-ът е connection-scoped. За non-TLS вдигаме mark
        // ПРЕДИ него и rewind-ваме след psess; иначе startup arena-та
        // (maps, buffers) остава под първия turn mark и тече на връзка.
        // TLS ключовете живеят в arena ⇒ при tls==1 пазим старото поведение.
        let pre = mem_mark()
        let sc = boila_pg_mux_scratch(mux, fd)?
        let st = pgw_serve_startup(fd, pack, boila_mt_seed_srv(), sc)?
        if st.ok == 0 || st.done == 0 {
            mem_rewind(pre)
            boila_pg_mux_forget(mux, fd)?
            boila_pg_mux_release(live)
            return 0
        }
        let st_tls = st.sess.tls
        let mut st_rr = st.rr
        if st_tls == 0 {
            mem_persist_begin()
            let mut nb = pempty
            if st_rr.pos < bytes_len(st_rr.buf) {
                nb = bytes_slice(st_rr.buf, st_rr.pos, bytes_len(st_rr.buf))
            }
            mem_persist_end()
            st_rr = PgWReader { fd: fd, buf: nb, pos: 0, tls: 0,
                                tconn: st_rr.tconn, scratch: st_rr.scratch }
        }
        live.started = 1
        live.rr = st_rr
        live.sess = boila_pg_mux_psess(st.sess, live.itxn)
        if st_tls == 0 {
            mem_rewind(pre)
        }
        // Mark чак СЛЕД startup: tconn ключовете (и всичко от ръкостискането,
        // вкл. PEM parse-а) са ПОД mark-а и оцеляват rewind — както в per-conn
        // цикъла на pgwire_serve.baga. Преди mark-ът се вземаше преди startup
        // и rewind-ът беше забранен за TLS (`tls == 0`) → arena-та растеше
        // ~60 KB/заявка безгранично → OOM SIGKILL при sustained load.
        let mut rmark: i64 = 0
        let mut have_mark = false
        if live.sess.txn.active == 0 {
            rmark = mem_mark()
            have_mark = true
        }
        live = boila_pg_mux_drain(pack, live, 0)?
        if live.started == 0 - 2 {
            boila_pg_mux_forget(mux, fd)?
            boila_pg_mux_release(live)
            boila_pg_mux_close(fd, live.sess)?
            if have_mark {
                mem_rewind(rmark)
            }
            return 0
        }
        boila_pg_mux_park(mux, fd, live, pempty)?
        if have_mark && live.sess.txn.active == 0 {
            mem_rewind(rmark)
        }
        return 1
    }
    // P33b: mark само при затворена txn; rewind — пак при затворена txn
    // (txn може да се отвори в средата на batch → проверка пак накрая).
    // Mark-ът е turn-local и винаги последният за нишката (един ход = един
    // worker) — LIFO редът на mem_rewind се пази; затова не се паркира
    // през ходове: следващият ход може да е на друг worker.
    let mut rmark: i64 = 0
    let mut have_mark = false
    if live.sess.txn.active == 0 {
        rmark = mem_mark()
        have_mark = true
    }
    live = boila_pg_mux_drain(pack, live, 1)?
    if live.started == 0 - 2 {
        boila_pg_mux_forget(mux, fd)?
        boila_pg_mux_release(live)
        boila_pg_mux_close(fd, live.sess)?
        if have_mark {
            mem_rewind(rmark)
        }
        return 0
    }
    boila_pg_mux_park(mux, fd, live, pempty)?
    if have_mark && live.sess.txn.active == 0 {
        mem_rewind(rmark)
    }
    return 1
}

