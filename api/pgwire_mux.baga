// pgwire_mux.baga — idle PG fds sit in poll; workers run one turn.
// P31: keep-alive no longer pins 1 connection per worker.

import "pgwire.baga"
import "pgwire_msg.baga"
import "pgwire_serve.baga"
import "pgwire_on.baga"
import "pgwire_prep.baga"
import "serve_mt.baga"
import "serve_mux.baga"
import "../server/databases.baga"
import "../txn/mvcc.baga"
import "../sql/ast.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct BoilaPgLive {
    rr: PgWReader,
    sess: BoilaPgSess,
    started: i64,
    in_err: i64,
    // P33b: persist idle txn за тази сесия — на park при inactive txn
    // sess.txn се ресетва към него (per-conn идиомата от pgwire_serve).
    itxn: BoilaTxn
}

fn boila_pg_mux_new() -> i64 !Par {
    let m: Map<i64, BoilaPgLive> = map_new()
    return cell2(mutex_new(), map_h(m))
}

fn boila_pg_mux_put(mux: i64, fd: i64, live: BoilaPgLive) -> i64 !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaPgLive> = h_map(cell2_1(mux))
    map_set(m, fd, live)
    mutex_unlock(mu)
    return 0
}

fn boila_pg_mux_take(mux: i64, fd: i64) -> BoilaPgLive !Par {
    let mu = cell2_0(mux)
    mutex_lock(mu)
    let m: Map<i64, BoilaPgLive> = h_map(cell2_1(mux))
    if map_has(m, fd) == 1 {
        let live = map_get(m, fd)
        map_del(m, fd)
        mutex_unlock(mu)
        return live
    }
    mutex_unlock(mu)
    // Default само за непознат fd (първи turn за връзката) — pgw_reader
    // пуска 8 KB persist scratch, не смее да се строи на всеки take.
    return BoilaPgLive {
        rr: pgw_reader(fd), sess: boila_pg_sess_new("boila"),
        started: 0 - 1, in_err: 0, itxn: boila_txn_new()
    }
}



fn boila_pg_mux_close(fd: i64, sess: BoilaPgSess) -> i64 !IO !Par {
    if sess.txn.active == 1 {
        let _r = boila_txn_rollback(sess.txn)
    }
    tcp_close(fd)?
    return 0
}

// P33b: per-turn rewind в mux (същата MEM-4 идиома като per-conn цикъла в
// pgwire_serve.baga:161-219). Без него worker arena-та расте ~60 KB/заявка
// безгранично → OOM SIGKILL при sustained load (измерено: 925 MB за 3 s
// на pgbench c=16). Правила:
//  - сесията се създава в persist региона (maps/db/e_*/itxn);
//  - на park live state-ът се преизгражда в persist (reader leftover,
//    sess обвивка, map node); съдържанието на stmts/portals/guc вече е
//    persist по MEM-4 местата си;
//  - rewind се прави само при затворена txn и без TLS (tconn ключовете са
//    дълбока структура от startup turn-а — не се преизгражда).

// Persist сесия след startup: st.sess идва от turn arena с прясни maps —
// заменяме с persist maps + копия на guc/db (stmts/portals са празни тук).
fn boila_pg_mux_psess(s: BoilaPgSess, itxn: BoilaTxn) -> BoilaPgSess {
    mem_persist_begin()
    let pstmts: Map<str, BoilaPgStmt> = map_new()
    let pportals: Map<str, BoilaPgPortal> = map_new()
    let pguc: Map<str, str> = map_new()
    let ks = map_keys(s.guc)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let k = vec_get(ks, i)
        let v = map_get(s.guc, k)
        map_set(pguc, substr(k, 0, len(k)), substr(v, 0, len(v)))
        i = i + 1
    }
    let ps = BoilaPgSess {
        stmts: pstmts, portals: pportals, db: substr(s.db, 0, len(s.db)),
        txn: itxn, guc: pguc,
        e_sel: boila_sel_empty(), e_ins: boila_ins_empty(),
        e_upd: boila_upd_empty(), e_del: boila_del_empty(),
        fd: s.fd, tls: s.tls, tconn: s.tconn, sc: boila_mt_sc_empty()
    }
    mem_persist_end()
    return ps
}

// Паркиране: преизгражда live в persist региона и го слага в mux картата.
fn boila_pg_mux_park(mux: i64, fd: i64, live: BoilaPgLive, pempty: bytes) -> i64 !Par {
    mem_persist_begin()
    let mut nb = pempty
    if live.rr.pos < bytes_len(live.rr.buf) {
        nb = bytes_slice(live.rr.buf, live.rr.pos, bytes_len(live.rr.buf))
    }
    let prr = PgWReader { fd: fd, buf: nb, pos: 0, tls: live.rr.tls, tconn: live.rr.tconn, scratch: live.rr.scratch }
    let s = live.sess
    let mut txn = live.itxn
    if s.txn.active == 1 {
        txn = s.txn
    }
    let ps = BoilaPgSess {
        stmts: s.stmts, portals: s.portals, db: s.db, txn: txn, guc: s.guc,
        e_sel: s.e_sel, e_ins: s.e_ins, e_upd: s.e_upd, e_del: s.e_del,
        fd: s.fd, tls: s.tls, tconn: s.tconn, sc: s.sc
    }
    let pl = BoilaPgLive { rr: prr, sess: ps, started: live.started, in_err: live.in_err, itxn: live.itxn }
    let r = boila_pg_mux_put(mux, fd, pl)?
    mem_persist_end()
    return r
}

fn boila_pg_mux_drain(pack: i64, live0: BoilaPgLive, block: i64) -> BoilaPgLive !IO !Net !Time !Par !Random {
    let mut live = live0
    let seed = boila_mt_seed_srv()
    let mut first: i64 = 1
    let mut more: i64 = 1
    while more == 1 {
        let have = pgw_have_msg(live.rr)
        if have == 0 {
            if first == 1 && block == 1 {
                let m = pgw_read_msg(live.rr)?
                first = 0
                if m.ok == 0 {
                    live.started = 0 - 2
                    more = 0
                } else {
                    let t = pgw_on_msg(pack, seed, live.sess, m, live.in_err)?
                    live.rr = t.rr
                    live.sess = t.sess
                    live.in_err = t.in_err
                    if t.running == 0 {
                        live.started = 0 - 2
                        more = 0
                    }
                }
            } else {
                more = 0
            }
        } else {
            let m = pgw_read_msg(live.rr)?
            first = 0
            if m.ok == 0 {
                live.started = 0 - 2
                more = 0
            } else {
                let t = pgw_on_msg(pack, seed, live.sess, m, live.in_err)?
                live.rr = t.rr
                live.sess = t.sess
                live.in_err = t.in_err
                if t.running == 0 {
                    live.started = 0 - 2
                    more = 0
                }
            }
        }
    }
    return live
}

fn boila_pg_mux_turn(pack: i64, mux: i64, fd: i64, pempty: bytes) -> i64 !IO !Net !Time !Par !Random {
    let mut live = boila_pg_mux_take(mux, fd)?
    if live.started < 0 {
        mem_persist_begin()
        let sp = boila_pg_sess_new("boila")
        let it = boila_txn_new()
        mem_persist_end()
        // live.rr идва от take (с persist scratch) — не се пресъздава.
        live = BoilaPgLive { rr: live.rr, sess: sp, started: 0, in_err: 0, itxn: it }
        live.sess.fd = fd
        live.sess.txn = live.itxn
    }
    // P33b: mark само при затворена txn; rewind — пак при затворена txn и
    // без TLS (txn може да се отвори в средата на batch → проверка пак накрая).
    let mut rmark: i64 = 0
    let mut have_mark = false
    if live.sess.txn.active == 0 {
        rmark = mem_mark()
        have_mark = true
    }
    if live.started == 0 {
        let st = pgw_serve_startup(fd, pack, boila_mt_seed_srv())?
        if st.ok == 0 || st.done == 0 {
            return 0
        }
        live.started = 1
        live.rr = st.rr
        live.sess = boila_pg_mux_psess(st.sess, live.itxn)
        live = boila_pg_mux_drain(pack, live, 0)?
        if live.started == 0 - 2 {
            boila_pg_mux_close(fd, live.sess)?
            if have_mark && live.sess.txn.active == 0 && live.sess.tls == 0 {
                mem_rewind(rmark)
            }
            return 0
        }
        boila_pg_mux_park(mux, fd, live, pempty)?
        if have_mark && live.sess.txn.active == 0 && live.sess.tls == 0 {
            mem_rewind(rmark)
        }
        return 1
    }
    live = boila_pg_mux_drain(pack, live, 1)?
    if live.started == 0 - 2 {
        boila_pg_mux_close(fd, live.sess)?
        if have_mark && live.sess.txn.active == 0 && live.sess.tls == 0 {
            mem_rewind(rmark)
        }
        return 0
    }
    boila_pg_mux_park(mux, fd, live, pempty)?
    if have_mark && live.sess.txn.active == 0 && live.sess.tls == 0 {
        mem_rewind(rmark)
    }
    return 1
}

fn boila_pg_mux_worker(ctx: i64) -> i64 !IO !Net !Time !Par {
    let work = cell2_0(ctx)
    let rest = cell2_1(ctx)
    let idle = cell2_0(rest)
    let rest2 = cell2_1(rest)
    let pack = cell2_0(rest2)
    let rest3 = cell2_1(rest2)
    let mux = cell2_0(rest3)
    let wfd = cell2_1(rest3)
    let mut running: i64 = 1
    mem_persist_begin()
    let pempty = bytes_new(0)
    mem_persist_end()
    while running == 1 {
        let p = chan_recv2(work)
        if cell2_0(p) == 0 {
            running = 0
        } else {
            let fd = cell2_1(p)
            if fd < 0 {
                running = 0
            } else {
                let open = boila_pg_mux_turn(pack, mux, fd, pempty) catch !IO => 0 catch !Net => 0 catch !Time => 0 catch !Random => 0
                if open == 1 {
                    chan_send(idle, fd)
                    boila_mux_wake(wfd)?
                } else {
                    boila_mt_end_conn(pack)?
                }
            }
        }
    }
    return 0
}

fn boila_pg_mux_run(listener: i64, pack: i64, workers: i64) -> i64 !IO !Net !Time !Par !Random {
    let mux = boila_pg_mux_new()?
    let pipe = boila_mux_pipe2()?
    let rfd = cell2_0(pipe)
    let wfd = cell2_1(pipe)
    if rfd < 0 {
        return 1
    }
    let work = chan_new(64)
    let idlech = chan_new(64)
    let wctx = cell2(work, cell2(idlech, cell2(pack, cell2(mux, wfd))))
    let mut i: i64 = 0
    while i < workers {
        go_bg(boila_pg_mux_worker, wctx)
        i = i + 1
    }
    let mut idle: Vec<i64> = vec_new()
    let mut going: i64 = 1
    while going == 1 {
        idle = boila_mux_idle_pull(idlech, idle)?
        let set: Vec<i64> = vec_new()
        vec_push(set, listener)
        vec_push(set, rfd)
        let mut j: i64 = 0
        while j < vec_len(idle) {
            vec_push(set, vec_get(idle, j))
            j = j + 1
        }
        let pr = poll_wait(set, 200)?
        if pr.ok < 0 {
            going = 0
        } else {
            idle = boila_mux_idle_pull(idlech, idle)?
            if poll_has(pr.ready, rfd) == 1 {
                let _b = tcp_read(rfd, 64)?
            }
            let mut k: i64 = 0
            while k < vec_len(pr.ready) {
                let fd = vec_get(pr.ready, k)
                if fd != listener && fd != rfd {
                    if boila_mux_vec_has(idle, fd) == 1 {
                        idle = boila_mux_vec_drop(idle, fd)
                        chan_send(work, fd)
                    }
                }
                k = k + 1
            }
            if poll_has(pr.ready, listener) == 1 {
                let fd = tcp_accept(listener)?
                if fd >= 0 {
                    tcp_set_nodelay(fd)?
                    if boila_mt_try_conn(pack)? == 0 {
                        tcp_close(fd)?
                    } else {
                        if boila_mux_vec_has(idle, fd) == 0 {
                            vec_push(idle, fd)
                        }
                    }
                }
            }
        }
    }
    return 1
}
