// pgwire_on.baga — one PG frontend message (simple + extended).
// Used by the blocking serve loop and by the idle-fd mux (P31).

import "pgwire.baga"
import "pgwire_copy.baga"
import "pgwire_msg.baga"
import "pgwire_desc.baga"
import "pgwire_free.baga"
import "../server/databases.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct BoilaPgTick {
    rr: PgWReader,
    srv: BoilaServer,
    sess: BoilaPgSess,
    running: i64,
    in_err: i64
}

fn pgw_tick(rr: PgWReader, srv: BoilaServer, sp: BoilaPgSess, running: i64, in_err: i64) -> BoilaPgTick {
    return BoilaPgTick { rr: rr, srv: srv, sess: sp, running: running, in_err: in_err }
}

fn pgw_on_msg(pack: i64, srv: BoilaServer, sess: BoilaPgSess, m: PgWMsg, in_err: i64) -> BoilaPgTick !IO !Net !Time !Par {
    let mut sp = sess
    let mut srv2 = srv
    let rr0 = m.r
    if in_err == 1 {
        if m.typ == 83 {
            let w = pgw_write(sp, pgw_ready(pgw_tx_status(sp)))?
            if w.ok != 0 {
                return pgw_tick(rr0, srv2, w.sp, 0, 0)
            }
            return pgw_tick(rr0, srv2, w.sp, 1, 0)
        }
        if m.typ == 88 {
            return pgw_tick(rr0, srv2, sp, 0, 1)
        }
        return pgw_tick(rr0, srv2, sp, 1, 1)
    }
    if m.typ == 81 {
        let sql = pgw_cstr_read(m.body, 0)
        let cin = pgw_copy_in_run(pack, srv2, sp, sql.s, rr0)?
        if cin.hit == 1 {
            let mut run: i64 = 1
            if cin.ok == 0 {
                run = 0
            }
            return pgw_tick(cin.rr, cin.srv, cin.sess, run, 0)
        }
        let ro = pgw_run_sql(pack, srv2, sp, sql.s, 1)?
        let mut runq: i64 = 1
        if ro.ok == 0 {
            runq = 0
        }
        return pgw_tick(rr0, ro.srv, ro.sess, runq, 0)
    }
    if m.typ == 80 {
        sp = pgw_do_parse(m.body, sp)
        let w = pgw_write(sp, pgw_msg(49, bytes_new(0)))?
        let mut runp: i64 = 1
        if w.ok != 0 {
            runp = 0
        }
        return pgw_tick(rr0, srv2, w.sp, runp, 0)
    }
    if m.typ == 66 {
        sp = pgw_do_bind(m.body, sp)
        let w = pgw_write(sp, pgw_msg(50, bytes_new(0)))?
        let mut runb: i64 = 1
        if w.ok != 0 {
            runb = 0
        }
        return pgw_tick(rr0, srv2, w.sp, runb, 0)
    }
    if m.typ == 68 {
        let dbuf = boila_pg_describe_buf(pack, srv2, sp.db, sp.stmts, sp.portals, m.body)?
        let w = pgw_write(sp, dbuf.buf)?
        let mut rund: i64 = 1
        if w.ok != 0 {
            rund = 0
        }
        return pgw_tick(rr0, dbuf.srv, w.sp, rund, 0)
    }
    if m.typ == 69 {
        let pn = pgw_cstr_read(m.body, 0)
        let ro = pgw_exec_portal(pack, srv2, sp, pn.s)?
        let mut rune: i64 = 1
        let mut er: i64 = 0
        if ro.ok == 0 {
            rune = 0
        }
        if ro.sql_err == 1 {
            er = 1
        }
        return pgw_tick(rr0, ro.srv, ro.sess, rune, er)
    }
    if m.typ == 83 {
        if sp.txn.active == 0 {
            if map_has(sp.portals, "") == 1 {
                let dp = map_get(sp.portals, "")
                if dp.kind != 0 - 1 {
                    boila_pg_portal_free(dp)
                    let mut dp2 = dp
                    dp2.kind = 0 - 1
                    dp2.sql = ""
                    map_set(sp.portals, "", dp2)
                }
            }
        }
        let w = pgw_write(sp, pgw_ready(pgw_tx_status(sp)))?
        let mut runs: i64 = 1
        if w.ok != 0 {
            runs = 0
        }
        return pgw_tick(rr0, srv2, w.sp, runs, 0)
    }
    if m.typ == 67 {
        let nm = pgw_cstr_read(m.body, 1)
        let kind = bytes_at(m.body, 0) & 255
        if kind == 83 {
            if map_has(sp.stmts, nm.s) == 1 {
                if boila_pg_stmt_orphaned(sp.portals, nm.s) == 1 {
                    boila_pg_stmt_free(map_get(sp.stmts, nm.s))
                }
            }
            map_del(sp.stmts, nm.s)
        } else {
            if map_has(sp.portals, nm.s) == 1 {
                boila_pg_portal_free(map_get(sp.portals, nm.s))
            }
            map_del(sp.portals, nm.s)
        }
        let w = pgw_write(sp, pgw_msg(51, bytes_new(0)))?
        let mut runc: i64 = 1
        if w.ok != 0 {
            runc = 0
        }
        return pgw_tick(rr0, srv2, w.sp, runc, 0)
    }
    if m.typ == 88 {
        return pgw_tick(rr0, srv2, sp, 0, 0)
    }
    if m.typ == 72 {
        return pgw_tick(rr0, srv2, sp, 1, 0)
    }
    let w = pgw_write(sp, pgw_error("0A000", concat("unsupported message ", int_to_str(m.typ))))?
    let mut runu: i64 = 1
    if w.ok != 0 {
        runu = 0
    }
    return pgw_tick(rr0, srv2, w.sp, runu, 0)
}
