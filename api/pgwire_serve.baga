// pgwire_serve.baga — PG serve loop (P6): startup/auth (SSL/Cancel/v3),
// db check, AuthenticationOk + startup tail, после query loop-ът (simple
// Q / extended P-B-D-E-S-C-H-X). Session/pg out типовете и run_* са в
// pgwire.baga; Describe — в pgwire_desc.baga.

import "pgwire.baga"
import "pgwire_msg.baga"
import "pgwire_enc.baga"
import "pgwire_auth.baga"
import "pgwire_on.baga"
import "serve_mt.baga"
import "../server/databases.baga"
import "../txn/mvcc.baga"
import "std/net/tcp.baga"
import "std/net/tls_server.baga"
import "std/net/tls_conn.baga"
import "std/crypto/pkey.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// pack=0 for single-threaded tests; pack=cell2(mu,map_h) for MT serve.
fn boila_pg_serve(fd: i64, srv: BoilaServer) -> BoilaPgOut !IO !Net !Time !Par !Random {
    return boila_pg_serve_p(fd, 0, srv)?
}

// Стартът: SSL/Cancel/v3 handshake, db check, auth, AuthenticationOk.
// done=0 → връзката е затворена от тук (Cancel / грешка в startup).
struct BoilaPgStart {
    rr: PgWReader,
    srv: BoilaServer,
    sess: BoilaPgSess,
    ok: i64,
    done: i64,
    err: str
}

fn pgw_serve_startup(fd: i64, pack: i64, srv: BoilaServer) -> BoilaPgStart !IO !Net !Time !Par !Random {
    let mut rr = pgw_reader(fd)
    let mut srv2 = srv
    let mut db = "boila"
    let mut login_user = ""
    let mut got = false
    let mut sp: BoilaPgSess = boila_pg_sess_new("boila")
    sp.fd = fd
    while got == false {
        let st = pgw_read_startup(rr)?
        rr = st.r
        if st.ok == 0 {
            tcp_close(fd)?
            return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "startup read" }
        }
        if st.code == 80877103 {
            // SSLRequest → 'S' + TLS 1.3 ръкостискане, когато са зададени
            // BOILA_TLS_CERT/BOILA_TLS_KEY (PEM пътища); иначе 'N'. Лош
            // конфиг също пада към 'N' (честен fallback, без тих успех).
            let mut ssl_on: i64 = 0
            let certpath = env("BOILA_TLS_CERT")?
            let keypath = env("BOILA_TLS_KEY")?
            if certpath != "" && keypath != "" {
                let cert_der = pem_der_block(read_file(certpath)?, "CERTIFICATE")
                let key = pkey_parse_pem(read_file(keypath)?)
                if key.ok == 1 && bytes_len(cert_der) > 0 {
                    let ws = tcp_write_bytes(fd, bytes_of_str("S"))?
                    if ws != 0 {
                        tcp_close(fd)?
                        return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "ssl write" }
                    }
                    let conn = tls_accept(fd, cert_der, key)?
                    if conn.ok == 0 {
                        tcp_close(fd)?
                        return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: conn.err }
                    }
                    sp.tls = 1
                    sp.tconn = conn
                    rr = pgw_reader_tls(fd, conn)
                    ssl_on = 1
                }
            }
            if ssl_on == 0 {
                let w = tcp_write_bytes(fd, bytes_of_str("N"))?
                if w != 0 {
                    tcp_close(fd)?
                    return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "ssl write" }
                }
            }
        } else {
            if st.code == 80877102 {
                // CancelRequest → затвори
                tcp_close(fd)?
                return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 1, done: 0, err: "" }
            }
            if st.code == 196608 {
                if st.database != "" {
                    db = st.database
                }
                login_user = st.user
                got = true
            } else {
                tcp_close(fd)?
                return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "bad startup code" }
            }
        }
    }
    // базата съществува ли (pack!=0 → real server under gmu; seed is empty)
    let mut db_ok: i64 = 0
    if pack != 0 {
        db_ok = boila_mt_db_ok(pack, db)?
    } else {
        let chk = boila_srv_db(srv2, db)?
        srv2 = chk.srv
        db_ok = chk.ok
    }
    if db_ok == 0 {
        let w = pgw_write(sp, pgw_error("3D000", concat("database ", concat(db, " does not exist"))))?
        tcp_close(fd)?
        return BoilaPgStart { rr: rr, srv: srv2, sess: w.sp, ok: 0, done: 0, err: "no db" }
    }
    // новата сесия за базата запазва транспорта (TLS състоянието е от старта)
    let saved_tls = sp.tls
    let saved_tconn = sp.tconn
    sp = boila_pg_sess_new(db)
    sp.fd = fd
    sp.tls = saved_tls
    sp.tconn = saved_tconn
    let au = pgw_authenticate(rr, srv2, sp, login_user)?
    srv2 = au.srv
    sp = au.sess
    rr = au.r
    if au.ok == 0 {
        tcp_close(fd)?
        return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: au.err }
    }
    let w2 = pgw_write(sp, pgw_msg(82, pgw_be32(0)))?         // AuthenticationOk
    sp = w2.sp
    if w2.ok != 0 {
        tcp_close(fd)?
        return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "authok write" }
    }
    let w3 = pgw_send_startup_tail(sp, pgw_tx_status(sp))?
    sp = w3.sp
    if w3.ok != 0 {
        tcp_close(fd)?
        return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 0, done: 0, err: "tail write" }
    }
    return BoilaPgStart { rr: rr, srv: srv2, sess: sp, ok: 1, done: 1, err: "" }
}

fn boila_pg_serve_p(fd: i64, pack: i64, srv: BoilaServer) -> BoilaPgOut !IO !Net !Time !Par !Random {
    let st = pgw_serve_startup(fd, pack, srv)?
    if st.ok == 0 {
        return BoilaPgOut { srv: st.srv, sess: st.sess, ok: 0, sql_err: 0, err: st.err }
    }
    if st.done == 0 {
        return BoilaPgOut { srv: st.srv, sess: st.sess, ok: 1, sql_err: 0, err: "" }
    }
    let mut srv2 = st.srv
    let mut sp = st.sess
    let mut rr = st.rr
    // --- query loop ---
    // MEM-4 (Q2): per-request arena rewind (само MT serve, pack != 0).
    // Mark се взема в началото на итерация, в която няма отворена txn;
    // rewind — в края, когато txn е затворена (mark-ът оцелява през цялата
    // txn). Session state (stmts/portals/guc/db) е persist-алокиран на
    // съответните места; тук се пази само leftover-ът на reader-а и
    // idle txn обвивката.
    mem_persist_begin()
    let idle_txn = boila_txn_new()
    let pempty = bytes_new(0)
    mem_persist_end()
    let mut rmark: i64 = 0
    let mut have_mark = false
    let mut running = true
    let mut in_err = false     // след extended грешка: пропускаме до Sync
    while running {
        if pack != 0 && sp.txn.active == 0 {
            rmark = mem_mark()
            have_mark = true
        }
        let m = pgw_read_msg(rr)?
        rr = m.r
        if m.ok == 0 {
            running = false
        } else {
            let mut ie: i64 = 0
            if in_err {
                ie = 1
            }
            let t = pgw_on_msg(pack, srv2, sp, m, ie)?
            rr = t.rr
            sp = t.sess
            if pack == 0 {
                srv2 = t.srv
            }
            if t.in_err == 1 {
                in_err = true
            } else {
                in_err = false
            }
            if t.running == 0 {
                running = false
            }
        }
        // MEM-4: rewind на заявката — само при затворена txn; mark-ът
        // (и have_mark) оцелява през отворена транзакция до COMMIT/ROLLBACK.
        if have_mark && sp.txn.active == 0 {
            mem_persist_begin()
            let mut nb = pempty
            if rr.pos < bytes_len(rr.buf) {
                nb = bytes_slice(rr.buf, rr.pos, bytes_len(rr.buf))
            }
            mem_persist_end()
            // TLS: ключовете на tconn са от старта (преди mark-а) — оцеляват
            // rewind; новият reader запазва транспортните полета.
            rr = PgWReader { fd: fd, buf: nb, pos: 0, tls: rr.tls, tconn: rr.tconn, scratch: rr.scratch }
            sp.txn = idle_txn
            mem_rewind(rmark)
            have_mark = false
        }
    }
    // txn е per-connection: при затваряне — rollback
    if sp.txn.active == 1 {
        sp.txn = boila_txn_rollback(sp.txn)
    }
    tcp_close(fd)?
    return BoilaPgOut { srv: srv2, sess: sp, ok: 1, sql_err: 0, err: "" }
}
