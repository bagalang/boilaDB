// serve_mt.baga — MT pack: multi-DB + per-shard hop-less + live conn.
// Conn scheduling: api/serve_mt_pool.baga (BOILA_WORKERS).
//
// pack = cell2(gmu, cell2(srv, cell2(dmu, cell2(live, cell2(pcs, stats)))))
//
// Locking:
//   CREATE/DROP DATABASE, USE → gmu (registry).
//   Schema DDL (CREATE/DROP/ALTER/TRUNCATE…) → exclusive schema lock.
//   Data SQL → shared data lock + hop-less per-shard mutex (P11-1b).
//   W1b: schema lock waits for readers so SELECT||DROP cannot race.
// Stats (M1): counters under gmu — safe multi-conn inc.
// No !Par on BoilaStore struct.

import "httpdbaga/http.baga"
import "http_auth.baga"
import "serve_mt_pack.baga"
import "serve_mt_stats.baga"
import "serve_mt_lock.baga"
import "../server/databases.baga"
import "../server/exec_server.baga"
import "../sql/exec_sql.baga"
import "../sql/exec_select.baga"
import "../sql/exec_scan.baga"
import "../sql/exec_copy.baga"
import "../sql/lexer.baga"
import "../sql/plan_cache.baga"
import "../sql/ast.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_mt_seed_srv() -> BoilaServer {
    let names: Vec<str> = vec_new()
    let stores: Vec<BoilaStore> = vec_new()
    return BoilaServer {
        meta: boila_store_empty(), root: "", names: names, stores: stores,
        flush_at: 0, compact_at: 0, dflt_shards: 1, max_db: 1,
        session_txn: boila_txn_new(), pc: boila_pc_new(), guc: map_new(), mt: 0, ok: 0
    }
}

fn boila_mt_new(srv: BoilaServer, max_conn: i64) -> i64 !Par {
    let sm: Map<i64, BoilaServer> = map_new()
    map_set(sm, 0, srv)
    let dm: Map<str, i64> = map_new()
    let live: Map<i64, i64> = map_new()
    map_set(live, 0, 0)
    let mut mc = max_conn
    if mc < 1 {
        mc = 1
    }
    map_set(live, 1, mc)
    map_set(live, 2, 0)
    map_set(live, 3, 0)
    let pcs: Map<str, BoilaPlanCache> = map_new()
    let st: Map<i64, i64> = map_new()
    map_set(st, boila_st_sql(), 0)
    map_set(st, boila_st_sql_ok(), 0)
    map_set(st, boila_st_sql_err(), 0)
    map_set(st, boila_st_http(), 0)
    map_set(st, boila_st_pg(), 0)
    return boila_mt_pack(mutex_new(), map_h(sm), map_h(dm), map_h(live), map_h(pcs), map_h(st))
}

// MEM-4: rocksbaga scan snapshotът (scan_keys, K3h) е per-request кеш в
// ephemeral памет — след rewind на заявката би висял в shared store-а,
// а при съвпадащ epoch следващ scan би го ПРОЧЕЛ (use-after-free).
// Нулираме го преди write-back; следващият scan rebuild-ва (epoch = -1).
// Празният vec е persist (~112 B само при scan-ната заявка — point
// GET/DML hot path-ът не минава през тук).
fn boila_store_snap_off(s: BoilaStore) -> BoilaStore {
    let mut c = s.c
    if vec_len(c.scan_keys) > 0 {
        mem_persist_begin()
        let sk: Vec<bytes> = vec_new()
        mem_persist_end()
        c.scan_keys = sk
        c.scan_epoch = 0 - 1
    }
    let mut s2 = s
    s2.c = c
    return s2
}

fn boila_mt_srv_snap_off(srv: BoilaServer) -> BoilaServer {
    let mut s2 = srv
    s2.meta = boila_store_snap_off(s2.meta)
    let mut i: i64 = 0
    while i < vec_len(s2.stores) {
        vec_set(s2.stores, i, boila_store_snap_off(vec_get(s2.stores, i)))
        i = i + 1
    }
    return s2
}

// Write-back на singleton сървъра. Зад --rc map_set overwrite пуска
// release_S на стария box (споделени names/stores/pc) → rc underflow.
// In-place vec_push/vec_set вече са видими в картата; snap_off пак
// чисти scan_keys на store vec-а. Leak-safe.
fn boila_mt_srv_write(m: Map<i64, BoilaServer>, srv: BoilaServer) {
    let s2 = boila_mt_srv_snap_off(srv)
    if rc_on() {
        return
    }
    map_set(m, 0, s2)
}


// P36: case-insensitive сравнение на span [i,e) с keyword — без concat.
fn boila_kw_ci(sql: str, i: i64, e: i64, kw: str) -> i64 {
    if e - i != len(kw) {
        return 0
    }
    let mut j: i64 = 0
    while j < len(kw) {
        let mut c = char_at(sql, i + j)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        if c != char_at(kw, j) {
            return 0
        }
        j = j + 1
    }
    return 1
}

// 1=db DDL, 2=USE, 3=schema DDL, 0=data (SELECT/DML/txn).
// P36: span scan вместо char-concat по целия SQL (беше O(n²) низов churn).
fn boila_mt_kw2(sql: str) -> i64 {
    let n = len(sql)
    let mut i: i64 = 0
    let mut s1: i64 = 0 - 1
    let mut e1: i64 = 0 - 1
    let mut s2: i64 = 0 - 1
    let mut e2: i64 = 0 - 1
    let mut nw: i64 = 0
    let mut scanning = true
    while scanning && i <= n {
        let mut cl: i64 = 32
        if i < n {
            cl = char_at(sql, i)
        }
        let mut alpha = false
        if cl >= 65 && cl <= 90 {
            alpha = true
        }
        if cl >= 97 && cl <= 122 {
            alpha = true
        }
        if alpha {
            if nw == 0 && s1 < 0 {
                s1 = i
            }
            if nw == 1 && s2 < 0 {
                s2 = i
            }
        } else {
            if nw == 0 && s1 >= 0 {
                e1 = i
                nw = 1
            } else {
                if nw == 1 && s2 >= 0 {
                    e2 = i
                    nw = 2
                    scanning = false
                }
            }
        }
        i = i + 1
    }
    if e1 < 0 {
        return 0
    }
    if boila_kw_ci(sql, s1, e1, "use") == 1 {
        return 2
    }
    if boila_kw_ci(sql, s1, e1, "create") == 1 || boila_kw_ci(sql, s1, e1, "drop") == 1 {
        if s2 >= 0 && e2 >= 0 && boila_kw_ci(sql, s2, e2, "database") == 1 {
            return 1
        }
        return 3
    }
    if boila_kw_ci(sql, s1, e1, "alter") == 1 || boila_kw_ci(sql, s1, e1, "truncate") == 1 || boila_kw_ci(sql, s1, e1, "grant") == 1 || boila_kw_ci(sql, s1, e1, "revoke") == 1 {
        return 3
    }
    return 0
}

fn boila_mt_db_ok(pack: i64, db: str) -> i64 !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let r = boila_srv_db(map_get(m, 0), db)?
    boila_mt_srv_write(m, r.srv)
    let ok = r.ok
    mutex_unlock(gmu)
    return ok
}

// HTTP auth under gmu (needs meta users). Returns updated guc with session user.
fn boila_mt_http_auth(pack: i64, guc: Map<str, str>, req: Request) -> BoilaHttpAuth !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let au = boila_http_auth(map_get(m, 0), guc, req)?
    boila_mt_srv_write(m, au.srv)
    mutex_unlock(gmu)
    return au
}

// Registry-only path (DDL db / USE): whole server_exec under gmu.
fn boila_mt_exec_reg(pack: i64, txn: BoilaTxn, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let out = boila_server_exec_tx(map_get(m, 0), txn, db, sql)?
    boila_mt_srv_write(m, out.srv)
    mutex_unlock(gmu)
    boila_mt_note_sql(pack, out.ok)?
    return out
}

// Warm hit: lookup only (no srv_write). Cold: lazy open + write.
fn boila_mt_checkout(pack: i64, db: str) -> BoilaSrvDb !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let srv = map_get(m, 0)
    let ix = boila_srv_find(srv, db)
    if ix >= 0 {
        let store = vec_get(srv.stores, ix)
        mutex_unlock(gmu)
        return BoilaSrvDb { srv: srv, ok: 1, err: "", state: "", store: store, name: db, evicted: "" }
    }
    let g = boila_srv_db(srv, db)?
    boila_mt_srv_write(m, g.srv)
    mutex_unlock(gmu)
    return g
}

fn boila_mt_checkin(pack: i64, db: str, store: BoilaStore) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let mut srv = map_get(m, 0)
    srv = boila_srv_store_putback(srv, db, store)
    boila_mt_srv_write(m, srv)
    mutex_unlock(gmu)
    return 0
}

// Data SQL: hop-less maps already hold the store. No gmu putback.
fn boila_mt_checkin_data(pack: i64, db: str, store: BoilaStore) -> i64 {
    return 0
}

// Per-db plan cache: ensure entry exists under gmu, return pc (+ mu handle).
fn boila_mt_pc_take(pack: i64, db: str) -> BoilaPlanCache !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let pcs: Map<str, BoilaPlanCache> = h_map(boila_mt_pcs_h(pack))
    let mut pc = boila_pc_new()
    if map_has(pcs, db) == 1 {
        pc = map_get(pcs, db)
    } else {
        // MEM-4: новият pc + ключ от заявката са shared — persist регион
        mem_persist_begin()
        pc = boila_pc_new()
        map_set(pcs, substr(db, 0, len(db)), pc)
        mem_persist_end()
    }
    mutex_unlock(gmu)
    return pc
}

// Keep newer generation (DDL invalidate must not be clobbered by stale put).
fn boila_mt_pc_putback(pack: i64, db: str, pc: BoilaPlanCache) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let pcs: Map<str, BoilaPlanCache> = h_map(boila_mt_pcs_h(pack))
    if map_has(pcs, db) == 1 {
        let cur = map_get(pcs, db)
        // == gen: същият pc (in-place map_set на pc.m). overwrite
        // зад --rc пуска стария box и убива споделения pc.m.
        if pc.gen > cur.gen {
            map_set(pcs, db, pc)
        }
    } else {
        map_set(pcs, db, pc)
    }
    mutex_unlock(gmu)
    return 0
}

struct BoilaMtCo {
    store: BoilaStore,
    pc: BoilaPlanCache,
    ok: i64,
    err: str,
    state: str,
    // P39: db epoch прочетен атомично под gmu (за session handle кеша)
    epoch: i64
}

// P34: checkout + pc_take с ЕДНО gmu вземане (беше 2 отделни на заявка).
// Warm hit: lookup only (no srv_write). Cold: lazy open + write, същият lock.
// P39: cold open/eviction бумпват db epoch; връща текущия epoch.
fn boila_mt_checkout_pc(pack: i64, db: str) -> BoilaMtCo !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let srv = map_get(m, 0)
    let ix = boila_srv_find(srv, db)
    let mut g: BoilaSrvDb = BoilaSrvDb { srv: srv, ok: 1, err: "", state: "", store: boila_store_empty(), name: db, evicted: "" }
    if ix >= 0 {
        g = BoilaSrvDb { srv: srv, ok: 1, err: "", state: "", store: vec_get(srv.stores, ix), name: db, evicted: "" }
    } else {
        let g2 = boila_srv_db(srv, db)?
        boila_mt_srv_write(m, g2.srv)
        g = g2
        // P39: open + eviction са epoch събития (gmu вече е взет → held=1)
        boila_mt_epoch_bump_st(pack, db, 1)?
        if g.evicted != "" {
            boila_mt_epoch_bump_st(pack, g.evicted, 1)?
        }
    }
    let pcs: Map<str, BoilaPlanCache> = h_map(boila_mt_pcs_h(pack))
    let mut pc = boila_pc_new()
    if map_has(pcs, db) == 1 {
        pc = map_get(pcs, db)
    } else {
        // MEM-4: новият pc + ключ от заявката са shared — persist регион
        mem_persist_begin()
        pc = boila_pc_new()
        map_set(pcs, substr(db, 0, len(db)), pc)
        mem_persist_end()
    }
    let epo = boila_mt_epoch_read_st(pack, db, 1)?
    mutex_unlock(gmu)
    return BoilaMtCo { store: g.store, pc: pc, ok: g.ok, err: g.err, state: g.state, epoch: epo }
}

// P39: session handle кеш — data SQL на същата база без gmu по топъл път.
struct BoilaMtSessCache {
    cdb: str,
    cst: i64,
    cstore: BoilaStore,
    cpc: BoilaPlanCache,
    cepo: i64
}

fn boila_mt_sc_empty() -> BoilaMtSessCache {
    return BoilaMtSessCache { cdb: "", cst: 0, cstore: boila_store_empty(), cpc: boila_pc_new(), cepo: 0 - 1 }
}

struct BoilaMtScOut {
    out: BoilaSrvOut,
    sc: BoilaMtSessCache
}

// P39: като boila_mt_exec_guc, но с handle кеш: топъл път (k=0, същата база,
// epoch съвпада) прави само per-db mu lock + exec — 0 gmu вземания.
// Инвалидация: cold open / FIFO eviction / DDL бумпват rw[2] epoch-а.
fn boila_mt_exec_guc_sc(pack: i64, txn: BoilaTxn, db: str, sql: str, guc: Map<str, str>, sc: BoilaMtSessCache) -> BoilaMtScOut !IO !Time !Par {
    let k = boila_mt_kw2(sql)
    if k != 0 {
        // reg/DDL — старият път (DDL бумпва epoch в boila_mt_exec_guc)
        let out = boila_mt_exec_guc(pack, txn, db, sql, guc)?
        return BoilaMtScOut { out: out, sc: sc }
    }
    if sc.cdb == db && sc.cst != 0 {
        let le = boila_mt_data_lock_st_epoch(sc.cst)?
        if cell2_1(le) == sc.cepo {
            let out = boila_exec_sql_mu(sc.cstore, txn, db, sql, sc.cpc, 0, guc)?
            boila_mt_checkin_data(pack, db, out.s)
            boila_mt_data_unlock_st(sc.cst)?
            boila_mt_note_sql(pack, out.ok)?
            return BoilaMtScOut {
                out: BoilaSrvOut {
                    srv: boila_mt_seed_srv(), txn: out.txn, ok: out.ok, err: out.err,
                    state: out.state, kind: out.kind, res: out.res, id: out.id, db: db
                },
                sc: sc
            }
        }
        boila_mt_data_unlock_st(sc.cst)?
    }
    // slow: стандартен flow + презареждане на кеша (epoch идва атомично от checkout)
    let lst = boila_mt_data_lock(pack, db)?
    let g = boila_mt_checkout_pc(pack, db)?
    if g.ok == 0 {
        boila_mt_data_unlock_st(lst)?
        return BoilaMtScOut { out: boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state), sc: sc }
    }
    let out = boila_exec_sql_mu(g.store, txn, db, sql, g.pc, 0, guc)?
    boila_mt_checkin_data(pack, db, out.s)
    boila_mt_data_unlock_st(lst)?
    boila_mt_note_sql(pack, out.ok)?
    // MEM-4 (P39): sc живее в сесията през turn-ове — persist (както
    // stmts/portals/guc); cdb е копие (db може да е arena str).
    mem_persist_begin()
    let sc2 = BoilaMtSessCache { cdb: substr(db, 0, len(db)), cst: lst, cstore: g.store, cpc: g.pc, cepo: g.epoch }
    mem_persist_end()
    return BoilaMtScOut {
        out: BoilaSrvOut {
            srv: boila_mt_seed_srv(), txn: out.txn, ok: out.ok, err: out.err,
            state: out.state, kind: out.kind, res: out.res, id: out.id, db: db
        },
        sc: sc2
    }
}

// W2: bound SELECT AST path (no re-parse). Shared data lock (P11-1b).
fn boila_mt_exec_sel(pack: i64, txn: BoilaTxn, db: str, sel: BoilaSel) -> BoilaSrvOut !IO !Time !Par {
    let lst = boila_mt_data_lock(pack, db)?
    let g = boila_mt_checkout(pack, db)?
    if g.ok == 0 {
        boila_mt_data_unlock_st(lst)?
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state)
    }
    let ct = boila_cat_by_name_txn(g.store, txn, sel.table)?
    let mut s = ct.s
    if ct.ok == 0 {
        boila_mt_checkin_data(pack, db, s)
        boila_mt_data_unlock_st(lst)?
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, ct.err, ct.state)
    }
    let ex = boila_exec_select(s, txn, ct.table, sel)?
    boila_mt_checkin_data(pack, db, ex.s)
    boila_mt_data_unlock_st(lst)?
    boila_mt_note_sql(pack, ex.ok)?
    return BoilaSrvOut {
        srv: boila_mt_seed_srv(), txn: ex.txn, ok: ex.ok, err: ex.err,
        state: ex.state, kind: 1, res: ex.res, id: 0, db: db
    }
}

fn boila_mt_exec(pack: i64, txn: BoilaTxn, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let guc: Map<str, str> = map_new()
    return boila_mt_exec_guc(pack, txn, db, sql, guc)?
}

// W7d: guc for dual current_setting / session-aware dual on MT paths.
fn boila_mt_exec_guc(pack: i64, txn: BoilaTxn, db: str, sql: str, guc: Map<str, str>) -> BoilaSrvOut !IO !Time !Par {
    let k = boila_mt_kw2(sql)
    if k == 1 || k == 2 {
        return boila_mt_exec_reg(pack, txn, db, sql)?
    }

    // P11-1b: data SQL shared; schema DDL exclusive (W1b SELECT||DROP).
    let mut lst: i64 = 0
    if k == 3 {
        boila_mt_schema_lock(pack, db)?
    } else {
        lst = boila_mt_data_lock(pack, db)?
    }

    let g = boila_mt_checkout_pc(pack, db)?
    if g.ok == 0 {
        if k == 3 {
            boila_mt_schema_unlock(pack, db)?
        } else {
            boila_mt_data_unlock_st(lst)?
        }
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state)
    }

    let out = boila_exec_sql_mu(g.store, txn, db, sql, g.pc, 0, guc)?
    if k == 3 {
        boila_mt_checkin(pack, db, out.s)?
        boila_mt_pc_putback(pack, db, out.pc)?
        // P39: DDL инвалидира session handle кешовете за тази база
        boila_mt_epoch_bump_st(pack, db, 0)?
        boila_mt_schema_unlock(pack, db)?
    } else {
        boila_mt_checkin_data(pack, db, out.s)
        boila_mt_data_unlock_st(lst)?
    }

    boila_mt_note_sql(pack, out.ok)?
    return BoilaSrvOut {
        srv: boila_mt_seed_srv(), txn: out.txn, ok: out.ok, err: out.err,
        state: out.state, kind: out.kind, res: out.res, id: out.id, db: db
    }
}

// P22-1: COPY FROM STDIN under the MT pack (shared data lock, hop-less store).
fn boila_mt_copy_from(pack: i64, txn: BoilaTxn, db: str, sql: str, data: str) -> BoilaSrvOut !IO !Time !Par {
    if txn.active == 1 && txn.db != db {
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, "транзакция, започната в друга база — COMMIT/ROLLBACK първо", "0A000")
    }
    let lst = boila_mt_data_lock(pack, db)?
    let g = boila_mt_checkout_pc(pack, db)?
    if g.ok == 0 {
        boila_mt_data_unlock_st(lst)?
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state)
    }
    let lx = boila_lex(sql)
    if lx.err != "" {
        boila_mt_checkin_data(pack, db, g.store)
        boila_mt_data_unlock_st(lst)?
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, lx.err, "42601")
    }
    let out = boila_exec_copy(g.store, txn, db, g.pc, lx, data)?
    boila_mt_checkin_data(pack, db, out.s)
    boila_mt_pc_putback(pack, db, out.pc)?
    boila_mt_data_unlock_st(lst)?
    boila_mt_note_sql(pack, out.ok)?
    return BoilaSrvOut {
        srv: boila_mt_seed_srv(), txn: out.txn, ok: out.ok, err: out.err,
        state: out.state, kind: out.kind, res: out.res, id: out.id, db: db
    }
}

