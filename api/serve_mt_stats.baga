// serve_mt_stats.baga — M1 stats + live conn + open/max db counters.
// Всичко под gmu; pack accessors-те са в serve_mt_pack.baga.

import "serve_mt_pack.baga"
import "../server/databases.baga"

fn boila_mt_stat_inc(pack: i64, key: i64) -> i64 !Par {    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let st: Map<i64, i64> = h_map(boila_mt_stats_h(pack))
    let mut n: i64 = 0
    if map_has(st, key) == 1 { n = map_get(st, key) }
    map_set(st, key, n + 1)
    mutex_unlock(gmu)
    return 0
}

// P34: няколко брояча с ЕДНО вземане на gmu (беше по едно на брояч).
fn boila_mt_stat_inc2(pack: i64, k1: i64, k2: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let st: Map<i64, i64> = h_map(boila_mt_stats_h(pack))
    let mut n1: i64 = 0
    if map_has(st, k1) == 1 { n1 = map_get(st, k1) }
    map_set(st, k1, n1 + 1)
    let mut n2: i64 = 0
    if map_has(st, k2) == 1 { n2 = map_get(st, k2) }
    map_set(st, k2, n2 + 1)
    mutex_unlock(gmu)
    return 0
}

fn boila_mt_stat_get(pack: i64, key: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let st: Map<i64, i64> = h_map(boila_mt_stats_h(pack))
    let mut n: i64 = 0
    if map_has(st, key) == 1 { n = map_get(st, key) }
    mutex_unlock(gmu)
    return n
}

fn boila_mt_note_sql(pack: i64, ok: i64) -> i64 !Par {
    // P34: sql + ok/err под едно gmu вземане (беше 2).
    if ok == 1 { return boila_mt_stat_inc2(pack, boila_st_sql(), boila_st_sql_ok())? }
    return boila_mt_stat_inc2(pack, boila_st_sql(), boila_st_sql_err())?
}

fn boila_mt_try_conn(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    let maxc = map_get(live, 1)
    let mut ok: i64 = 0
    if n < maxc {
        map_set(live, 0, n + 1)
        ok = 1
    }
    mutex_unlock(gmu)
    return ok
}

fn boila_mt_end_conn(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    if n > 0 {
        map_set(live, 0, n - 1)
    }
    mutex_unlock(gmu)
    return 0
}

fn boila_mt_live(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    mutex_unlock(gmu)
    return n
}

// max_conn cap stored at live[1] (see boila_mt_new).
fn boila_mt_max_conn(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 1)
    mutex_unlock(gmu)
    return n
}

// live[2]=workers (0=go_bg), live[3]=mode (0=go_bg, 2=pool)
fn boila_mt_set_pool(pack: i64, workers: i64, mode: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    map_set(live, 2, workers)
    map_set(live, 3, mode)
    mutex_unlock(gmu)
    return 0
}

fn boila_mt_workers(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let mut n: i64 = 0
    if map_has(live, 2) == 1 {
        n = map_get(live, 2)
    }
    mutex_unlock(gmu)
    return n
}

fn boila_mt_open_count(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = vec_len(map_get(m, 0).names)
    mutex_unlock(gmu)
    return n
}

fn boila_mt_max_db(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = map_get(m, 0).max_db
    mutex_unlock(gmu)
    return n
}
