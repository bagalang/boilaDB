// serve_mt_stats.baga — M1 stats + live conn + open/max db counters.
// P44/W2.15: SQL/HTTP/PG броячите и live conn са в замразен свят
// (wcache_add) — без gmu по горещия път. Open/max db остават под gmu.
// pack accessors-те са в serve_mt_pack.baga.

import "serve_mt_pack.baga"
import "../server/databases.baga"

fn boila_mt_stat_shards() -> i64 { return 8 }

// reg world: wcache key 0 = wvec handle; wvec елементите са 8 frozen shards.
fn boila_mt_stat_shard(pack: i64, idx: i64) -> i64 {
    let reg = boila_mt_stats_w(pack)
    let v = wcache_get(reg, 0)
    return wvec_get(reg, v, idx)
}

fn boila_mt_stat_shard_me(pack: i64) -> i64 {
    let idx = (thread_id() >> 4) % boila_mt_stat_shards()
    return boila_mt_stat_shard(pack, idx)
}

fn boila_mt_stat_inc(pack: i64, key: i64) -> i64 !Par {
    wcache_add(boila_mt_stat_shard_me(pack), key, 1)
    return 0
}

// Два брояча без gmu; всеки add е атомарен под wlock-а на кеша.
fn boila_mt_stat_inc2(pack: i64, k1: i64, k2: i64) -> i64 !Par {
    let sw = boila_mt_stat_shard_me(pack)
    wcache_add(sw, k1, 1)
    wcache_add(sw, k2, 1)
    return 0
}

fn boila_mt_stat_get(pack: i64, key: i64) -> i64 !Par {
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < boila_mt_stat_shards() {
        let sw = boila_mt_stat_shard(pack, i)
        if wcache_has(sw, key) == 1 {
            n = n + wcache_get(sw, key)
        }
        i = i + 1
    }
    return n
}

fn boila_mt_note_sql(pack: i64, ok: i64) -> i64 !Par {
    // P34: sql + ok/err под едно gmu вземане (беше 2).
    if ok == 1 { return boila_mt_stat_inc2(pack, boila_st_sql(), boila_st_sql_ok())? }
    return boila_mt_stat_inc2(pack, boila_st_sql(), boila_st_sql_err())?
}

fn boila_mt_try_conn(pack: i64) -> i64 !Par {
    let sw = boila_mt_stat_shard(pack, 0)
    let n = wcache_add(sw, boila_live_conn_k(), 1)
    if n > wcache_get(sw, boila_live_max_k()) {
        wcache_add(sw, boila_live_conn_k(), 0 - 1)
        return 0
    }
    return 1
}

fn boila_mt_end_conn(pack: i64) -> i64 !Par {
    let sw = boila_mt_stat_shard(pack, 0)
    let n = wcache_add(sw, boila_live_conn_k(), 0 - 1)
    if n < 0 {
        wcache_add(sw, boila_live_conn_k(), 1)
    }
    return 0
}

fn boila_mt_live(pack: i64) -> i64 !Par {
    return wcache_get(boila_mt_stat_shard(pack, 0), boila_live_conn_k())
}

fn boila_mt_max_conn(pack: i64) -> i64 !Par {
    return wcache_get(boila_mt_stat_shard(pack, 0), boila_live_max_k())
}

// workers (0=go_bg) / mode (0=go_bg, 2=pool) — config, set once at startup.
fn boila_mt_set_pool(pack: i64, workers: i64, mode: i64) -> i64 !Par {
    let sw = boila_mt_stat_shard(pack, 0)
    wcache_set(sw, boila_live_workers_k(), workers)
    wcache_set(sw, boila_live_mode_k(), mode)
    return 0
}

fn boila_mt_workers(pack: i64) -> i64 !Par {
    return wcache_get(boila_mt_stat_shard(pack, 0), boila_live_workers_k())
}

fn boila_mt_open_count(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = vec_len(map_get(m, 0).names)
    mutex_unlock(gmu)
    return n
}

fn boila_mt_max_db(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = map_get(m, 0).max_db
    mutex_unlock(gmu)
    return n
}
