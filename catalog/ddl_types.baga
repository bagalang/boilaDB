// ddl_types.baga — shared DDL types (kimi-deps D4).
// Lived in sql/ast + sql/parse_alter; catalog consumes them so they sit
// below sql/ (ARCHITECTURE §3 one-way deps).

import "../core/value.baga"

// Column flags (P20-2/P20-3), stored in the schema-row colflags tail.
fn boila_cfl_notnull() -> i64 { return 1 }   // NOT NULL
fn boila_cfl_hasdef() -> i64 { return 2 }   // DEFAULT literal (in def)
fn boila_cfl_defnow() -> i64 { return 4 }    // DEFAULT now()
fn boila_cfl_auto() -> i64 { return 8 }      // auto-number PK (P20-3)

// Column type = value-model tag (i64/bool/str/bytes/json/ts/vector).
struct BoilaColDef {
    name: str,
    typ: i64,
    flags: i64,     // P20-2: boila_cfl_* bits
    def: BoilaVal,  // P20-2: DEFAULT value when flags & hasdef
    nprec: i64,     // P22-2: NUMERIC(p,s); 0 = unconstrained
    nscale: i64
}

// P21-4: one lexed token of a CHECK expression (kind+txt pair kept at
// catalog level so catalog/ never imports sql/).
struct BoilaTokP {
    kind: i64,
    txt: str
}

// P21-3: foreign key. on_delete: 0 = NO ACTION/RESTRICT, 1 = CASCADE,
// 2 = SET NULL.
struct BoilaFk {
    col_idx: i64,
    parent_table: str,
    parent_col: str,
    on_delete: i64
}

struct BoilaCreate {
    table: str,
    cols: Vec<BoilaColDef>,
    pk_idx: i64,
    ttl_sec: i64,           // P9: 0 = none; FROM WITH (ttl_days|ttl_sec)
    checks: Vec<Vec<BoilaTokP>>,  // P21-4: CHECK expressions (token spans)
    fks: Vec<BoilaFk>             // P21-3: foreign keys
}

// kind: 1=add col, 2=rename table, 3=rename column, 4=drop col
struct BoilaAlter {
    kind: i64,
    table: str,
    col: str,
    typ: i64,
    new_name: str
}

fn boila_coldef(name: str, typ: i64) -> BoilaColDef {
    return BoilaColDef { name: name, typ: typ, flags: 0, def: boila_val_null(), nprec: 0, nscale: 0 }
}

fn boila_coldef_c(name: str, typ: i64, flags: i64, def: BoilaVal) -> BoilaColDef {
    return BoilaColDef { name: name, typ: typ, flags: flags, def: def, nprec: 0, nscale: 0 }
}

fn boila_col_set_num(cd: BoilaColDef, p: i64, s: i64) -> BoilaColDef {
    return BoilaColDef { name: cd.name, typ: cd.typ, flags: cd.flags, def: cd.def, nprec: p, nscale: s }
}

fn boila_create_empty() -> BoilaCreate {
    let cols: Vec<BoilaColDef> = vec_new()
    let checks: Vec<Vec<BoilaTokP>> = vec_new()
    let fks: Vec<BoilaFk> = vec_new()
    return BoilaCreate { table: "", cols: cols, pk_idx: 0 - 1, ttl_sec: 0, checks: checks, fks: fks }
}

fn boila_alter_empty() -> BoilaAlter {
    return BoilaAlter { kind: 0, table: "", col: "", typ: 0, new_name: "" }
}
