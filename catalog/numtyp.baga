// numtyp.baga — NUMERIC(p,s) schema-row tail (P22-2).
// [nnum, (col_idx, prec, scale)*]. Absent on pre-P22 rows (prec=0).

import "../core/value.baga"
import "ddl_types.baga"

struct BoilaNumtypTail {
    cols: Vec<BoilaColDef>,
    pos: i64
}

fn boila_numtyp_enc_tail(sch: Vec<BoilaVal>, cols: Vec<BoilaColDef>) -> Vec<BoilaVal> {
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if vec_get(cols, i).nprec > 0 {
            n = n + 1
        }
        i = i + 1
    }
    vec_push(sch, boila_val_i64(n))
    i = 0
    while i < vec_len(cols) {
        let cd = vec_get(cols, i)
        if cd.nprec > 0 {
            vec_push(sch, boila_val_i64(i))
            vec_push(sch, boila_val_i64(cd.nprec))
            vec_push(sch, boila_val_i64(cd.nscale))
        }
        i = i + 1
    }
    return sch
}

fn boila_numtyp_dec_tail(sch: Vec<BoilaVal>, i0: i64, cols0: Vec<BoilaColDef>) -> BoilaNumtypTail {
    let mut cols = cols0
    let mut i = i0
    if i < vec_len(sch) {
        let n = vec_get(sch, i).i
        i = i + 1
        let mut k: i64 = 0
        while k < n && i + 2 < vec_len(sch) {
            let cix = vec_get(sch, i).i
            let p = vec_get(sch, i + 1).i
            let s = vec_get(sch, i + 2).i
            i = i + 3
            if cix >= 0 && cix < vec_len(cols) {
                vec_set(cols, cix, boila_col_set_num(vec_get(cols, cix), p, s))
            }
            k = k + 1
        }
    }
    return BoilaNumtypTail { cols: cols, pos: i }
}
