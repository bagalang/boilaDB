// schema.baga — каталог на таблиците в sys key-space-а.
//
// Ключове (cf=sys, table_id=1), pk е bytes:
//   "n|<име>"        → row [id]
//   "s|<id ord enc>" → row [id, pk_idx, ncols, (col_name, col_typ)*,
//                            nix, (ix_id, ix_col_idx)*]
//   "m|next_id"      → row [next_id]
//
// Индексните дефиниции живеят в schema row-а (P3 rev.2): зареждането им
// е point GET, не scan — избягваме SCAN snapshot-а на rocksbaga, който
// материализира всички ключове при всяка смяна на epoch-а (граница,
// измерена при 1M bench-а; вж. gaps K7).
// Персистентен е (същият WAL като данните) — рестарт не губи схеми.

import "../storage/shards.baga"
import "../storage/shards_keys.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "ddl_types.baga"
import "checks.baga"
import "fks.baga"
import "ttl.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaCatTxnRes {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    table: BoilaTable,
    id: i64
}

struct BoilaIxMeta {
    id: i64,
    cols: Vec<i64>,   // P21-1: indexed columns (1 = single-column)
    name: str,
    uniq: i64         // P20-1: 1 = UNIQUE index (23505 on duplicate)
}

struct BoilaTable {
    id: i64,
    name: str,
    cols: Vec<BoilaColDef>,
    pk_idx: i64,
    ixs: Vec<BoilaIxMeta>,
    ttl_sec: i64,   // P9; 0 = none
    checks: Vec<Vec<BoilaTokP>>,  // P21-4: CHECK expressions (token spans)
    fks: Vec<BoilaFk>             // P21-3: foreign keys
}

struct BoilaCatRes {
    s: BoilaStore,
    ok: i64,
    err: str,
    state: str,
    table: BoilaTable,
    id: i64
}

fn boila_cat_empty_table() -> BoilaTable {
    let cols: Vec<BoilaColDef> = vec_new()
    let ixs: Vec<BoilaIxMeta> = vec_new()
    let checks: Vec<Vec<BoilaTokP>> = vec_new()
    let fks: Vec<BoilaFk> = vec_new()
    return BoilaTable { id: 0, name: "", cols: cols, pk_idx: 0 - 1, ixs: ixs, ttl_sec: 0, checks: checks, fks: fks }
}

fn boila_cat_pk_name(name: str) -> bytes {
    return bytes_of_str(concat("n|", name))
}

fn boila_cat_pk_schema(id: i64) -> bytes {
    return bytes_concat(bytes_of_str("s|"), boila_enc_i64_ord(id))
}

fn boila_cat_pk_meta() -> bytes {
    return bytes_of_str("m|next_id")
}

// Пълен schema row от BoilaTable (за CREATE TABLE и пренаписване при
// CREATE INDEX).
fn boila_cat_schema_row(t: BoilaTable) -> Vec<BoilaVal> {
    let sch: Vec<BoilaVal> = vec_new()
    vec_push(sch, boila_val_i64(t.id))
    vec_push(sch, boila_val_i64(t.pk_idx))
    vec_push(sch, boila_val_i64(vec_len(t.cols)))
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        let cd = vec_get(t.cols, i)
        vec_push(sch, boila_val_str(cd.name))
        vec_push(sch, boila_val_i64(cd.typ))
        i = i + 1
    }
    vec_push(sch, boila_val_i64(vec_len(t.ixs)))
    i = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        vec_push(sch, boila_val_i64(m.id))
        // P21-1: main section keeps the first column; the full list of a
        // multi-column index lives in the ixcols tail.
        let mut c0: i64 = 0 - 1
        if vec_len(m.cols) > 0 {
            c0 = vec_get(m.cols, 0)
        }
        vec_push(sch, boila_val_i64(c0))
        i = i + 1
    }
    // P20-1 tail: [nuniq, (uniq ix_id)*] — old rows have no tail.
    let mut nu: i64 = 0
    i = 0
    while i < vec_len(t.ixs) {
        if vec_get(t.ixs, i).uniq == 1 {
            nu = nu + 1
        }
        i = i + 1
    }
    vec_push(sch, boila_val_i64(nu))
    i = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.uniq == 1 {
            vec_push(sch, boila_val_i64(m.id))
        }
        i = i + 1
    }
    // P20-2 tail: [ncf, (col_idx, flags, [def cell])*] — only flagged
    // columns; pre-P20 rows have no tail and decode as flags=0.
    let mut ncf: i64 = 0
    i = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).flags != 0 {
            ncf = ncf + 1
        }
        i = i + 1
    }
    vec_push(sch, boila_val_i64(ncf))
    i = 0
    while i < vec_len(t.cols) {
        let cd = vec_get(t.cols, i)
        if cd.flags != 0 {
            vec_push(sch, boila_val_i64(i))
            vec_push(sch, boila_val_i64(cd.flags))
            if (cd.flags & boila_cfl_hasdef()) == boila_cfl_hasdef() {
                vec_push(sch, cd.def)
            }
        }
        i = i + 1
    }
    // P21-4 checks tail (absent on pre-P21 rows).
    let sch2 = boila_checks_enc_tail(sch, t.checks)
    // P21-3 fks tail.
    let sch3 = boila_fks_enc_tail(sch2, t.fks)
    // P21-1 ixcols tail: [n_multi, per multi-col ix: (ix_id, ncols, (col_idx)*)].
    let mut nm: i64 = 0
    i = 0
    while i < vec_len(t.ixs) {
        if vec_len(vec_get(t.ixs, i).cols) > 1 {
            nm = nm + 1
        }
        i = i + 1
    }
    vec_push(sch3, boila_val_i64(nm))
    i = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if vec_len(m.cols) > 1 {
            vec_push(sch3, boila_val_i64(m.id))
            vec_push(sch3, boila_val_i64(vec_len(m.cols)))
            let mut ci: i64 = 0
            while ci < vec_len(m.cols) {
                vec_push(sch3, boila_val_i64(vec_get(m.cols, ci)))
                ci = ci + 1
            }
        }
        i = i + 1
    }
    return sch3
}

// CREATE TABLE catalog writes (boila_cat_create / boila_cat_create_txn)
// moved to catalog/create.baga at P21-1 (≤400-line gate).

fn boila_cat_decode_schema(s: BoilaStore, name: str, id: i64, sch_row: bytes) -> BoilaCatRes !IO !Time !Par {
    let sch = boila_row_dec(sch_row)
    if vec_len(sch) < 3 {
        return BoilaCatRes { s: s, ok: 0, err: "повреден каталог (schema row)", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    }
    let e0 = vec_get(sch, 0)
    let e1 = vec_get(sch, 1)
    if e0.i != id {
        return BoilaCatRes { s: s, ok: 0, err: "повреден каталог (id mismatch)", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    }
    let ncols = vec_get(sch, 2).i
    let cols: Vec<BoilaColDef> = vec_new()
    let mut i: i64 = 3
    let mut c: i64 = 0
    while c < ncols && i + 1 < vec_len(sch) {
        let nm = vec_get(sch, i)
        let tp = vec_get(sch, i + 1)
        vec_push(cols, boila_coldef(str_of_bytes(nm.b), tp.i))
        i = i + 2
        c = c + 1
    }
    let ixs: Vec<BoilaIxMeta> = vec_new()
    let mut checks: Vec<Vec<BoilaTokP>> = vec_new()
    let mut fks: Vec<BoilaFk> = vec_new()
    if i < vec_len(sch) {
        let nix = vec_get(sch, i).i
        i = i + 1
        let mut k: i64 = 0
        while k < nix && i + 1 < vec_len(sch) {
            let xid = vec_get(sch, i)
            let xcol = vec_get(sch, i + 1)
            let xcols: Vec<i64> = vec_new()
            vec_push(xcols, xcol.i)
            vec_push(ixs, BoilaIxMeta { id: xid.i, cols: xcols, name: "", uniq: 0 })
            i = i + 2
            k = k + 1
        }
        // P20-1 tail: [nuniq, (uniq ix_id)*]; absent on pre-P20 rows.
        if i < vec_len(sch) {
            let nu = vec_get(sch, i).i
            i = i + 1
            let mut k2: i64 = 0
            while k2 < nu && i < vec_len(sch) {
                let uid = vec_get(sch, i).i
                i = i + 1
                let mut j: i64 = 0
                while j < vec_len(ixs) {
                    let m = vec_get(ixs, j)
                    if m.id == uid {
                        vec_set(ixs, j, BoilaIxMeta { id: m.id, cols: m.cols, name: m.name, uniq: 1 })
                    }
                    j = j + 1
                }
                k2 = k2 + 1
            }
        }
        // P20-2 colflags tail: [ncf, (col_idx, flags, [def cell])*].
        if i < vec_len(sch) {
            let ncf = vec_get(sch, i).i
            i = i + 1
            let mut k3: i64 = 0
            while k3 < ncf && i + 1 < vec_len(sch) {
                let cix2 = vec_get(sch, i).i
                let fl = vec_get(sch, i + 1).i
                i = i + 2
                let mut dv = boila_val_null()
                if (fl & boila_cfl_hasdef()) == boila_cfl_hasdef() && i < vec_len(sch) {
                    dv = vec_get(sch, i)
                    i = i + 1
                }
                if cix2 >= 0 && cix2 < vec_len(cols) {
                    let oc = vec_get(cols, cix2)
                    vec_set(cols, cix2, boila_coldef_c(oc.name, oc.typ, fl, dv))
                }
                k3 = k3 + 1
            }
        }
        // P21-4 checks tail (absent on pre-P21 rows).
        let ct2 = boila_checks_dec_tail(sch, i)
        checks = ct2.checks
        // P21-3 fks tail.
        let fkt = boila_fks_dec_tail(sch, ct2.pos)
        fks = fkt.fks
        // P21-1 ixcols tail: full column list of multi-column indexes.
        let mut i5 = fkt.pos
        if i5 < vec_len(sch) {
            let nm = vec_get(sch, i5).i
            i5 = i5 + 1
            let mut k5: i64 = 0
            while k5 < nm && i5 + 1 < vec_len(sch) {
                let mid = vec_get(sch, i5).i
                let ncol = vec_get(sch, i5 + 1).i
                i5 = i5 + 2
                let mcols: Vec<i64> = vec_new()
                let mut ci: i64 = 0
                while ci < ncol && i5 < vec_len(sch) {
                    vec_push(mcols, vec_get(sch, i5).i)
                    i5 = i5 + 1
                    ci = ci + 1
                }
                let mut j5: i64 = 0
                while j5 < vec_len(ixs) {
                    if vec_get(ixs, j5).id == mid {
                        let om = vec_get(ixs, j5)
                        vec_set(ixs, j5, BoilaIxMeta { id: om.id, cols: mcols, name: om.name, uniq: om.uniq })
                    }
                    j5 = j5 + 1
                }
                k5 = k5 + 1
            }
        }
    }
    let tg = boila_ttl_get(s, id)?
    s = tg.s
    // buffer may override ttl
    return BoilaCatRes { s: s, ok: 1, err: "", state: "", table: BoilaTable { id: id, name: name, cols: cols, pk_idx: e1.i, ixs: ixs, ttl_sec: tg.ttl_sec, checks: checks, fks: fks }, id: id }
}

fn boila_cat_by_name(s: BoilaStore, name: str) -> BoilaCatRes !IO !Time !Par {
    return boila_cat_by_name_txn(s, boila_txn_new(), name)?
}

// T5: see uncommitted CREATE TABLE in same txn.
fn boila_cat_by_name_txn(s: BoilaStore, txn: BoilaTxn, name: str) -> BoilaCatRes !IO !Time !Par {
    let npk = boila_cat_pk_name(name)
    let mut name_row = bytes_new(0)
    let mut have_name = 0
    if txn.active == 1 {
        let bix = boila_txn_find(txn, boila_cf_sys(), 1, npk)
        if bix >= 0 {
            let w = vec_get(txn.writes, bix)
            if w.is_del == 1 {
                return BoilaCatRes { s: s, ok: 0, err: concat("таблица '", concat(name, "' не съществува")), state: "42P01", table: boila_cat_empty_table(), id: 0 }
            }
            name_row = w.row
            have_name = 1
        }
    }
    if have_name == 0 {
        let dn = boila_get(s, boila_cf_sys(), 1, npk)?
        s = dn.s
        if dn.found == 0 {
            return BoilaCatRes { s: s, ok: 0, err: concat("таблица '", concat(name, "' не съществува")), state: "42P01", table: boila_cat_empty_table(), id: 0 }
        }
        name_row = dn.val
    }
    let idrow = boila_row_dec(name_row)
    if vec_len(idrow) == 0 {
        return BoilaCatRes { s: s, ok: 0, err: "повреден каталог (name row)", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    }
    let id = vec_get(idrow, 0).i
    let spk = boila_cat_pk_schema(id)
    let mut sch_row = bytes_new(0)
    let mut have_sch = 0
    if txn.active == 1 {
        let six = boila_txn_find(txn, boila_cf_sys(), 1, spk)
        if six >= 0 {
            let w = vec_get(txn.writes, six)
            if w.is_del == 1 {
                return BoilaCatRes { s: s, ok: 0, err: concat("таблица '", concat(name, "' не съществува")), state: "42P01", table: boila_cat_empty_table(), id: 0 }
            }
            sch_row = w.row
            have_sch = 1
        }
    }
    if have_sch == 0 {
        let ds = boila_get(s, boila_cf_sys(), 1, spk)?
        s = ds.s
        if ds.found == 0 {
            return BoilaCatRes { s: s, ok: 0, err: "повреден каталог (липсва schema row)", state: "XX000", table: boila_cat_empty_table(), id: 0 }
        }
        sch_row = ds.val
    }
    // ttl override from buffer
    let mut res = boila_cat_decode_schema(s, name, id, sch_row)?
    if txn.active == 1 && res.ok == 1 {
        let tpk = boila_ttl_pk(id)
        let tix = boila_txn_find(txn, boila_cf_sys(), 1, tpk)
        if tix >= 0 {
            let w = vec_get(txn.writes, tix)
            if w.is_del == 1 {
                res.table.ttl_sec = 0
            } else {
                let tr = boila_row_dec(w.row)
                if vec_len(tr) > 0 {
                    res.table.ttl_sec = vec_get(tr, 0).i
                }
            }
        }
    }
    return res
}

// BoilaKeysRaw / boila_cf_keys_raw / boila_txn_keys_raw / boila_cf_wipe
// / boila_cat_drop moved to catalog/drop.baga at P20-2 (filesize §9).
