// secondary.baga — вторични индекси (P3 rev.2).
//
// Дефинициите живеят в schema row-а на таблицата (catalog/schema.baga) —
// зареждането е point GET, не scan (границата на rocksbaga SCAN snapshot-а,
// gaps K7). Каталог по име (за duplicate check): pk "x|<table_id>|<име>"
// → row [index_id, col_idx].
// Entries (index CF, table_id на таблицата):
//   pk част = [ix_id u32 BE][value enc][pk enc] → празна стойност
//
// K6: NULL се индексира (като PG). Lookup с null val → IS NULL path.
// K2b: lookup via boila_scan_pref(cf|table|ix|val) — no full CF page.

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "uniq.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaIxTxnRes {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    id: i64
}

struct BoilaIxLookup {
    s: BoilaStore,
    pks: Vec<bytes>
}

fn boila_ix_cat_pk(table_id: i64, name: str) -> bytes {
    return bytes_of_str(concat(concat(concat("x|", int_to_str(table_id)), "|"), name))
}

fn boila_ix_meta_pk() -> bytes {
    return bytes_of_str("m|next_ix")
}

// P21-1: конкатенирана encoding на индексните колони (една колона = 1 елемент).
fn boila_ix_vals_enc(vals: Vec<BoilaVal>) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(vals) {
        out = bytes_concat(out, boila_val_enc(vec_get(vals, i)))
        i = i + 1
    }
    return out
}

// Entry ключ за стойностите на индексираните колони.
fn boila_ix_entry_pk(ix_id: i64, vals: Vec<BoilaVal>, pk: bytes) -> bytes {
    let mut out = boila_enc_u32_be(ix_id)
    out = bytes_concat(out, boila_ix_vals_enc(vals))
    return bytes_concat(out, pk)
}

// Префикс за exact lookup по (ix_id, стойности).
fn boila_ix_lookup_prefix(ix_id: i64, vals: Vec<BoilaVal>) -> bytes {
    let mut out = boila_enc_u32_be(ix_id)
    return bytes_concat(out, boila_ix_vals_enc(vals))
}

// Index id по колона — чисто, без IO (дефинициите са в BoilaTable).
// P21-1: само едноколонни индекси (мултиколонните не обслужват WHERE eq).
fn boila_ix_by_col_t(t: BoilaTable, col_idx: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if vec_len(m.cols) == 1 && vec_get(m.cols, 0) == col_idx {
            return m.id
        }
        i = i + 1
    }
    return 0 - 1
}

// CREATE INDEX (P4): изцяло през txn buffer-а — каталог, schema rewrite,
// брояч и build entries се commit-ват атомно заедно (auto-txn в exec_sql).
// Build: pk списък през boila_txn_keys (storage + buffer), без писания
// по време на събирането. P20-1: uniq=1 → UNIQUE; build-ът отказва 23505
// при съществуващи дубликати (NULL-ите са distinct, PG).
fn boila_ix_create(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str, col_names: Vec<str>, uniq: i64) -> BoilaIxTxnRes !IO !Time !Par {
    // колоните съществуват ли (P21-1: многоколонен индекс)
    let cols: Vec<i64> = vec_new()
    let mut ci: i64 = 0
    while ci < vec_len(col_names) {
        let cname = vec_get(col_names, ci)
        let mut cidx: i64 = 0 - 1
        let mut j: i64 = 0
        while j < vec_len(t.cols) {
            if vec_get(t.cols, j).name == cname {
                cidx = j
            }
            j = j + 1
        }
        if cidx < 0 {
            return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(cname, "' не съществува")), state: "42703", id: 0 }
        }
        vec_push(cols, cidx)
        ci = ci + 1
    }
    if vec_len(cols) == 0 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: "CREATE INDEX без колона", state: "42601", id: 0 }
    }
    // дубликат по име (point GET)
    let g = boila_get(s, boila_cf_sys(), 1, boila_ix_cat_pk(t.id, ix_name))?
    s = g.s
    if g.found == 1 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("индекс '", concat(ix_name, "' вече съществува")), state: "42710", id: 0 }
    }
    // следващ id: първо в buffer-а (втори CREATE INDEX в същия txn)
    let mut next: i64 = 1
    let cix = boila_txn_find(txn, boila_cf_sys(), 1, boila_ix_meta_pk())
    if cix >= 0 {
        let w = vec_get(txn.writes, cix)
        let row = boila_row_dec(w.row)
        if vec_len(row) > 0 {
            next = vec_get(row, 0).i
        }
    } else {
        let g2 = boila_get(s, boila_cf_sys(), 1, boila_ix_meta_pk())?
        s = g2.s
        if g2.found == 1 {
            let row = boila_row_dec(g2.val)
            if vec_len(row) > 0 {
                next = vec_get(row, 0).i
            }
        }
    }
    let cnt: Vec<BoilaVal> = vec_new()
    vec_push(cnt, boila_val_i64(next + 1))
    let r1 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_ix_meta_pk(), boila_row_enc(cnt))
    if r1.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r1.txn, ok: 0, err: r1.err, state: r1.state, id: 0 }
    }
    txn = r1.txn
    // каталог по име (id + първата колона; DROP INDEX ползва само id)
    let cat: Vec<BoilaVal> = vec_new()
    vec_push(cat, boila_val_i64(next))
    vec_push(cat, boila_val_i64(vec_get(cols, 0)))
    let r2 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_ix_cat_pk(t.id, ix_name), boila_row_enc(cat))
    if r2.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r2.txn, ok: 0, err: r2.err, state: r2.state, id: 0 }
    }
    txn = r2.txn
    // schema rewrite: старите ixs + новият
    let newixs: Vec<BoilaIxMeta> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        vec_push(newixs, vec_get(t.ixs, i))
        i = i + 1
    }
    vec_push(newixs, BoilaIxMeta { id: next, cols: cols, name: ix_name, uniq: uniq })
    let t2 = BoilaTable { id: t.id, name: t.name, cols: t.cols, pk_idx: t.pk_idx, ixs: newixs, ttl_sec: t.ttl_sec, checks: t.checks, fks: t.fks }
    let r3 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r3.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r3.txn, ok: 0, err: r3.err, state: r3.state, id: 0 }
    }
    txn = r3.txn
    // build: събери pk-та (storage + buffer), после buffer-ирай entries
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let dup_entries: Vec<bytes> = vec_new()
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let pkenc = vec_get(ks.pks, ki)
        let g3 = boila_txn_get(s, txn, t.id, pkenc)?
        s = g3.s
        if g3.found == 1 {
            let row = boila_row_dec(g3.row)
            let vals: Vec<BoilaVal> = vec_new()
            let mut okc: i64 = 1
            let mut vi: i64 = 0
            while vi < vec_len(cols) {
                let cix2 = vec_get(cols, vi)
                if cix2 < vec_len(row) {
                    vec_push(vals, vec_get(row, cix2))
                } else {
                    okc = 0
                }
                vi = vi + 1
            }
            if okc == 1 {
                if uniq == 1 {
                    let mut allnn: i64 = 1
                    let mut vi2: i64 = 0
                    while vi2 < vec_len(vals) {
                        if vec_get(vals, vi2).tag == boila_v_null() {
                            allnn = 0
                        }
                        vi2 = vi2 + 1
                    }
                    if allnn == 1 {
                        vec_push(dup_entries, boila_uniq_entry_m(vals, pkenc))
                    }
                }
                let r4 = boila_txn_put(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(next, vals, pkenc), bytes_new(0))
                if r4.ok == 0 {
                    return BoilaIxTxnRes { s: s, txn: r4.txn, ok: 0, err: r4.err, state: r4.state, id: 0 }
                }
                txn = r4.txn
            }
        }
        ki = ki + 1
    }
    if uniq == 1 && boila_ix_build_has_dup(dup_entries) == 1 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("дублирани стойности при CREATE UNIQUE INDEX '", concat(ix_name, "'")), state: "23505", id: 0 }
    }
    return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: next }
}

// Писане/триене на entries за индексите на таблицата при DML —
// P4: през txn buffer-а (commit-ът е в exec_sql).
fn boila_ix_put_all_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>, pkenc: bytes) -> BoilaTxnRes {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        let vals: Vec<BoilaVal> = vec_new()
        let mut okc: i64 = 1
        let mut vi: i64 = 0
        while vi < vec_len(m.cols) {
            let cix = vec_get(m.cols, vi)
            if cix >= 0 && cix < vec_len(row) {
                vec_push(vals, vec_get(row, cix))
            } else {
                okc = 0
            }
            vi = vi + 1
        }
        if okc == 1 {
            let r = boila_txn_put(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(m.id, vals, pkenc), bytes_new(0))
            if r.ok == 0 {
                return r
            }
            txn = r.txn
        }
        i = i + 1
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

fn boila_ix_del_all_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>, pkenc: bytes) -> BoilaTxnRes {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        let vals: Vec<BoilaVal> = vec_new()
        let mut okc: i64 = 1
        let mut vi: i64 = 0
        while vi < vec_len(m.cols) {
            let cix = vec_get(m.cols, vi)
            if cix >= 0 && cix < vec_len(row) {
                vec_push(vals, vec_get(row, cix))
            } else {
                okc = 0
            }
            vi = vi + 1
        }
        if okc == 1 {
            let r = boila_txn_del(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(m.id, vals, pkenc))
            if r.ok == 0 {
                return r
            }
            txn = r.txn
        }
        i = i + 1
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

// Exact lookup: всички pk-та, чиято колона има тази стойност.
// K2b: scan only cf|table|ix_id|val prefix (not full table index CF).
fn boila_ix_lookup(s: BoilaStore, t: BoilaTable, ix_id: i64, val: BoilaVal) -> BoilaIxLookup !IO !Time !Par {
    let pks: Vec<bytes> = vec_new()
    let vals1: Vec<BoilaVal> = vec_new()
    vec_push(vals1, val)
    let pref = boila_ix_lookup_prefix(ix_id, vals1)
    let full_pref = boila_key_row(boila_cf_index(), t.id, pref)
    let plen = bytes_len(full_pref)
    let sa = boila_scan_pref_all(s, full_pref)?
    s = sa.s
    let mut j: i64 = 0
    while j < vec_len(sa.keys) {
        let k = vec_get(sa.keys, j)
        vec_push(pks, bytes_slice(k, plen, bytes_len(k)))
        j = j + 1
    }
    return BoilaIxLookup { s: s, pks: pks }
}
