// uniq.baga — UNIQUE index enforcement (P20-1).
//
// PG semantics: duplicate non-NULL value on a UNIQUE index → 23505.
// NULLs are distinct (multiple NULL rows allowed). The check merges
// storage (prefix scan) with the txn buffer: buffered puts/dels of
// data rows override committed index state seen by the scan.
// Build-time duplicate detection for CREATE UNIQUE INDEX: entries are
// sorted as [len(enc) u32 BE][enc][pk] — equal encodings group
// adjacent regardless of width (a separator-free trick: the length
// prefix keeps a short encoding from prefix-matching a longer one).

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_uniq_has_prefix(b: bytes, pre: bytes) -> i64 {
    if bytes_len(b) < bytes_len(pre) {
        return 0
    }
    let mut i: i64 = 0
    while i < bytes_len(pre) {
        if bytes_at(b, i) != bytes_at(pre, i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn boila_uniq_fail_msg(t: BoilaTable, m: BoilaIxMeta) -> str {
    let mut cn = ""
    let mut i: i64 = 0
    while i < vec_len(m.cols) {
        let cix = vec_get(m.cols, i)
        let mut nm = "?"
        if cix >= 0 && cix < vec_len(t.cols) {
            nm = vec_get(t.cols, cix).name
        }
        if i > 0 {
            cn = concat(cn, ", ")
        }
        cn = concat(cn, nm)
        i = i + 1
    }
    return concat(concat("дублирана стойност в UNIQUE индекс върху '", cn), "'")
}

// Entry key prefix for (ix_id, values) — same layout as secondary.baga
// boila_ix_entry_pk without the pk tail (P21-1 multi-column).
fn boila_uniq_pref(ix_id: i64, vals: Vec<BoilaVal>) -> bytes {
    let mut out = boila_enc_u32_be(ix_id)
    let mut i: i64 = 0
    while i < vec_len(vals) {
        out = bytes_concat(out, boila_val_enc(vec_get(vals, i)))
        i = i + 1
    }
    return out
}

// Storage candidates: pks whose committed index entry is (ix_id, v).
struct BoilaUniqCands {
    s: BoilaStore,
    pks: Vec<bytes>
}

fn boila_uniq_storage_cands(s: BoilaStore, t: BoilaTable, ix_id: i64, vals: Vec<BoilaVal>) -> BoilaUniqCands !IO !Time !Par {
    let pks: Vec<bytes> = vec_new()
    let full_pref = boila_key_row(boila_cf_index(), t.id, boila_uniq_pref(ix_id, vals))
    let plen = bytes_len(full_pref)
    let sa = boila_scan_pref_all(s, full_pref)?
    s = sa.s
    let mut j: i64 = 0
    while j < vec_len(sa.keys) {
        let k = vec_get(sa.keys, j)
        vec_push(pks, bytes_slice(k, plen, bytes_len(k)))
        j = j + 1
    }
    return BoilaUniqCands { s: s, pks: pks }
}

struct BoilaUniqHolds {
    s: BoilaStore,
    holds: i64
}

// P21-1: cand's live row must match ALL indexed values. boila_txn_get
// merges the txn buffer with versioned storage (unwraps the LSN shell),
// so deleted/updated candidates are seen correctly. The prefix scan can
// return var-width false positives, hence the full value verification.
fn boila_uniq_cand_holds(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, cand: bytes, cols: Vec<i64>, vals: Vec<BoilaVal>) -> BoilaUniqHolds !IO !Time !Par {
    let g = boila_txn_get(s, txn, t.id, cand)?
    s = g.s
    if g.found == 0 {
        return BoilaUniqHolds { s: s, holds: 0 }
    }
    let row = boila_row_dec(g.row)
    let mut k: i64 = 0
    while k < vec_len(cols) {
        let cix = vec_get(cols, k)
        if cix >= vec_len(row) {
            return BoilaUniqHolds { s: s, holds: 0 }
        }
        if boila_val_cmp(vec_get(row, cix), vec_get(vals, k)) != 0 {
            return BoilaUniqHolds { s: s, holds: 0 }
        }
        k = k + 1
    }
    return BoilaUniqHolds { s: s, holds: 1 }
}

// DML check: row (full decoded values) about to be written under pkenc.
// 23505 when another live row already holds the same values on any
// UNIQUE ix. P21-1: multi-column — all indexed values compared; a NULL
// in any indexed column means the row cannot collide (PG).
fn boila_ix_uniq_check_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>, pkenc: bytes) -> BoilaTxnRes !IO !Time !Par {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.uniq == 1 {
            let vals: Vec<BoilaVal> = vec_new()
            let mut okc: i64 = 1
            let mut anynull: i64 = 0
            let mut vi: i64 = 0
            while vi < vec_len(m.cols) {
                let cix = vec_get(m.cols, vi)
                if cix >= 0 && cix < vec_len(row) {
                    let vv = vec_get(row, cix)
                    vec_push(vals, vv)
                    if vv.tag == boila_v_null() {
                        anynull = 1
                    }
                } else {
                    okc = 0
                }
                vi = vi + 1
            }
            if okc == 1 && anynull == 0 {
                // committed candidates (prefix scan)
                let lc = boila_uniq_storage_cands(s, t, m.id, vals)?
                s = lc.s
                let mut j: i64 = 0
                while j < vec_len(lc.pks) {
                    let cand = vec_get(lc.pks, j)
                    if bytes_eq_b(cand, pkenc) == 0 {
                        let ch = boila_uniq_cand_holds(s, txn, t, cand, m.cols, vals)?
                        s = ch.s
                        if ch.holds == 1 {
                            return boila_txn_res(s, txn, 0, boila_uniq_fail_msg(t, m), "23505", 0)
                        }
                    }
                    j = j + 1
                }
                // buffered candidates (entries written in this txn)
                let pref = boila_uniq_pref(m.id, vals)
                let plen = bytes_len(pref)
                let mut k: i64 = 0
                while k < vec_len(txn.writes) {
                    let w = vec_get(txn.writes, k)
                    if w.cf == boila_cf_index() && w.table_id == t.id && w.is_del == 0 && bytes_len(w.pk) > plen && boila_uniq_has_prefix(w.pk, pref) == 1 {
                        let cand = bytes_slice(w.pk, plen, bytes_len(w.pk))
                        if bytes_eq_b(cand, pkenc) == 0 {
                            let ch = boila_uniq_cand_holds(s, txn, t, cand, m.cols, vals)?
                            s = ch.s
                            if ch.holds == 1 {
                                return boila_txn_res(s, txn, 0, boila_uniq_fail_msg(t, m), "23505", 0)
                            }
                        }
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

// --- CREATE UNIQUE INDEX build: duplicate detection over (val, pk) ---

fn boila_uniq_entry(v: BoilaVal, pk: bytes) -> bytes {
    let enc = boila_val_enc(v)
    let mut out = boila_enc_u32_be(bytes_len(enc))
    out = bytes_concat(out, enc)
    return bytes_concat(out, pk)
}

// P21-1: multi-column build-dup entry — enc is the concatenated column
// encodings; equal tuples group adjacent after the sort.
fn boila_uniq_entry_m(vals: Vec<BoilaVal>, pk: bytes) -> bytes {
    let mut enc = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(vals) {
        enc = bytes_concat(enc, boila_val_enc(vec_get(vals, i)))
        i = i + 1
    }
    let mut out = boila_enc_u32_be(bytes_len(enc))
    out = bytes_concat(out, enc)
    return bytes_concat(out, pk)
}

fn boila_uniq_qs_ins(es: Vec<bytes>, lo: i64, hi: i64) {
    let mut i: i64 = lo + 1
    while i <= hi {
        let key = vec_get(es, i)
        let mut j = i - 1
        while j >= lo && boila_bytes_cmp(vec_get(es, j), key) > 0 {
            vec_set(es, j + 1, vec_get(es, j))
            j = j - 1
        }
        vec_set(es, j + 1, key)
        i = i + 1
    }
}

fn boila_uniq_qs_part(es: Vec<bytes>, lo: i64, hi: i64) -> i64 {
    let pivot = vec_get(es, lo + (hi - lo) / 2)
    let mut i = lo - 1
    let mut j = hi + 1
    let go = true
    while go {
        i = i + 1
        while boila_bytes_cmp(vec_get(es, i), pivot) < 0 {
            i = i + 1
        }
        j = j - 1
        while boila_bytes_cmp(vec_get(es, j), pivot) > 0 {
            j = j - 1
        }
        if i >= j {
            return j
        }
        let tmp = vec_get(es, i)
        vec_set(es, i, vec_get(es, j))
        vec_set(es, j, tmp)
    }
    return j
}

fn boila_uniq_qs(es: Vec<bytes>, lo: i64, hi: i64) {
    if hi - lo < 12 {
        boila_uniq_qs_ins(es, lo, hi)
        return
    }
    let p = boila_uniq_qs_part(es, lo, hi)
    boila_uniq_qs(es, lo, p)
    boila_uniq_qs(es, p + 1, hi)
}

// entries: boila_uniq_entry(val, pk) for every non-NULL val. Returns 1
// when two distinct pks share a value.
fn boila_ix_build_has_dup(entries: Vec<bytes>) -> i64 {
    let n = vec_len(entries)
    if n < 2 {
        return 0
    }
    boila_uniq_qs(entries, 0, n - 1)
    let mut i: i64 = 1
    while i < n {
        let a = vec_get(entries, i - 1)
        let b = vec_get(entries, i)
        if bytes_len(a) >= 4 && bytes_len(b) >= 4 {
            let la = boila_dec_u32_be(a, 0)
            let lb = boila_dec_u32_be(b, 0)
            if la == lb && bytes_len(a) >= 4 + la && bytes_len(b) >= 4 + la {
                if boila_bytes_cmp(bytes_slice(a, 4, 4 + la), bytes_slice(b, 4, 4 + la)) == 0 {
                    return 1
                }
            }
        }
        i = i + 1
    }
    return 0
}
