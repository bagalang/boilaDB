// exec_copy_fmt.baga — P14 text/csv cell codec (PG COPY text + RFC CSV).
import "../core/value.baga"
import "../core/numeric.baga"
import "../core/row.baga"
import "csvbaga/csv.baga"
import "std/str/str.baga"

fn boila_copy_is_null_tok(s: str) -> i64 {
    if s == "\\N" { return 1 }
    return 0
}

fn boila_copy_unescape(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i: i64 = 0
    while i < n {
        let c = char_at(s, i)
        if c == 92 && i + 1 < n {
            let n2 = char_at(s, i + 1)
            if n2 == 110 { out = concat(out, "\n"); i = i + 2 }
            else {
                if n2 == 116 { out = concat(out, "\t"); i = i + 2 }
                else {
                    if n2 == 114 { out = concat(out, "\r"); i = i + 2 }
                    else {
                        if n2 == 92 { out = concat(out, "\\"); i = i + 2 }
                        else { out = concat(out, chr(n2)); i = i + 2 }
                    }
                }
            }
        } else {
            out = concat(out, chr(c))
            i = i + 1
        }
    }
    return out
}

fn boila_copy_escape(s: str) -> str {
    let n = len(s)
    let mut out = ""
    let mut i: i64 = 0
    while i < n {
        let c = char_at(s, i)
        if c == 92 { out = concat(out, "\\\\") }
        else {
            if c == 9 { out = concat(out, "\\t") }
            else {
                if c == 10 { out = concat(out, "\\n") }
                else {
                    if c == 13 { out = concat(out, "\\r") }
                    else { out = concat(out, chr(c)) }
                }
            }
        }
        i = i + 1
    }
    return out
}

fn boila_copy_val_text(v: BoilaVal) -> str {
    if v.tag == boila_v_null() { return "\\N" }
    if v.tag == boila_v_bool() {
        if (v.i & 1) == 1 { return "t" }
        return "f"
    }
    if v.tag == boila_v_i64() || v.tag == boila_v_ts() {
        return int_to_str(v.i)
    }
    if v.tag == boila_v_num() {
        return boila_num_to_string(v.b)
    }
    if v.tag == boila_v_str() || v.tag == boila_v_json() {
        return boila_copy_escape(str_of_bytes(v.b))
    }
    return boila_copy_escape(boila_val_json_lit(v))
}

fn boila_copy_parse_bool(s: str) -> i64 {
    if s == "t" || s == "true" || s == "1" { return 1 }
    if s == "f" || s == "false" || s == "0" { return 0 }
    return 0 - 1
}

fn boila_copy_cell_val(typ: i64, raw: str) -> BoilaVal {
    if boila_copy_is_null_tok(raw) == 1 {
        return boila_val_null()
    }
    let s = boila_copy_unescape(raw)
    if typ == boila_v_bool() {
        let b = boila_copy_parse_bool(s)
        if b < 0 { return boila_val_str(s) }
        return boila_val_bool(b)
    }
    if typ == boila_v_i64() || typ == boila_v_ts() {
        return boila_val_i64(parse_int(s))
    }
    if typ == boila_v_num() {
        return boila_val_str(s)
    }
    return boila_val_str(s)
}

fn boila_copy_split_text(line: str) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let n = len(line)
    let mut i: i64 = 0
    let mut field = ""
    while i < n {
        let c = char_at(line, i)
        if c == 92 && i + 1 < n {
            field = concat(field, chr(c))
            field = concat(field, chr(char_at(line, i + 1)))
            i = i + 2
        } else {
            if c == 9 {
                vec_push(out, field)
                field = ""
                i = i + 1
            } else {
                field = concat(field, chr(c))
                i = i + 1
            }
        }
    }
    vec_push(out, field)
    return out
}

fn boila_copy_join_text(fields: Vec<str>) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < vec_len(fields) {
        if i > 0 { out = concat(out, "\t") }
        out = concat(out, vec_get(fields, i))
        i = i + 1
    }
    return out
}

fn boila_copy_join_csv(fields: Vec<str>) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < vec_len(fields) {
        if i > 0 { out = concat(out, ",") }
        out = concat(out, csv_escape_field(vec_get(fields, i)))
        i = i + 1
    }
    return out
}
