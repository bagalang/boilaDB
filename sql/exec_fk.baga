// exec_fk.baga — P21-3 foreign-key enforcement.
// Child side: INSERT/UPDATE verify the referenced parent row exists
// (23503 when missing). Parent side: DELETE applies each referencing
// child FK's ON DELETE action (RESTRICT/NO ACTION → 23503, CASCADE →
// delete child rows, SET NULL → null the child FK column).
// Cascade is single-level (child rows that are themselves parents are
// not recursed); child-row modal sync (fts/hnsw/graph) is skipped.

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../catalog/drop.baga"
import "../txn/mvcc.baga"
import "../index/secondary.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_agg_extra.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaFkRes {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str
}

fn boila_fk_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaFkRes {
    return BoilaFkRes { s: s, txn: txn, ok: 0, err: msg, state: state }
}

fn boila_fk_col_idx(t: BoilaTable, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Child side: every FK value in row must exist in the parent table.
fn boila_fk_enforce_row(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>) -> BoilaFkRes !IO !Time !Par {
    let mut i: i64 = 0
    while i < vec_len(t.fks) {
        let fk = vec_get(t.fks, i)
        if fk.col_idx < vec_len(row) {
            let val = vec_get(row, fk.col_idx)
            if val.tag != boila_v_null() {
                let pc = boila_cat_by_name_txn(s, txn, fk.parent_table)?
                s = pc.s
                if pc.ok == 0 {
                    return boila_fk_fail(s, txn, concat("FK родителска таблица '", concat(fk.parent_table, "' не съществува")), "42P01")
                }
                let pt = pc.table
                let pcix = boila_fk_col_idx(pt, fk.parent_col)
                if pcix < 0 {
                    return boila_fk_fail(s, txn, concat("FK родителска колона '", concat(fk.parent_col, "' не съществува")), "42703")
                }
                let f = boila_fetch_all(s, txn, pt)?
                s = f.s
                txn = f.txn
                if f.ok == 0 {
                    return boila_fk_fail(s, txn, f.err, f.state)
                }
                let mut found: i64 = 0
                let mut r: i64 = 0
                while r < vec_len(f.rows) && found == 0 {
                    let pr = vec_get(f.rows, r)
                    if pcix < vec_len(pr) && boila_val_cmp(vec_get(pr, pcix), val) == 0 {
                        found = 1
                    }
                    r = r + 1
                }
                if found == 0 {
                    return boila_fk_fail(s, txn, concat("нарушен foreign key към '", concat(fk.parent_table, "' (редът не съществува)")), "23503")
                }
            }
        }
        i = i + 1
    }
    return BoilaFkRes { s: s, txn: txn, ok: 1, err: "", state: "" }
}

// Enumerate all table names from the "n|" sys keys (storage + txn buffer).
struct BoilaFkNames {
    s: BoilaStore,
    names: Vec<str>
}

fn boila_fk_table_names(s: BoilaStore, txn: BoilaTxn) -> BoilaFkNames !IO !Time !Par {
    let names: Vec<str> = vec_new()
    let ks = boila_cf_keys_raw(s, boila_cf_sys(), 1)?
    s = ks.s
    let mut i: i64 = 0
    while i < vec_len(ks.pks) {
        let k = vec_get(ks.pks, i)
        if bytes_len(k) > 2 && bytes_at(k, 0) == 110 && bytes_at(k, 1) == 124 {
            let nm = str_of_bytes(bytes_slice(k, 2, bytes_len(k)))
            if nm != "" {
                let mut have: i64 = 0
                let mut j: i64 = 0
                while j < vec_len(names) {
                    if vec_get(names, j) == nm {
                        have = 1
                    }
                    j = j + 1
                }
                if have == 0 {
                    vec_push(names, nm)
                }
            }
        }
        i = i + 1
    }
    return BoilaFkNames { s: s, names: names }
}

// Parent side: apply child FK ON DELETE actions for rows being deleted
// from table t.
fn boila_fk_handle_parent_delete(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, del_rows: Vec<Vec<BoilaVal>>) -> BoilaFkRes !IO !Time !Par {
    if vec_len(del_rows) == 0 {
        return BoilaFkRes { s: s, txn: txn, ok: 1, err: "", state: "" }
    }
    let tn = boila_fk_table_names(s, txn)?
    s = tn.s
    let mut ni: i64 = 0
    while ni < vec_len(tn.names) {
        let cnm = vec_get(tn.names, ni)
        if cnm != t.name {
            let cc = boila_cat_by_name_txn(s, txn, cnm)?
            s = cc.s
            if cc.ok == 1 {
                let ct = cc.table
                let mut fi: i64 = 0
                while fi < vec_len(ct.fks) {
                    let fk = vec_get(ct.fks, fi)
                    if fk.parent_table == t.name {
                        let pcol_idx = boila_fk_col_idx(t, fk.parent_col)
                        if pcol_idx >= 0 {
                            // Set of deleted reference values (linear lookup).
                            let delset: Map<str, i64> = map_new()
                            let mut d: i64 = 0
                            while d < vec_len(del_rows) {
                                let drow = vec_get(del_rows, d)
                                if pcol_idx < vec_len(drow) {
                                    let dv = vec_get(drow, pcol_idx)
                                    if dv.tag != boila_v_null() {
                                        map_set(delset, boila_bytes_hex(boila_val_enc(dv)), 1)
                                    }
                                }
                                d = d + 1
                            }
                            let cf = boila_fetch_all(s, txn, ct)?
                            s = cf.s
                            txn = cf.txn
                            if cf.ok == 0 {
                                return boila_fk_fail(s, txn, cf.err, cf.state)
                            }
                            let mut r: i64 = 0
                            while r < vec_len(cf.rows) {
                                let crow = vec_get(cf.rows, r)
                                if fk.col_idx < vec_len(crow) {
                                    let cv = vec_get(crow, fk.col_idx)
                                    if cv.tag != boila_v_null() && map_has(delset, boila_bytes_hex(boila_val_enc(cv))) == 1 {
                                        if fk.on_delete == 0 {
                                            return boila_fk_fail(s, txn, concat("нарушен foreign key: таблица '", concat(ct.name, "' реферира изтрит ред")), "23503")
                                        }
                                        if ct.pk_idx >= 0 && ct.pk_idx < vec_len(crow) {
                                            let cpk = boila_val_enc(vec_get(crow, ct.pk_idx))
                                            if fk.on_delete == 1 {
                                                let xd = boila_ix_del_all_txn(s, txn, ct, crow, cpk)
                                                if xd.ok == 0 {
                                                    return boila_fk_fail(s, txn, xd.err, xd.state)
                                                }
                                                txn = xd.txn
                                                let rd = boila_txn_del(s, txn, boila_cf_data(), ct.id, cpk)
                                                if rd.ok == 0 {
                                                    return boila_fk_fail(s, txn, rd.err, rd.state)
                                                }
                                                txn = rd.txn
                                            } else {
                                                if fk.on_delete == 2 {
                                                    let newrow: Vec<BoilaVal> = vec_new()
                                                    let mut c2: i64 = 0
                                                    while c2 < vec_len(crow) {
                                                        if c2 == fk.col_idx {
                                                            vec_push(newrow, boila_val_null())
                                                        } else {
                                                            vec_push(newrow, vec_get(crow, c2))
                                                        }
                                                        c2 = c2 + 1
                                                    }
                                                    let xd2 = boila_ix_del_all_txn(s, txn, ct, crow, cpk)
                                                    if xd2.ok == 0 {
                                                        return boila_fk_fail(s, txn, xd2.err, xd2.state)
                                                    }
                                                    txn = xd2.txn
                                                    let rp = boila_txn_put(s, txn, boila_cf_data(), ct.id, cpk, boila_row_enc(newrow))
                                                    if rp.ok == 0 {
                                                        return boila_fk_fail(s, txn, rp.err, rp.state)
                                                    }
                                                    txn = rp.txn
                                                    let xi = boila_ix_put_all_txn(s, txn, ct, newrow, cpk)
                                                    if xi.ok == 0 {
                                                        return boila_fk_fail(s, txn, xi.err, xi.state)
                                                    }
                                                    txn = xi.txn
                                                }
                                            }
                                        }
                                    }
                                }
                                r = r + 1
                            }
                        }
                    }
                    fi = fi + 1
                }
            }
        }
        ni = ni + 1
    }
    return BoilaFkRes { s: s, txn: txn, ok: 1, err: "", state: "" }
}
