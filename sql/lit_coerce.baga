// lit_coerce.baga — PG unknown-literal семантика за параметри/литерали.
// Параметрите по PG wire идват като текст без деклариран тип; pgwire ги
// замества като литерали (pgw_subst_params) и числовите низове стават
// INTEGER литерали. PostgreSQL разрешава unknown литералите според типа на
// колоната — boilaDB прави същото: коерция str↔i64/num на границата на
// типовата проверка (INSERT/UPDATE SET/WHERE/PK/index lookup).

import "../core/value.baga"
import "../core/numeric.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// Строг целочислен низ (водещ '-' по избор): кандидат за '123' → BIGINT.
fn boila_str_is_i64(s: str) -> i64 {
    let n = len(s)
    if n == 0 {
        return 0
    }
    let mut i: i64 = 0
    if char_at(s, 0) == 45 {
        if n == 1 {
            return 0
        }
        i = 1
    }
    while i < n {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Коерция на unknown литерал/параметър към типа на колоната; невъзможно →
// връща v непроменен (валидацията ще го отхвърли). Използва се преди
// типовата проверка на INSERT/UPDATE SET/WHERE/PK/index lookup/IN.
// Резултатите от изрази (SET col = <expr>) НЕ минават оттук — те остават
// строго типизирани по PG семантика.
fn boila_lit_coerce(typ: i64, v: BoilaVal) -> BoilaVal {
    if v.tag == boila_v_null() || boila_is_param(v) == 1 {
        return v
    }
    if typ == boila_v_i64() && v.tag == boila_v_str() {
        let s = str_of_bytes(v.b)
        if boila_str_is_i64(s) == 1 {
            return boila_val_i64(parse_int(s))
        }
        return v
    }
    if typ == boila_v_str() {
        if v.tag == boila_v_i64() {
            return boila_val_str(int_to_str(v.i))
        }
        if v.tag == boila_v_num() {
            return boila_val_str(boila_num_to_string(v.b))
        }
        return v
    }
    if typ == boila_v_num() {
        if v.tag == boila_v_num() {
            return v
        }
        if v.tag == boila_v_i64() {
            return boila_val_num_bytes(boila_num_pack(boila_num_from_i64(v.i)))
        }
        if v.tag == boila_v_str() {
            let p = boila_num_parse(str_of_bytes(v.b))
            if p.ok == 1 {
                return boila_val_num_bytes(boila_num_pack(p.value))
            }
        }
        return v
    }
    return v
}
