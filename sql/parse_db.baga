// parse_db.baga — CREATE/DROP DATABASE, USE, DROP TABLE, TRUNCATE
// parsers (P2; split out of parse_ddl.baga at P20-3, filesize §9).

import "token.baga"
import "lexer.baga"
import "parse_ddl.baga"
import "std/str/str.baga"

struct BoilaParseDb {
    ok: i64,
    name: str,
    if_exists: i64,
    err: str,
    state: str
}

fn boila_pdb_fail(msg: str, state: str) -> BoilaParseDb {
    return BoilaParseDb { ok: 0, name: "", if_exists: 0, err: msg, state: state }
}

fn boila_pdb_ok(name: str, if_ex: i64) -> BoilaParseDb {
    return BoilaParseDb { ok: 1, name: name, if_exists: if_ex, err: "", state: "" }
}

// CREATE DATABASE [IF NOT EXISTS] ident [;] — if_exists flag = IF NOT EXISTS
fn boila_parse_create_db(l: BoilaLex) -> BoilaParseDb {
    let mut i: i64 = 2
    let mut ifne: i64 = 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 {
        if tok_kw(boila_pc_tok(l, i + 1), "not") != 1 || tok_kw(boila_pc_tok(l, i + 2), "exists") != 1 {
            return boila_pdb_fail("очаквах IF NOT EXISTS", "42601")
        }
        ifne = 1
        i = i + 3
    }
    let t = boila_pc_tok(l, i)
    if t.kind != tok_ident() {
        return boila_pdb_fail("очаквах име на база след CREATE DATABASE", "42601")
    }
    let nx = boila_pc_tok(l, i + 1)
    if nx.kind == tok_semi() && boila_pc_tok(l, i + 2).kind == tok_eof() {
        return boila_pdb_ok(t.txt, ifne)
    }
    if nx.kind != tok_eof() {
        return boila_pdb_fail(concat("неочакван токен '", concat(nx.txt, "' след CREATE DATABASE")), "0A000")
    }
    return boila_pdb_ok(t.txt, ifne)
}

// DROP DATABASE [IF EXISTS] ident [;]
fn boila_parse_drop_db(l: BoilaLex) -> BoilaParseDb {
    let mut i: i64 = 2
    let mut if_ex: i64 = 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 {
        if tok_kw(boila_pc_tok(l, i + 1), "exists") != 1 {
            return boila_pdb_fail("очаквах EXISTS след IF", "42601")
        }
        if_ex = 1
        i = i + 2
    }
    let t = boila_pc_tok(l, i)
    if t.kind != tok_ident() {
        return boila_pdb_fail("очаквах име на база след DROP DATABASE", "42601")
    }
    let nx = boila_pc_tok(l, i + 1)
    if nx.kind == tok_semi() && boila_pc_tok(l, i + 2).kind == tok_eof() {
        return boila_pdb_ok(t.txt, if_ex)
    }
    if nx.kind != tok_eof() {
        return boila_pdb_fail(concat("неочакван токен '", concat(nx.txt, "' след DROP DATABASE")), "0A000")
    }
    return boila_pdb_ok(t.txt, if_ex)
}

// USE ident [;]
fn boila_parse_use(l: BoilaLex) -> BoilaParseDb {
    let t = boila_pc_tok(l, 1)
    if t.kind != tok_ident() {
        return boila_pdb_fail("очаквах име на база след USE", "42601")
    }
    let nx = boila_pc_tok(l, 2)
    if nx.kind == tok_semi() && boila_pc_tok(l, 3).kind == tok_eof() {
        return boila_pdb_ok(t.txt, 0)
    }
    if nx.kind != tok_eof() {
        return boila_pdb_fail(concat("неочакван токен '", concat(nx.txt, "' след USE")), "0A000")
    }
    return boila_pdb_ok(t.txt, 0)
}

// DROP TABLE [IF EXISTS] ident [;]
fn boila_parse_drop_table(l: BoilaLex) -> BoilaParseDb {
    let mut i: i64 = 2
    let mut if_ex: i64 = 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 {
        if tok_kw(boila_pc_tok(l, i + 1), "exists") != 1 {
            return boila_pdb_fail("очаквах EXISTS след IF", "42601")
        }
        if_ex = 1
        i = i + 2
    }
    let t = boila_pc_tok(l, i)
    if t.kind != tok_ident() {
        return boila_pdb_fail("очаквах име на таблица след DROP TABLE", "42601")
    }
    let nx = boila_pc_tok(l, i + 1)
    if nx.kind == tok_semi() && boila_pc_tok(l, i + 2).kind == tok_eof() {
        return boila_pdb_ok(t.txt, if_ex)
    }
    if nx.kind != tok_eof() {
        return boila_pdb_fail(concat("неочакван токен '", concat(nx.txt, "' след DROP TABLE")), "0A000")
    }
    return boila_pdb_ok(t.txt, if_ex)
}

// TRUNCATE [TABLE] [IF EXISTS] ident [;]
fn boila_parse_truncate(l: BoilaLex) -> BoilaParseDb {
    if tok_kw(boila_pc_tok(l, 0), "truncate") != 1 {
        return boila_pdb_fail("очаквах TRUNCATE", "42601")
    }
    let mut i: i64 = 1
    if tok_kw(boila_pc_tok(l, i), "table") == 1 {
        i = i + 1
    }
    let mut if_ex: i64 = 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 {
        if tok_kw(boila_pc_tok(l, i + 1), "exists") != 1 {
            return boila_pdb_fail("очаквах EXISTS след IF", "42601")
        }
        if_ex = 1
        i = i + 2
    }
    let t = boila_pc_tok(l, i)
    if t.kind != tok_ident() {
        return boila_pdb_fail("очаквах име на таблица след TRUNCATE", "42601")
    }
    let nx = boila_pc_tok(l, i + 1)
    if nx.kind == tok_semi() && boila_pc_tok(l, i + 2).kind == tok_eof() {
        return boila_pdb_ok(t.txt, if_ex)
    }
    if nx.kind != tok_eof() {
        return boila_pdb_fail(concat("неочакван токен '", concat(nx.txt, "' след TRUNCATE")), "42601")
    }
    return boila_pdb_ok(t.txt, if_ex)
}
