// parse_ddl.baga — parser за CREATE TABLE (P1).
// Граматика:
//   CREATE TABLE ident ( coldef (, coldef)* [, PRIMARY KEY (ident)] ) [;]
//   coldef := ident typ [NOT NULL] [DEFAULT lit|now()]  (P20-2)
//   typ := BIGINT | BOOL | TEXT | BYTEA | JSONB | TIMESTAMPTZ | NUMERIC | DECIMAL
//
// PRIMARY KEY е задължителен (LSM-friendly, ARCHITECTURE.md §5).
// Грешки: 42601 syntax_error; 0A000 feature_not_supported (непознат тип).

import "token.baga"
import "ast.baga"
import "../core/value.baga"
import "../vector/distance.baga"
import "../catalog/ddl_types.baga"
import "parse_colcon.baga"
import "std/str/str.baga"

struct BoilaParseCreate {
    ok: i64,
    create: BoilaCreate,
    if_not_exists: i64,
    err: str,
    state: str
}

fn boila_pc_fail(msg: str, state: str) -> BoilaParseCreate {
    return BoilaParseCreate { ok: 0, create: boila_create_empty(), if_not_exists: 0, err: msg, state: state }
}

fn boila_pc_tok(l: BoilaLex, i: i64) -> Token {
    if i < vec_len(l.toks) {
        return vec_get(l.toks, i)
    }
    return token_new(tok_eof(), "")
}

// typ → value tag / VECTOR pack; -1 ако не е в подмножеството.
// VECTOR(n) се парсва отделно (има '(').
fn boila_type_of(name: str) -> i64 {
    if name == "bigint" || name == "int8" {
        return boila_v_i64()
    }
    if name == "bool" || name == "boolean" {
        return boila_v_bool()
    }
    if name == "text" {
        return boila_v_str()
    }
    if name == "bytea" {
        return boila_v_bytes()
    }
    if name == "jsonb" {
        return boila_v_json()
    }
    if name == "timestamptz" {
        return boila_v_ts()
    }
    if name == "numeric" || name == "decimal" {
        return boila_v_num()
    }
    return 0 - 1
}

fn boila_parse_create(l: BoilaLex) -> BoilaParseCreate {
    // toks: CREATE TABLE [IF NOT EXISTS] ident ( ... )
    let mut i0: i64 = 2
    let mut ifne: i64 = 0
    if tok_kw(boila_pc_tok(l, 2), "if") == 1 {
        if tok_kw(boila_pc_tok(l, 3), "not") != 1 || tok_kw(boila_pc_tok(l, 4), "exists") != 1 {
            return boila_pc_fail("очаквах IF NOT EXISTS", "42601")
        }
        ifne = 1
        i0 = 5
    }
    let tn = boila_pc_tok(l, i0)
    if tn.kind != tok_ident() {
        return boila_pc_fail("очаквах име на таблица след CREATE TABLE", "42601")
    }
    let mut cr = boila_create_empty()
    cr.table = tn.txt
    if boila_pc_tok(l, i0 + 1).kind != tok_lparen() {
        return boila_pc_fail("очаквах '(' след името на таблицата", "42601")
    }
    let mut i: i64 = i0 + 2
    let mut depth_ok = true
    while depth_ok {
        // PRIMARY KEY (col) като последен елемент
        if tok_kw(boila_pc_tok(l, i), "primary") == 1 {
            if tok_kw(boila_pc_tok(l, i + 1), "key") != 1 {
                return boila_pc_fail("очаквах KEY след PRIMARY", "42601")
            }
            if boila_pc_tok(l, i + 2).kind != tok_lparen() {
                return boila_pc_fail("очаквах '(' след PRIMARY KEY", "42601")
            }
            let pkc = boila_pc_tok(l, i + 3)
            if pkc.kind != tok_ident() {
                return boila_pc_fail("очаквах колона в PRIMARY KEY", "42601")
            }
            if boila_pc_tok(l, i + 4).kind != tok_rparen() {
                return boila_pc_fail("очаквах ')' след PRIMARY KEY (col", "42601")
            }
            let mut found: i64 = 0 - 1
            let mut j: i64 = 0
            while j < vec_len(cr.cols) {
                let cd = vec_get(cr.cols, j)
                if cd.name == pkc.txt {
                    found = j
                }
                j = j + 1
            }
            if found < 0 {
                return boila_pc_fail(concat("PRIMARY KEY колоната '", concat(pkc.txt, "' не е дефинирана")), "42601")
            }
            cr.pk_idx = found
            i = i + 5
            let nx = boila_pc_tok(l, i)
            if nx.kind == tok_comma() {
                i = i + 1
            } else {
                if nx.kind != tok_rparen() {
                    return boila_pc_fail(concat("очаквах ')' или ',', получих '", concat(nx.txt, "'")), "42601")
                }
                depth_ok = false
            }
        } else {
            // coldef := ident typ
            let cn = boila_pc_tok(l, i)
            if cn.kind == tok_rparen() && vec_len(cr.cols) > 0 {
                depth_ok = false
            } else {
                if cn.kind != tok_ident() {
                    return boila_pc_fail(concat("очаквах име на колона, получих '", concat(cn.txt, "'")), "42601")
                }
                let ct = boila_pc_tok(l, i + 1)
                if ct.kind != tok_ident() {
                    return boila_pc_fail(concat("очаквах тип за колона '", concat(cn.txt, "'")), "42601")
                }
                let mut typ = boila_type_of(ct.txt)
                let mut tadv: i64 = 2
                // P20-3: SERIAL / BIGSERIAL = i64 + auto-number flag
                let mut cauto: i64 = 0
                if ct.txt == "serial" || ct.txt == "bigserial" {
                    typ = boila_v_i64()
                    cauto = 1
                }
                if ct.txt == "vector" {
                    // VECTOR ( n )
                    if boila_pc_tok(l, i + 2).kind != tok_lparen() {
                        return boila_pc_fail("очаквах '(' след VECTOR", "42601")
                    }
                    let dn = boila_pc_tok(l, i + 3)
                    if dn.kind != tok_num() {
                        return boila_pc_fail("очаквах dim в VECTOR(n)", "42601")
                    }
                    let dim = parse_int(dn.txt)
                    if dim <= 0 || dim > 4096 {
                        return boila_pc_fail("VECTOR dim извън 1..4096", "0A000")
                    }
                    if boila_pc_tok(l, i + 4).kind != tok_rparen() {
                        return boila_pc_fail("очаквах ')' след VECTOR(n", "42601")
                    }
                    typ = boila_vec_typ(dim)
                    tadv = 5
                }
                if typ < 0 {
                    return boila_pc_fail(concat("типът '", concat(ct.txt, "' не е в подмножеството")), "0A000")
                }
                let mut dup: i64 = 0
                let mut j: i64 = 0
                while j < vec_len(cr.cols) {
                    let cd = vec_get(cr.cols, j)
                    if cd.name == cn.txt {
                        dup = 1
                    }
                    j = j + 1
                }
                if dup == 1 {
                    return boila_pc_fail(concat("дублирана колона '", concat(cn.txt, "'")), "42701")
                }
                i = i + tadv
                // P20-2: column constraints NOT NULL / DEFAULT (any order)
                let mut cc = boila_parse_col_cons(l, i, cn.txt, typ)
                if cc.ok == 0 {
                    return boila_pc_fail(cc.err, cc.state)
                }
                i = i + cc.advance
                if cauto == 1 {
                    if (cc.flags & boila_cfl_hasdef()) == boila_cfl_hasdef() || (cc.flags & boila_cfl_defnow()) == boila_cfl_defnow() {
                        return boila_pc_fail(concat("SERIAL колоната '", concat(cn.txt, "' не приема DEFAULT")), "42601")
                    }
                    cc.flags = cc.flags + boila_cfl_auto()
                }
                vec_push(cr.cols, boila_coldef_c(cn.txt, typ, cc.flags, cc.def))
                let nx = boila_pc_tok(l, i)
                if nx.kind == tok_comma() {
                    i = i + 1
                } else {
                    if nx.kind != tok_rparen() {
                        return boila_pc_fail(concat("очаквах ')' или ',', получих '", concat(nx.txt, "'")), "42601")
                    }
                    depth_ok = false
                }
            }
        }
        if boila_pc_tok(l, i).kind == tok_eof() && depth_ok {
            return boila_pc_fail("незатворен CREATE TABLE", "42601")
        }
    }
    i = i + 1
    if vec_len(cr.cols) == 0 {
        return boila_pc_fail("таблица без колони", "42601")
    }
    if cr.pk_idx < 0 {
        return boila_pc_fail("PRIMARY KEY е задължителен (LSM-friendly)", "0A000")
    }
    // P20-3: SERIAL колоната е само PK (авто-номерацията е по pk слота)
    let mut ai: i64 = 0
    while ai < vec_len(cr.cols) {
        let cd = vec_get(cr.cols, ai)
        if (cd.flags & boila_cfl_auto()) == boila_cfl_auto() && ai != cr.pk_idx {
            return boila_pc_fail(concat("SERIAL колоната '", concat(cd.name, "' трябва да е PRIMARY KEY")), "0A000")
        }
        ai = ai + 1
    }
    // P9/S8: WITH (ttl_days=N | ttl_sec=N); ttl_sec is boila extension
    if tok_kw(boila_pc_tok(l, i), "with") == 1 {
        if boila_pc_tok(l, i + 1).kind != tok_lparen() {
            return boila_pc_fail("очаквах '(' след WITH", "42601")
        }
        let mut wi = i + 2
        let mut more_w = true
        while more_w {
            let kn = boila_pc_tok(l, wi)
            if kn.kind != tok_ident() {
                return boila_pc_fail("очаквах опция в WITH (...)", "42601")
            }
            if boila_pc_tok(l, wi + 1).kind != tok_op() || boila_pc_tok(l, wi + 1).txt != "=" {
                return boila_pc_fail("очаквах '=' в WITH опция", "42601")
            }
            let vv = boila_pc_tok(l, wi + 2)
            if vv.kind != tok_num() {
                return boila_pc_fail("очаквах число в WITH опция", "42601")
            }
            let n = parse_int(vv.txt)
            if kn.txt == "ttl_days" {
                if n <= 0 {
                    return boila_pc_fail("ttl_days трябва > 0", "0A000")
                }
                cr.ttl_sec = n * 86400
            } else {
                if kn.txt == "ttl_sec" {
                    if n <= 0 {
                        return boila_pc_fail("ttl_sec трябва > 0", "0A000")
                    }
                    cr.ttl_sec = n
                } else {
                    return boila_pc_fail(concat("непозната WITH опция '", concat(kn.txt, "' (ttl_days|ttl_sec)")), "0A000")
                }
            }
            wi = wi + 3
            if boila_pc_tok(l, wi).kind == tok_comma() {
                wi = wi + 1
            } else {
                more_w = false
            }
        }
        if boila_pc_tok(l, wi).kind != tok_rparen() {
            return boila_pc_fail("очаквах ')' след WITH (...)", "42601")
        }
        i = wi + 1
    }
    if boila_pc_tok(l, i).kind == tok_semi() {
        i = i + 1
    }
    if boila_pc_tok(l, i).kind != tok_eof() {
        let extra = boila_pc_tok(l, i)
        return boila_pc_fail(concat("неочакван токен '", concat(extra.txt, "' след CREATE TABLE")), "0A000")
    }
    return BoilaParseCreate { ok: 1, create: cr, if_not_exists: ifne, err: "", state: "" }
}

// CREATE/DROP DATABASE, USE, DROP TABLE, TRUNCATE parsers moved to
// parse_db.baga at P20-3 (filesize §9).
