// parse_txn.baga — parser за транзакционен контрол (P4/P17).
//
// Граматика:
//   BEGIN [WORK|TRANSACTION] [txn_mode [, ...]] [;]
//   START TRANSACTION [txn_mode [, ...]] [;]
//   COMMIT|END [WORK|TRANSACTION] [;]
//   ROLLBACK|ABORT [WORK|TRANSACTION] [;]
// txn_mode: READ ONLY | READ WRITE
//           | ISOLATION LEVEL SERIALIZABLE|REPEATABLE READ|READ COMMITTED
// DEFERRABLE → 0A000.

import "token.baga"
import "lexer.baga"
import "std/str/str.baga"

struct BoilaParseTxn {
    ok: i64,
    op: i64,          // 1 begin, 2 commit, 3 rollback
    read_only: i64,
    isol: i64,        // 0 rc, 1 rr, 2 serializable
    err: str,
    state: str
}

fn boila_pt_fail(msg: str, state: str) -> BoilaParseTxn {
    return BoilaParseTxn { ok: 0, op: 0, read_only: 0, isol: 0, err: msg, state: state }
}

fn boila_pt_tok(l: BoilaLex, i: i64) -> Token {
    if i < vec_len(l.toks) {
        return vec_get(l.toks, i)
    }
    return token_new(tok_eof(), "")
}

// [READ ONLY] → read_only; връща pos след тях.
fn boila_pt_readonly(l: BoilaLex, i: i64) -> BoilaParseTxn {
    if tok_kw(boila_pt_tok(l, i), "read") == 1 {
        if tok_kw(boila_pt_tok(l, i + 1), "only") != 1 {
            return boila_pt_fail("очаквах ONLY след READ", "42601")
        }
        return BoilaParseTxn { ok: 1, op: 0, read_only: 1, isol: 0, err: "", state: "" }
    }
    return BoilaParseTxn { ok: 1, op: 0, read_only: 0, isol: 0, err: "", state: "" }
}

// tail: [;] EOF
fn boila_pt_tail(l: BoilaLex, i: i64) -> BoilaParseTxn {
    let mut p = i
    if boila_pt_tok(l, p).kind == tok_semi() {
        p = p + 1
    }
    if boila_pt_tok(l, p).kind != tok_eof() {
        let extra = boila_pt_tok(l, p)
        return boila_pt_fail(concat("неочакван токен '", concat(extra.txt, "'")), "0A000")
    }
    return BoilaParseTxn { ok: 1, op: 0, read_only: 0, isol: 0, err: "", state: "" }
}

// One BEGIN mode. ok=1 + op=1 → consumed; op=0 → not a mode; ok=0 → error.
fn boila_pt_mode(l: BoilaLex, i: i64) -> BoilaParseTxn {
    let t = boila_pt_tok(l, i)
    if tok_kw(t, "read") == 1 {
        if tok_kw(boila_pt_tok(l, i + 1), "only") == 1 {
            return BoilaParseTxn { ok: 1, op: 1, read_only: 1, isol: 0, err: "", state: "" }
        }
        if tok_kw(boila_pt_tok(l, i + 1), "write") == 1 {
            return BoilaParseTxn { ok: 1, op: 1, read_only: 0, isol: 0, err: "", state: "" }
        }
        if tok_kw(boila_pt_tok(l, i + 1), "committed") == 1 || tok_kw(boila_pt_tok(l, i + 1), "uncommitted") == 1 {
            return boila_pt_fail("очаквах ISOLATION LEVEL преди READ COMMITTED", "42601")
        }
        return boila_pt_fail("очаквах ONLY или WRITE след READ", "42601")
    }
    if tok_kw(t, "isolation") == 1 {
        if tok_kw(boila_pt_tok(l, i + 1), "level") != 1 {
            return boila_pt_fail("очаквах LEVEL след ISOLATION", "42601")
        }
        let a = boila_pt_tok(l, i + 2)
        if tok_kw(a, "serializable") == 1 {
            return BoilaParseTxn { ok: 1, op: 2, read_only: 0, isol: 2, err: "", state: "" }
        }
        if tok_kw(a, "repeatable") == 1 {
            if tok_kw(boila_pt_tok(l, i + 3), "read") != 1 {
                return boila_pt_fail("очаквах READ след REPEATABLE", "42601")
            }
            return BoilaParseTxn { ok: 1, op: 3, read_only: 0, isol: 1, err: "", state: "" }
        }
        if tok_kw(a, "read") == 1 {
            let b = boila_pt_tok(l, i + 3)
            if tok_kw(b, "committed") == 1 || tok_kw(b, "uncommitted") == 1 {
                return BoilaParseTxn { ok: 1, op: 3, read_only: 0, isol: 0, err: "", state: "" }
            }
            return boila_pt_fail("очаквах COMMITTED след READ", "42601")
        }
        return boila_pt_fail(concat("непознато isolation level '", concat(a.txt, "'")), "0A000")
    }
    if tok_kw(t, "deferrable") == 1 || (tok_kw(t, "not") == 1 && tok_kw(boila_pt_tok(l, i + 1), "deferrable") == 1) {
        return boila_pt_fail("DEFERRABLE не се поддържа", "0A000")
    }
    return BoilaParseTxn { ok: 1, op: 0, read_only: 0, isol: 0, err: "", state: "" }
}

fn boila_pt_modes(l: BoilaLex, i: i64) -> BoilaParseTxn {
    let mut p = i
    let mut ro: i64 = 0
    let mut isol: i64 = 0
    let mut more: i64 = 1
    while more == 1 {
        if boila_pt_tok(l, p).kind == tok_comma() {
            p = p + 1
        }
        let m = boila_pt_mode(l, p)
        if m.ok == 0 {
            return m
        }
        if m.op == 0 {
            more = 0
        } else {
            if m.op == 1 {
                ro = m.read_only
                p = p + 2
            } else {
                isol = m.isol
                if m.op == 2 {
                    p = p + 3
                } else {
                    p = p + 4
                }
            }
        }
    }
    let tl = boila_pt_tail(l, p)
    if tl.ok == 0 {
        return tl
    }
    return BoilaParseTxn { ok: 1, op: 1, read_only: ro, isol: isol, err: "", state: "" }
}

fn boila_parse_txn(l: BoilaLex) -> BoilaParseTxn {
    let t0 = boila_pt_tok(l, 0)
    let mut i: i64 = 1
    let mut op: i64 = 0
    if tok_kw(t0, "begin") == 1 {
        if tok_kw(boila_pt_tok(l, i), "work") == 1 || tok_kw(boila_pt_tok(l, i), "transaction") == 1 {
            i = i + 1
        }
        let md = boila_pt_modes(l, i)
        if md.ok == 0 {
            return md
        }
        return BoilaParseTxn { ok: 1, op: 1, read_only: md.read_only, isol: md.isol, err: "", state: "" }
    }
    if tok_kw(t0, "start") == 1 {
        if tok_kw(boila_pt_tok(l, i), "transaction") != 1 {
            return boila_pt_fail("очаквах TRANSACTION след START", "42601")
        }
        i = i + 1
        let md = boila_pt_modes(l, i)
        if md.ok == 0 {
            return md
        }
        return BoilaParseTxn { ok: 1, op: 1, read_only: md.read_only, isol: md.isol, err: "", state: "" }
    }
    if tok_kw(t0, "commit") == 1 || tok_kw(t0, "end") == 1 {
        op = 2
        if tok_kw(boila_pt_tok(l, i), "work") == 1 || tok_kw(boila_pt_tok(l, i), "transaction") == 1 {
            i = i + 1
        }
        let tl = boila_pt_tail(l, i)
        if tl.ok == 0 {
            return tl
        }
        return BoilaParseTxn { ok: 1, op: op, read_only: 0, isol: 0, err: "", state: "" }
    }
    if tok_kw(t0, "rollback") == 1 || tok_kw(t0, "abort") == 1 {
        op = 3
        if tok_kw(boila_pt_tok(l, i), "work") == 1 || tok_kw(boila_pt_tok(l, i), "transaction") == 1 {
            i = i + 1
        }
        let tl = boila_pt_tail(l, i)
        if tl.ok == 0 {
            return tl
        }
        return BoilaParseTxn { ok: 1, op: op, read_only: 0, isol: 0, err: "", state: "" }
    }
    return boila_pt_fail(concat("непознато транзакционно заявление '", concat(t0.txt, "'")), "42601")
}
