// parse_window_frame.baga — P25 ROWS/RANGE frame clause.
// Bound kinds: 0=UNBOUNDED PRECEDING, 1=n PRECEDING, 2=CURRENT ROW,
// 3=n FOLLOWING, 4=UNBOUNDED FOLLOWING.
import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_common.baga"
import "std/str/str.baga"

struct BoilaParseFr {
    ok: i64,
    win: BoilaWin,
    pos: i64,
    err: str,
    state: str
}

fn boila_pfr_fail(msg: str, state: str, pos: i64) -> BoilaParseFr {
    return BoilaParseFr { ok: 0, win: boila_win_none(), pos: pos, err: msg, state: state }
}

struct BoilaFrBound {
    ok: i64,
    k: i64,
    n: i64,
    pos: i64,
    err: str,
    state: str
}

fn boila_fb_fail(msg: str, state: str, pos: i64) -> BoilaFrBound {
    return BoilaFrBound { ok: 0, k: 0, n: 0, pos: pos, err: msg, state: state }
}

fn boila_parse_frame_bound(l: BoilaLex, p: i64) -> BoilaFrBound {
    let t = boila_ps_tok(l, p)
    if tok_kw(t, "unbounded") == 1 {
        if tok_kw(boila_ps_tok(l, p + 1), "preceding") == 1 {
            return BoilaFrBound { ok: 1, k: 0, n: 0, pos: p + 2, err: "", state: "" }
        }
        if tok_kw(boila_ps_tok(l, p + 1), "following") == 1 {
            return BoilaFrBound { ok: 1, k: 4, n: 0, pos: p + 2, err: "", state: "" }
        }
        return boila_fb_fail("очаквах PRECEDING|FOLLOWING след UNBOUNDED", "42601", p + 1)
    }
    if tok_kw(t, "current") == 1 {
        if tok_kw(boila_ps_tok(l, p + 1), "row") != 1 {
            return boila_fb_fail("очаквах ROW след CURRENT", "42601", p + 1)
        }
        return BoilaFrBound { ok: 1, k: 2, n: 0, pos: p + 2, err: "", state: "" }
    }
    if t.kind == tok_param() {
        return boila_fb_fail("frame offset не приема $N", "0A000", p)
    }
    if t.kind == tok_num() {
        let n = parse_int(t.txt)
        if n < 0 {
            return boila_fb_fail("frame offset не може да е отрицателен", "22023", p)
        }
        let d = boila_ps_tok(l, p + 1)
        if tok_kw(d, "preceding") == 1 {
            return BoilaFrBound { ok: 1, k: 1, n: n, pos: p + 2, err: "", state: "" }
        }
        if tok_kw(d, "following") == 1 {
            return BoilaFrBound { ok: 1, k: 3, n: n, pos: p + 2, err: "", state: "" }
        }
        return boila_fb_fail("очаквах PRECEDING|FOLLOWING след число в frame", "42601", p + 1)
    }
    return boila_fb_fail(concat("очаквах frame bound, получих '", concat(t.txt, "'")), "42601", p)
}

fn boila_parse_frame(l: BoilaLex, p: i64, w: BoilaWin) -> BoilaParseFr {
    let t = boila_ps_tok(l, p)
    if tok_kw(t, "groups") == 1 {
        return boila_pfr_fail("GROUPS frame — 0A000", "0A000", p)
    }
    let mut fk: i64 = 0
    if tok_kw(t, "rows") == 1 {
        fk = 1
    } else {
        if tok_kw(t, "range") == 1 {
            fk = 2
        } else {
            return BoilaParseFr { ok: 1, win: w, pos: p, err: "", state: "" }
        }
    }
    let mut q = p + 1
    let mut a = boila_parse_frame_bound(l, q)
    let mut b = BoilaFrBound { ok: 1, k: 2, n: 0, pos: q, err: "", state: "" }
    if tok_kw(boila_ps_tok(l, q), "between") == 1 {
        a = boila_parse_frame_bound(l, q + 1)
        if a.ok == 0 {
            return boila_pfr_fail(a.err, a.state, a.pos)
        }
        if tok_kw(boila_ps_tok(l, a.pos), "and") != 1 {
            return boila_pfr_fail("очаквах AND в frame BETWEEN", "42601", a.pos)
        }
        b = boila_parse_frame_bound(l, a.pos + 1)
        if b.ok == 0 {
            return boila_pfr_fail(b.err, b.state, b.pos)
        }
        q = b.pos
    } else {
        a = boila_parse_frame_bound(l, q)
        if a.ok == 0 {
            return boila_pfr_fail(a.err, a.state, a.pos)
        }
        b.k = 2
        b.n = 0
        q = a.pos
    }
    if a.k == 4 {
        return boila_pfr_fail("frame start не може да е UNBOUNDED FOLLOWING", "42601", p)
    }
    if b.k == 0 {
        return boila_pfr_fail("frame end не може да е UNBOUNDED PRECEDING", "42601", p)
    }
    if fk == 2 && (a.k == 1 || a.k == 3 || b.k == 1 || b.k == 3) {
        return boila_pfr_fail("RANGE offset PRECEDING/FOLLOWING — 0A000", "0A000", p)
    }
    if fk == 2 && a.k == 2 && b.k != 4 {
        return boila_pfr_fail("RANGE CURRENT ROW като start — 0A000", "0A000", p)
    }
    w.fk = fk
    w.fs = a.k
    w.fe = b.k
    w.na = a.n
    w.nb = b.n
    return BoilaParseFr { ok: 1, win: w, pos: q, err: "", state: "" }
}
