// plan_cache.baga — plan cache за SELECT (P5).
//
// Кеш по суров SQL текст: sel + лява таблица (вкл. JOIN — C1; дясната
// се резолва при exec по sel.join_table). Инвалидация: нова карта при
// DDL (bump на gen).

import "ast.baga"
import "../catalog/schema.baga"

struct BoilaSelPlan {
    sel: BoilaSel,
    table: BoilaTable,
    // P41: shape cache — 0 = пълен план (не се замества); 1/2/3 = при hit
    // се замества pk_eq/pk_lo/pk_hi с литерала от token индекс sub_tok.
    sub_field: i64,
    sub_tok: i64
}

struct BoilaPlanCache {
    m: Map<str, BoilaSelPlan>,
    // P41: shape cache — ключ нормализиран SQL (литералите → "?"),
    // за заявки с вариращи литерали (pgbench aid=…), които иначе
    // никога не биха hit-нали суровия ключ (и пълнят persist чрез put).
    sm: Map<str, BoilaSelPlan>,
    // P35: in-memory catalog кеш — table name → декодирана BoilaTable.
    // Убива 3 point GET-а + пълен schema decode на заявка (gaps Q1:
    // lex+parse+catalog ≈ 4.9 µs; ~79 KB arena churn/заявка през pgwire).
    // Инвалидира се заедно с m при DDL (boila_pc_invalidate).
    tm: Map<str, BoilaTable>,
    gen: i64
}

struct BoilaPcGet {
    hit: i64,
    plan: BoilaSelPlan
}

fn boila_pc_new() -> BoilaPlanCache {
    let m: Map<str, BoilaSelPlan> = map_new()
    let sm: Map<str, BoilaSelPlan> = map_new()
    let tm: Map<str, BoilaTable> = map_new()
    return BoilaPlanCache { m: m, sm: sm, tm: tm, gen: 0 }
}

fn boila_pc_empty_plan() -> BoilaSelPlan {
    return BoilaSelPlan { sel: boila_sel_empty(), table: boila_cat_empty_table(), sub_field: 0, sub_tok: 0 }
}

fn boila_pc_get(pc: BoilaPlanCache, sql: str) -> BoilaPcGet {
    if map_has(pc.m, sql) == 1 {
        return BoilaPcGet { hit: 1, plan: map_get(pc.m, sql) }
    }
    return BoilaPcGet { hit: 0, plan: boila_pc_empty_plan() }
}

fn boila_pc_put(pc: BoilaPlanCache, sql: str, plan: BoilaSelPlan) {
    map_set(pc.m, sql, plan)
}

// DDL → празни карти, нов generation.
fn boila_pc_invalidate(pc: BoilaPlanCache) -> BoilaPlanCache {
    let m: Map<str, BoilaSelPlan> = map_new()
    let sm: Map<str, BoilaSelPlan> = map_new()
    let tm: Map<str, BoilaTable> = map_new()
    return BoilaPlanCache { m: m, sm: sm, tm: tm, gen: pc.gen + 1 }
}

// P41: shape cache lookup/put (без mu — същия договор като pc.m).
fn boila_pc_sget(pc: BoilaPlanCache, key: str) -> BoilaPcGet {
    if map_has(pc.sm, key) == 1 {
        return BoilaPcGet { hit: 1, plan: map_get(pc.sm, key) }
    }
    return BoilaPcGet { hit: 0, plan: boila_pc_empty_plan() }
}

fn boila_pc_sput(pc: BoilaPlanCache, key: str, plan: BoilaSelPlan) {
    map_set(pc.sm, key, plan)
}

// P35: каталог resolve през кеша. Hit → 0 GET-ове. Miss → resolve в
// persist региона (кешът преживява per-turn rewind; catch вместо `?`,
// за да не остане persist флагът вдигнат при грешка).
fn boila_pc_cat(pc: BoilaPlanCache, s: BoilaStore, txn: BoilaTxn, name: str) -> BoilaCatRes !IO !Time !Par {
    if map_has(pc.tm, name) == 1 {
        let t = map_get(pc.tm, name)
        return BoilaCatRes { s: s, ok: 1, err: "", state: "", table: t, id: t.id }
    }
    mem_persist_begin()
    let ct = boila_cat_by_name_txn(s, txn, name)
        catch !IO => BoilaCatRes { s: s, ok: 0, err: "catalog io", state: "XX000", table: boila_cat_empty_table(), id: 0 }
        catch !Time => BoilaCatRes { s: s, ok: 0, err: "catalog io", state: "XX000", table: boila_cat_empty_table(), id: 0 }
        catch !Par => BoilaCatRes { s: s, ok: 0, err: "catalog io", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    if ct.ok == 1 {
        map_set(pc.tm, substr(name, 0, len(name)), ct.table)
    }
    mem_persist_end()
    return ct
}

// MT: brief lock around Map touch (mu=0 → unlocked / tests).
fn boila_pc_get_mu(pc: BoilaPlanCache, sql: str, mu: i64) -> BoilaPcGet !Par {
    if mu != 0 {
        mutex_lock(mu)
    }
    let r = boila_pc_get(pc, sql)
    if mu != 0 {
        mutex_unlock(mu)
    }
    return r
}

fn boila_pc_put_mu(pc: BoilaPlanCache, sql: str, plan: BoilaSelPlan, mu: i64) -> i64 !Par {
    if mu != 0 {
        mutex_lock(mu)
    }
    boila_pc_put(pc, sql, plan)
    if mu != 0 {
        mutex_unlock(mu)
    }
    return 0
}

fn boila_pc_invalidate_mu(pc: BoilaPlanCache, mu: i64) -> BoilaPlanCache !Par {
    if mu != 0 {
        mutex_lock(mu)
    }
    // MEM-4: новата (празна) map е shared — persist, за да преживее rewind
    mem_persist_begin()
    let r = boila_pc_invalidate(pc)
    mem_persist_end()
    if mu != 0 {
        mutex_unlock(mu)
    }
    return r
}
