// shards.baga — N shard-а × rocksbaga.
//
// mt=0 (dbs_h==0): LsmCluster by-value — tests / single-thread.
// mt=1: Map<sid,LsmDB> + per-shard mutex (serve) — hop-less parallel
// ops on different shards; multi-shard ops lock 0..n-1 in order.
//
// No !Par on BoilaStore struct (typechecker OOM). !Par only on fns that
// lock. rocksbaga R55 model.

import "rocksbaga/db/shard.baga"
import "rocksbaga/db/shard_read.baga"
import "rocksbaga/db/shard_ttl.baga"
import "rocksbaga/db/engine.baga"
import "rocksbaga/db/engine_wal.baga"
import "rocksbaga/db/engine_ttl.baga"
import "rocksbaga/db/engine_keys.baga"
import "rocksbaga/db/engine_scan.baga"
import "rocksbaga/util/codec.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "shards_kv.baga"
import "shards_base.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"
// → L1=4M L2=16M L3=64M. Override with BOILA_TARGET_BYTES (0 disables).
fn boila_target_bytes() -> i64 !IO {
    let e = env("BOILA_TARGET_BYTES")
    if e == "" {
        return 1048576
    }
    return parse_int(e)
}

fn boila_apply_level_policy(c: LsmCluster) -> LsmCluster !IO {
    let tb = boila_target_bytes()?
    if tb > 0 {
        c = lsm_cluster_apply_target_bytes(c, tb)
    }
    let mp = env("BOILA_MERGE_PICK")
    if mp != "" {
        c = lsm_cluster_apply_merge_pick(c, parse_int(mp))
    }
    return c
}

fn boila_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> BoilaStore !IO !Time !Par {
    let mut fresh: i64 = 0
    if access(dir, 0) != 0 {
        fresh = 1
    }
    let mut c = lsm_cluster_open(dir, nshards, flush_at, compact_at)?
    c = boila_apply_level_policy(c)?
    c = lsm_cluster_apply_filter(c, 1, 0, boila_cf_data())
    let mut s = BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, dual: 0, ok: c.ok }
    // P43b: нова директория → маркер "цялата база е dual"; старите бази
    // (директорията съществува) остават dual=0 → scan fallback.
    if fresh == 1 {
        s = boila_put(s, boila_cf_sys(), 1, bytes_of_str("p43|dual"), bytes_of_str("p43|dual"))?
    }
    let g = boila_get(s, boila_cf_sys(), 1, bytes_of_str("p43|dual"))?
    return BoilaStore { c: g.s.c, dbs_h: 0, mus_h: 0, n: g.s.c.n, dual: g.found, ok: g.s.ok }
}

// Serve path: shards in shared Map + one mutex each (pre-insert all keys).
fn boila_open_mt(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> BoilaStore !IO !Time !Par {
    let mut fresh: i64 = 0
    if access(dir, 0) != 0 {
        fresh = 1
    }
    let mut c = lsm_cluster_open(dir, nshards, flush_at, compact_at)?
    c = boila_apply_level_policy(c)?
    c = lsm_cluster_apply_filter(c, 1, 0, boila_cf_data())
    let dbs: Map<i64, LsmDB> = map_new()
    let mus: Map<i64, i64> = map_new()
    let mut i: i64 = 0
    while i < c.n {
        // MT: без cross-request scan snapshot — pool + per-statement rewind
        // правят кеша use-after-free (segfault в lsm_scan_keys_free_data).
        let mut db = vec_get(c.shards, i)
        db.scan_cache_off = 1
        vec_set(c.shards, i, db)
        map_set(dbs, i, db)
        map_set(mus, i, mutex_new())
        i = i + 1
    }
    let mut s = BoilaStore { c: c, dbs_h: map_h(dbs), mus_h: map_h(mus), n: c.n, dual: 0, ok: c.ok }
    if fresh == 1 {
        s = boila_put(s, boila_cf_sys(), 1, bytes_of_str("p43|dual"), bytes_of_str("p43|dual"))?
    }
    let g = boila_get(s, boila_cf_sys(), 1, bytes_of_str("p43|dual"))?
    return BoilaStore { c: g.s.c, dbs_h: g.s.dbs_h, mus_h: g.s.mus_h, n: g.s.n, dual: g.found, ok: g.s.ok }
}

fn boila_close(s: BoilaStore) -> i64 !IO !Par {
    if s.dbs_h == 0 {
        return lsm_cluster_close(s.c)?
    }
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut i: i64 = 0
    while i < s.n {
        lsm_close(map_get(dbs, i))?
        i = i + 1
    }
    return 0
}

fn boila_shards(s: BoilaStore) -> i64 {
    return s.n
}

fn boila_is_mt(s: BoilaStore) -> i64 {
    if s.dbs_h != 0 {
        return 1
    }
    return 0
}

fn boila_put(s: BoilaStore, cf: i64, table_id: i64, pk: bytes, val: bytes) -> BoilaStore !IO !Time !Par {
    let base = boila_key_row(cf, table_id, pk)
    let key = boila_store_key(cf, table_id, pk, val)
    let ix = lsm_shard_ix_b(s.n, base)
    if s.dbs_h == 0 {
        let mut db = vec_get(s.c.shards, ix)
        db = lsm_put_kb(db, key, val)?
        // P43: dual-write — base сочи най-новата версия (O(1) point get
        // вместо full-shard prefix scan при всяка versioned заявка).
        // val е същият [lsn 8][row] запис; boila_kv_del трие и base.
        if boila_cf_versioned(cf) == 1 && bytes_len(val) >= 8 {
            db = lsm_put_kb(db, base, val)?
        }
        vec_set(s.c.shards, ix, db)
        return BoilaStore { c: s.c, dbs_h: 0, mus_h: 0, n: s.c.n, dual: s.dual, ok: db.ok }
    }
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut db = map_get(dbs, ix)
    db = lsm_put_kb(db, key, val)?
    if boila_cf_versioned(cf) == 1 && bytes_len(val) >= 8 {
        db = lsm_put_kb(db, base, val)?
    }
    map_set(dbs, ix, db)
    let ok = db.ok
    mutex_unlock(mu)
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok }
}

// put with optional TTL (ttl_sec<=0 → plain put). Caller resolves TTL
// (kimi-deps D3 — txn commit must not import ts/).
fn boila_put_ex(s: BoilaStore, cf: i64, table_id: i64, pk: bytes, val: bytes, ttl_sec: i64) -> BoilaStore !IO !Time !Par {
    if ttl_sec <= 0 {
        return boila_put(s, cf, table_id, pk, val)?
    }
    let base = boila_key_row(cf, table_id, pk)
    let key = boila_store_key(cf, table_id, pk, val)
    let ix = lsm_shard_ix_b(s.n, base)
    if s.dbs_h == 0 {
        let mut db = vec_get(s.c.shards, ix)
        db = lsm_put_ex_kb(db, key, val, ttl_sec)?
        if boila_cf_versioned(cf) == 1 && bytes_len(val) >= 8 {
            db = lsm_put_ex_kb(db, base, val, ttl_sec)?
        }
        vec_set(s.c.shards, ix, db)
        return BoilaStore { c: s.c, dbs_h: 0, mus_h: 0, n: s.c.n, dual: s.dual, ok: db.ok }
    }
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut db = map_get(dbs, ix)
    db = lsm_put_ex_kb(db, key, val, ttl_sec)?
    if boila_cf_versioned(cf) == 1 && bytes_len(val) >= 8 {
        db = lsm_put_ex_kb(db, base, val, ttl_sec)?
    }
    map_set(dbs, ix, db)
    let ok = db.ok
    mutex_unlock(mu)
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok }
}

fn boila_get(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaGet !IO !Time !Par {
    let base = boila_key_row(cf, table_id, pk)
    let ix = lsm_shard_ix_b(s.n, base)
    if s.dbs_h == 0 {
        let g = boila_kv_get(vec_get(s.c.shards, ix), cf, base, s.dual)?
        vec_set(s.c.shards, ix, g.db)
        return BoilaGet {
            s: BoilaStore { c: s.c, dbs_h: 0, mus_h: 0, n: s.c.n, dual: s.dual, ok: g.db.ok },
            found: g.found, val: g.val
        }
    }
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let g = boila_kv_get(map_get(dbs, ix), cf, base, s.dual)?
    map_set(dbs, ix, g.db)
    mutex_unlock(mu)
    return BoilaGet { s: s, found: g.found, val: g.val }
}

fn boila_del(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaStore !IO !Time !Par {
    let base = boila_key_row(cf, table_id, pk)
    if boila_cf_versioned(cf) == 0 {
        let ix = lsm_shard_ix_b(s.n, base)
        if s.dbs_h == 0 {
            let mut db = lsm_del_kb(vec_get(s.c.shards, ix), base)?
            vec_set(s.c.shards, ix, db)
            return BoilaStore { c: s.c, dbs_h: 0, mus_h: 0, n: s.c.n, dual: s.dual, ok: db.ok }
        }
        let mu = boila_shard_lock(s, ix)?
        let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
        let mut db = map_get(dbs, ix)
        db = lsm_del_kb(db, base)?
        map_set(dbs, ix, db)
        let ok = db.ok
        mutex_unlock(mu)
        return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok }
    }
    // Versioned data: sweep every shard. Routing is by user key, but a
    // leftover version hashed on the suffixed key must still be dropped.
    let mut ok: i64 = 1
    let mut i: i64 = 0
    while i < s.n {
        if s.dbs_h == 0 {
            let mut db = boila_kv_del(vec_get(s.c.shards, i), cf, base)?
            vec_set(s.c.shards, i, db)
            ok = db.ok
        } else {
            let mu = boila_shard_lock(s, i)?
            let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
            let mut db = map_get(dbs, i)
            db = boila_kv_del(db, cf, base)?
            map_set(dbs, i, db)
            ok = db.ok
            mutex_unlock(mu)
        }
        i = i + 1
    }
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok }
}

// K2/K2b: true byte-prefix scan (no glob). pref = full key prefix
// (cf|table, or cf|table|ix|val for secondary exact lookup).
fn boila_scan_pref(s: BoilaStore, pref: bytes, cursor: i64, count: i64) -> BoilaScan !IO !Time !Par {
    if s.dbs_h == 0 {
        let r = lsm_cluster_scan_prefix_kb(s.c, cursor, count, pref)?
        return BoilaScan {
            s: BoilaStore { c: r.c, dbs_h: 0, mus_h: 0, n: r.c.n, dual: s.dual, ok: r.c.ok },
            next: r.next, keys: r.keys
        }
    }
    // Per-shard lock (no all_lock): collect matches, paginate by cursor index.
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let all: Vec<bytes> = vec_new()
    let mut si: i64 = 0
    let mut ok: i64 = 1
    while si < s.n {
        let mu = boila_shard_lock(s, si)?
        let mut db = map_get(dbs, si)
        let mut sc = 0
        let mut done = false
        while done == false {
            let r = lsm_scan_prefix_kb(db, sc, 256, pref)?
            db = r.db
            let mut j: i64 = 0
            while j < vec_len(r.keys) {
                vec_push(all, vec_get(r.keys, j))
                j = j + 1
            }
            sc = r.next
            if sc == 0 {
                done = true
            }
        }
        ok = db.ok
        map_set(dbs, si, db)
        mutex_unlock(mu)
        si = si + 1
    }
    let keys: Vec<bytes> = vec_new()
    let mut i = cursor
    let mut nout: i64 = 0
    while i < vec_len(all) && nout < count {
        vec_push(keys, vec_get(all, i))
        i = i + 1
        nout = nout + 1
    }
    let mut next: i64 = 0
    if i < vec_len(all) {
        next = i
    }
    return BoilaScan {
        s: BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok },
        next: next, keys: keys
    }
}

fn boila_scan(s: BoilaStore, cf: i64, table_id: i64, cursor: i64, count: i64) -> BoilaScan !IO !Time !Par {
    return boila_scan_pref(s, boila_key_prefix(cf, table_id), cursor, count)?
}

fn boila_scan_invalidate(s: BoilaStore) -> BoilaStore !Par {
    s.c.scan_epoch = 0 - 1
    let mut i: i64 = 0
    while i < s.c.n {
        let mut db = vec_get(s.c.shards, i)
        db.scan_epoch = 0 - 1
        vec_set(s.c.shards, i, db)
        i = i + 1
    }
    if s.dbs_h != 0 {
        boila_all_lock(s)?
        let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
        i = 0
        while i < s.n {
            let mut db = map_get(dbs, i)
            db.scan_epoch = 0 - 1
            map_set(dbs, i, db)
            i = i + 1
        }
        boila_all_unlock(s)?
    }
    return s
}

// One-shot prefix collect (avoids multi-shard O(N²) re-fold per page).
// Used by secondary range seek (K3h) and bulk index walks.
