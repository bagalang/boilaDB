// shards_base.baga — BoilaStore/BoilaGet/BoilaScan + shard lock-ове +
// BoilaScanAll/boila_scan_pref_all/boila_flush, изнесени от shards.baga
// (filesize gate §9). Останалите op-ове (open/put/get/del/scan) остават
// в shards.baga и ползват тези дефиниции през import.

import "rocksbaga/db/shard.baga"
import "rocksbaga/db/shard_read.baga"
import "rocksbaga/db/shard_ttl.baga"
import "rocksbaga/db/engine.baga"
import "rocksbaga/db/engine_wal.baga"
import "rocksbaga/db/engine_ttl.baga"
import "rocksbaga/db/engine_keys.baga"
import "rocksbaga/db/engine_scan.baga"
import "rocksbaga/util/codec.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"


struct BoilaStore {
    c: LsmCluster,
    dbs_h: i64,
    mus_h: i64,
    n: i64,
    ok: i64,
    // P43b: 1 = цялото съдържание е с dual base ключове (база създадена
    // след P43 или маркирана) — versioned get при base miss НЯМА нужда
    // от full-shard scan fallback (редът просто го няма). 0 = може да
    // има legacy редове → scan fallback за коректност.
    dual: i64
}

struct BoilaGet {
    s: BoilaStore,
    found: i64,
    val: bytes
}

struct BoilaScan {
    s: BoilaStore,
    next: i64,
    keys: Vec<bytes>
}

// L0 byte target. 0 = file-count only (no pair-collapse). Default 1 MiB


fn boila_shard_lock(s: BoilaStore, ix: i64) -> i64 !Par {
    let mus: Map<i64, i64> = h_map(s.mus_h)
    let mu = map_get(mus, ix)
    mutex_lock(mu)
    return mu
}

fn boila_all_lock(s: BoilaStore) -> i64 !Par {
    let mut i: i64 = 0
    while i < s.n {
        boila_shard_lock(s, i)?
        i = i + 1
    }
    return 0
}

fn boila_all_unlock(s: BoilaStore) -> i64 !Par {
    let mut i = s.n - 1
    while i >= 0 {
        let mus: Map<i64, i64> = h_map(s.mus_h)
        mutex_unlock(map_get(mus, i))
        i = i - 1
    }
    return 0
}

struct BoilaScanAll {
    s: BoilaStore,
    keys: Vec<bytes>
}

fn boila_scan_pref_all(s: BoilaStore, pref: bytes) -> BoilaScanAll !IO !Time !Par {
    if s.dbs_h == 0 {
        let r = lsm_cluster_scan_prefix_all_kb(s.c, pref)?
        return BoilaScanAll {
            s: BoilaStore { c: r.c, dbs_h: 0, mus_h: 0, n: r.c.n, dual: s.dual, ok: r.c.ok },
            keys: r.keys
        }
    }
    let all: Vec<bytes> = vec_new()
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut si: i64 = 0
    let mut ok: i64 = 1
    while si < s.n {
        let mu = boila_shard_lock(s, si)?
        let mut db = map_get(dbs, si)
        let r = lsm_scan_prefix_all_kb(db, pref)?
        db = r.db
        let mut j: i64 = 0
        while j < vec_len(r.keys) {
            vec_push(all, vec_get(r.keys, j))
            j = j + 1
        }
        ok = db.ok
        map_set(dbs, si, db)
        mutex_unlock(mu)
        si = si + 1
    }
    // mt: keys from shards interleave — sort for index range lower_bound
    sort_bytes(all)
    return BoilaScanAll {
        s: BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok },
        keys: all
    }
}

fn boila_flush(s: BoilaStore) -> BoilaStore !IO !Time !Par {
    if s.dbs_h == 0 {
        let c = lsm_cluster_flush_force(s.c)?
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, dual: s.dual, ok: c.ok }
    }
    boila_all_lock(s)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut ok: i64 = 1
    let mut i: i64 = 0
    while i < s.n {
        let mut db = map_get(dbs, i)
        db = lsm_flush_force(db)?
        map_set(dbs, i, db)
        ok = db.ok
        i = i + 1
    }
    boila_all_unlock(s)?
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, dual: s.dual, ok: ok }
}
