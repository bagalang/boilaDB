// shards_kv.baga — versioned data-CF get/del (P16).
// Route by the unversioned user key; data values [lsn 8][row] live under
// [cf][table][pk][~lsn 8]. Sys/index/other CFs stay exact-key.

import "rocksbaga/db/engine.baga"
import "rocksbaga/db/engine_scan.baga"
import "../core/codec.baga"
import "std/bytes/bytes.baga"

fn boila_kv_get(db: LsmDB, cf: i64, base: bytes, dual: i64) -> LsmGet !IO !Time {
    return boila_kv_get_asof(db, cf, base, 0 - 1, dual)?
}

// max_lsn < 0 → newest; else newest version with key lsn ≤ max_lsn.
fn boila_kv_get_asof(db: LsmDB, cf: i64, base: bytes, max_lsn: i64, dual: i64) -> LsmGet !IO !Time {
    if boila_cf_versioned(cf) == 0 {
        return lsm_get_kb(db, base)?
    }
    // P43: точен probe на base ключа (dual-write newest) — без full-shard
    // prefix scan на заявка. Miss → scan fallback само ако базата може да
    // има legacy редове (dual=0); при dual=1 base miss = "няма такъв ред".
    if max_lsn < 0 {
        let g0 = lsm_get_kb(db, base)?
        db = g0.db
        if g0.found == 1 {
            return LsmGet { db: db, found: 1, val: g0.val }
        }
        if dual == 1 {
            return LsmGet { db: db, found: 0, val: bytes_new(0) }
        }
    }
    let sc = lsm_scan_prefix_all_kb(db, base)?
    db = sc.db
    let bl = bytes_len(base)
    let mut best = bytes_new(0)
    let mut best_lsn: i64 = 0 - 1
    let mut have: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(sc.keys) {
        let k = vec_get(sc.keys, i)
        let kn = bytes_len(k)
        if kn == bl + 8 {
            let lv = boila_key_ver_lsn(k)
            let mut ok: i64 = 1
            if max_lsn >= 0 && lv > max_lsn {
                ok = 0
            }
            if ok == 1 && (have == 0 || lv > best_lsn) {
                best = k
                best_lsn = lv
                have = 1
            }
        } else {
            if kn == bl && have == 0 && max_lsn < 0 {
                best = k
                have = 1
            }
        }
        i = i + 1
    }
    if have == 0 {
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return lsm_get_kb(db, best)?
}

fn boila_kv_del(db: LsmDB, cf: i64, base: bytes) -> LsmDB !IO !Time {
    db = lsm_del_kb(db, base)?
    if boila_cf_versioned(cf) == 0 {
        return db
    }
    db.scan_epoch = 0 - 1
    let sc = lsm_scan_prefix_all_kb(db, base)?
    db = sc.db
    let bl = bytes_len(base)
    let owned: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(sc.keys) {
        let k = vec_get(sc.keys, i)
        let kn = bytes_len(k)
        if kn == bl || kn == bl + 8 {
            vec_push(owned, bytes_slice(k, 0, kn))
        }
        i = i + 1
    }
    i = 0
    while i < vec_len(owned) {
        db = lsm_del_kb(db, vec_get(owned, i))?
        i = i + 1
    }
    return db
}
