// mvcc.baga — транзакции (P4, едно-сесийен модел).
//
// T6: BOILA_TXN_MAX (default 100000) caps buffer entries; 0 = unlimited.
// SQLSTATE 54000 program_limit_exceeded.
//
// Committed value формат v2: [lsn 8B BE][row enc].

import "../storage/shards.baga"
import "../storage/shards_wal.baga"
import "../storage/shards_keys.baga"
import "lsn.baga"
import "gc_filter.baga"
import "serial.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

// ttl_sec: set by caller on data puts (table TTL); commit passes to
// boila_put_ex. Non-data / del → 0. (kimi-deps D3 — no ts/ import.)
struct BoilaTxnWrite {
    cf: i64,
    table_id: i64,
    pk: bytes,
    is_del: i64,
    row: bytes,     // row enc при put; празно при del/index entry
    ttl_sec: i64
}

struct BoilaTxnRead {
    table_id: i64,
    pk: bytes
}

struct BoilaTxn {
    active: i64,
    read_only: i64,
    snapshot_lsn: i64,
    db: str,        // базата, в която е започната (една транзакция = една база)
    writes: Vec<BoilaTxnWrite>,
    max_writes: i64, // T6; 0 = unlimited
    isol: i64,       // 0 rc, 1 rr, 2 serializable (P17)
    reads: Vec<BoilaTxnRead>
}

fn boila_txn_max_default() -> i64 {
    return 100000
}

// Read BOILA_TXN_MAX once per BEGIN (0 = unlimited).
fn boila_txn_max_from_env() -> i64 !IO {
    let e = env("BOILA_TXN_MAX")
    if e == "" {
        return boila_txn_max_default()
    }
    let n = parse_int(e)
    if n < 0 {
        return boila_txn_max_default()
    }
    return n
}

fn boila_txn_buf_full(txn: BoilaTxn) -> i64 {
    if txn.max_writes <= 0 {
        return 0
    }
    if vec_len(txn.writes) >= txn.max_writes {
        return 1
    }
    return 0
}

struct BoilaTxnRes {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    lsn: i64
}

fn boila_txn_new() -> BoilaTxn {
    let w: Vec<BoilaTxnWrite> = vec_new()
    let r: Vec<BoilaTxnRead> = vec_new()
    return BoilaTxn { active: 0, read_only: 0, snapshot_lsn: 0, db: "", writes: w, max_writes: boila_txn_max_default(), isol: 0, reads: r }
}

fn boila_txn_res(s: BoilaStore, txn: BoilaTxn, ok: i64, err: str, state: str, lsn: i64) -> BoilaTxnRes {
    return BoilaTxnRes { s: s, txn: txn, ok: ok, err: err, state: state, lsn: lsn }
}

// LSN counter: txn/lsn.baga (P27 per-shard). Wrap stays here.

// --- value v2: [lsn 8B BE][row] ---

fn boila_wrap_val(lsn: i64, row: bytes) -> bytes {
    let mut out = bytes_new(8)
    let mut i: i64 = 0
    while i < 8 {
        bytes_set(out, i, (lsn >> (56 - 8 * i)) & 255)
        i = i + 1
    }
    return bytes_concat(out, row)
}

fn boila_unwrap_lsn(val: bytes) -> i64 {
    if bytes_len(val) < 8 {
        return 0
    }
    let mut x: i64 = 0
    let mut i: i64 = 0
    while i < 8 {
        x = (x << 8) | (bytes_at(val, i) & 255)
        i = i + 1
    }
    return x
}

fn boila_unwrap_row(val: bytes) -> bytes {
    if bytes_len(val) <= 8 {
        return bytes_new(0)
    }
    return bytes_slice(val, 8, bytes_len(val))
}

// --- буферни операции ---

fn boila_txn_find(txn: BoilaTxn, cf: i64, table_id: i64, pk: bytes) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(txn.writes) {
        let w = vec_get(txn.writes, i)
        if w.cf == cf && w.table_id == table_id && bytes_eq_b(w.pk, pk) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn boila_txn_put(s: BoilaStore, txn: BoilaTxn, cf: i64, table_id: i64, pk: bytes, row: bytes) -> BoilaTxnRes {
    return boila_txn_put_ex(s, txn, cf, table_id, pk, row, 0)
}

// Data-row put with table TTL (from BoilaTable.ttl_sec). Other CFs use 0.
fn boila_txn_put_ex(s: BoilaStore, txn: BoilaTxn, cf: i64, table_id: i64, pk: bytes, row: bytes, ttl_sec: i64) -> BoilaTxnRes {
    if txn.read_only == 1 {
        return boila_txn_res(s, txn, 0, "READ ONLY транзакция", "25006", 0)
    }
    let ix = boila_txn_find(txn, cf, table_id, pk)
    if ix >= 0 {
        vec_set(txn.writes, ix, BoilaTxnWrite { cf: cf, table_id: table_id, pk: pk, is_del: 0, row: row, ttl_sec: ttl_sec })
    } else {
        if boila_txn_buf_full(txn) == 1 {
            return boila_txn_res(s, txn, 0, concat("txn buffer limit ", concat(int_to_str(txn.max_writes), " (BOILA_TXN_MAX)")), "54000", 0)
        }
        vec_push(txn.writes, BoilaTxnWrite { cf: cf, table_id: table_id, pk: pk, is_del: 0, row: row, ttl_sec: ttl_sec })
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

fn boila_txn_del(s: BoilaStore, txn: BoilaTxn, cf: i64, table_id: i64, pk: bytes) -> BoilaTxnRes {
    if txn.read_only == 1 {
        return boila_txn_res(s, txn, 0, "READ ONLY транзакция", "25006", 0)
    }
    let ix = boila_txn_find(txn, cf, table_id, pk)
    if ix >= 0 {
        vec_set(txn.writes, ix, BoilaTxnWrite { cf: cf, table_id: table_id, pk: pk, is_del: 1, row: bytes_new(0), ttl_sec: 0 })
    } else {
        if boila_txn_buf_full(txn) == 1 {
            return boila_txn_res(s, txn, 0, concat("txn buffer limit ", concat(int_to_str(txn.max_writes), " (BOILA_TXN_MAX)")), "54000", 0)
        }
        vec_push(txn.writes, BoilaTxnWrite { cf: cf, table_id: table_id, pk: pk, is_del: 1, row: bytes_new(0), ttl_sec: 0 })
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

// --- BEGIN / COMMIT / ROLLBACK ---

fn boila_txn_begin(s: BoilaStore, txn: BoilaTxn, read_only: i64, db: str) -> BoilaTxnRes !IO !Time !Par {
    return boila_txn_begin_isol(s, txn, read_only, db, 0)?
}

fn boila_txn_begin_isol(s: BoilaStore, txn: BoilaTxn, read_only: i64, db: str, isol: i64) -> BoilaTxnRes !IO !Time !Par {
    if txn.active == 1 {
        return boila_txn_res(s, txn, 0, "вече има активна транзакция", "25001", 0)
    }
    let cur = boila_lsn_current(s)?
    let w: Vec<BoilaTxnWrite> = vec_new()
    let r: Vec<BoilaTxnRead> = vec_new()
    let maxw = boila_txn_max_from_env()?
    let t2 = BoilaTxn { active: 1, read_only: read_only, snapshot_lsn: cur.lsn, db: db, writes: w, max_writes: maxw, isol: isol, reads: r }
    let s2 = boila_gc_on_begin(cur.s, cur.lsn)?
    return boila_txn_res(s2, t2, 1, "", "", cur.lsn)
}

fn boila_txn_rollback(txn: BoilaTxn) -> BoilaTxn {
    let w: Vec<BoilaTxnWrite> = vec_new()
    let r: Vec<BoilaTxnRead> = vec_new()
    return BoilaTxn { active: 0, read_only: 0, snapshot_lsn: 0, db: "", writes: w, max_writes: txn.max_writes, isol: 0, reads: r }
}

fn boila_txn_rollback_s(s: BoilaStore, txn: BoilaTxn) -> BoilaTxnRes !Par {
    let t2 = boila_txn_rollback(txn)
    let s2 = boila_gc_on_end(s)?
    return boila_txn_res(s2, t2, 1, "", "", 0)
}

// COMMIT: LSN alloc + всички buffer записи в един fsync batch.
fn boila_txn_commit(s: BoilaStore, txn: BoilaTxn) -> BoilaTxnRes !IO !Time !Par {
    if txn.active == 0 {
        // PG: COMMIT без txn е no-op (warning)
        return boila_txn_res(s, txn, 1, "", "", 0)
    }
    if vec_len(txn.writes) == 0 {
        return boila_txn_rollback_s(s, txn)?
    }
    if txn.isol == boila_isol_ser() {
        let snap = txn.snapshot_lsn
        let mut ci: i64 = 0
        while ci < vec_len(txn.reads) {
            let rd = vec_get(txn.reads, ci)
            let cg = boila_get(s, boila_cf_data(), rd.table_id, rd.pk)?
            s = cg.s
            if cg.found == 0 || boila_unwrap_lsn(cg.val) > snap {
                let rb = boila_txn_rollback_s(s, txn)?
                return boila_txn_res(rb.s, rb.txn, 0, "serialization_failure", "40001", 0)
            }
            ci = ci + 1
        }
        ci = 0
        while ci < vec_len(txn.writes) {
            let w = vec_get(txn.writes, ci)
            if w.cf == boila_cf_data() {
                let cg = boila_get(s, boila_cf_data(), w.table_id, w.pk)?
                s = cg.s
                if cg.found == 1 && boila_unwrap_lsn(cg.val) > snap {
                    let rb = boila_txn_rollback_s(s, txn)?
                    return boila_txn_res(rb.s, rb.txn, 0, "serialization_failure", "40001", 0)
                }
            }
            ci = ci + 1
        }
    }
    let cur = boila_lsn_current(s)?
    s = cur.s
    let lsn = cur.lsn + 1
    let mut mask: i64 = 0
    let mut wi: i64 = 0
    while wi < vec_len(txn.writes) {
        let w = vec_get(txn.writes, wi)
        if w.is_del == 1 && boila_cf_versioned(w.cf) == 1 {
            mask = boila_stmt_all_mask(s.n)
        } else {
            mask = boila_stmt_mark_key(mask, s.n, w.cf, w.table_id, w.pk)
        }
        wi = wi + 1
    }
    s = boila_stmt_begin_mask(s, mask)
    s = boila_lsn_bump_mask(s, mask, lsn + 1)?
    let mut i: i64 = 0
    while i < vec_len(txn.writes) {
        let w = vec_get(txn.writes, i)
        if w.is_del == 1 {
            s = boila_del(s, w.cf, w.table_id, w.pk)?
        } else {
            let mut val = w.row
            if w.cf != boila_cf_sys() {
                val = boila_wrap_val(lsn, w.row)
            }
            s = boila_put_ex(s, w.cf, w.table_id, w.pk, val, w.ttl_sec)?
        }
        i = i + 1
    }
    s = boila_stmt_commit_mask(s, mask)?
    let t2 = boila_txn_rollback(txn)
    s = boila_gc_on_end(s)?
    return boila_txn_res(s, t2, 1, "", "", lsn)
}

// --- merge четения: buffer + storage ---

struct BoilaTxnGet {
    s: BoilaStore,
    found: i64,
    row: bytes,     // row enc (без lsn обвивката)
    lsn: i64        // 0 = собствен buffer запис (uncommitted)
}

fn boila_txn_get(s: BoilaStore, txn: BoilaTxn, table_id: i64, pk: bytes) -> BoilaTxnGet !IO !Time !Par {
    let ix = boila_txn_find(txn, boila_cf_data(), table_id, pk)
    if ix >= 0 {
        let w = vec_get(txn.writes, ix)
        if w.is_del == 1 {
            return BoilaTxnGet { s: s, found: 0, row: bytes_new(0), lsn: 0 }
        }
        return BoilaTxnGet { s: s, found: 1, row: w.row, lsn: 0 }
    }
    let mut g = BoilaGet { s: s, found: 0, val: bytes_new(0) }
    if txn.isol >= boila_isol_rr() {
        g = boila_get_asof(s, boila_cf_data(), table_id, pk, txn.snapshot_lsn)?
    } else {
        g = boila_get(s, boila_cf_data(), table_id, pk)?
    }
    if g.found == 1 && txn.isol == boila_isol_ser() {
        let mut i: i64 = 0
        let mut seen: i64 = 0
        while i < vec_len(txn.reads) {
            let r = vec_get(txn.reads, i)
            if r.table_id == table_id && bytes_eq_b(r.pk, pk) {
                seen = 1
            }
            i = i + 1
        }
        if seen == 0 {
            vec_push(txn.reads, BoilaTxnRead { table_id: table_id, pk: pk })
        }
    }
    if g.found == 0 {
        return BoilaTxnGet { s: g.s, found: 0, row: bytes_new(0), lsn: 0 }
    }
    return BoilaTxnGet { s: g.s, found: 1, row: boila_unwrap_row(g.val), lsn: boila_unwrap_lsn(g.val) }
}

struct BoilaTxnKeys {
    s: BoilaStore,
    pks: Vec<bytes>
}

// pk списък на таблица: storage + buffer put-ове − buffer del-ове.
// (Линеен merge — buffer-ът е малък; документно ограничение, не hot path.)
fn boila_txn_keys(s: BoilaStore, txn: BoilaTxn, table_id: i64) -> BoilaTxnKeys !IO !Time !Par {
    let tk = boila_table_pks(s, boila_cf_data(), table_id)?
    s = tk.s
    let mut pks = tk.pks
    // buffer merge
    let mut i: i64 = 0
    while i < vec_len(txn.writes) {
        let w = vec_get(txn.writes, i)
        if w.cf == boila_cf_data() && w.table_id == table_id {
            let mut exists: i64 = 0 - 1
            let mut j: i64 = 0
            while j < vec_len(pks) {
                if bytes_eq_b(vec_get(pks, j), w.pk) {
                    exists = j
                }
                j = j + 1
            }
            if w.is_del == 1 {
                if exists >= 0 {
                    // премахни (запази реда: rebuild без exists)
                    let np: Vec<bytes> = vec_new()
                    let mut k: i64 = 0
                    while k < vec_len(pks) {
                        if k != exists {
                            vec_push(np, vec_get(pks, k))
                        }
                        k = k + 1
                    }
                    pks = np
                }
            } else {
                if exists < 0 {
                    vec_push(pks, w.pk)
                }
            }
        }
        i = i + 1
    }
    return BoilaTxnKeys { s: s, pks: pks }
}
